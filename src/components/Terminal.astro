---
// The lab computer's terminal (src/scripts/lab/terminal.ts), inside the lab's dialog (LabStage.astro):
// one view at a time over the prompt. First the startup's two lines; then whatever was last asked for:
// help, a section, a project. Each view waits in a <template> below, rendered here from the site's data
// (TermOutput.astro; each project's, `work <id>`, TermProject.astro), until it's first asked for.
// (A template's pictures load only once it's shown.) Over the prompt, a line for Tab's matches and one
// for a mistake (a command there isn't), neither of them a view.
//
// A view is real text for reading, selecting and copying, headed by its title (an h2). A new view is
// announced once, briefly, in the status line; the views themselves aren't live.
import { getCollection } from 'astro:content';
import TermCmd from './TermCmd.astro';
import TermOutput from './TermOutput.astro';
import TermProject from './TermProject.astro';
import { BOOT, PS1 } from '../lib/terminal';
import '../styles/terminal.css';

const outputs = ['help', 'about', 'work', 'resume', 'contact', 'no-project', 'not-found'] as const;
const projects = await getCollection('projects');
---

<div class="term" data-term data-boot="pending" tabindex="-1">
  <div class="term-inner">
    <div class="term-views" data-term-views>
      <div class="term-boot" data-view="">
        <p class="term-boot-1" style={`--n:${BOOT.first.length}`}>
          <span class="term-type">{BOOT.first}</span><span class="term-boot-cursor" aria-hidden="true"></span>
        </p>
        <p class="term-boot-2" id="term-hint">
          {BOOT.second[0]}<TermCmd name="help" />{BOOT.second[1]}
        </p>
      </div>
    </div>
    <form class="term-prompt" data-term-form autocomplete="off">
      <p class="term-note" data-term-note hidden></p>
      <p class="term-matches" data-term-matches aria-hidden="true" hidden></p>
      <label class="term-ps1" for="term-cmd" aria-hidden="true" data-term-ps1>{PS1}</label>
      <span class="term-field">
        <input
          id="term-cmd"
          type="text"
          aria-label="Command"
          aria-describedby="term-hint"
          autocomplete="off"
          autocapitalize="none"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="go"
          maxlength="200"
          data-term-input
        />
        <span class="term-cursor" data-term-cursor aria-hidden="true"></span>
        <span class="term-measure" data-term-measure aria-hidden="true"></span>
      </span>
    </form>
    <p class="sr-only" role="status" data-term-status></p>
  </div>
</div>
{
  outputs.map((cmd) => (
    <template data-term-out={cmd}>
      <TermOutput cmd={cmd} />
    </template>
  ))
}
{
  projects.map((p) => (
    <template data-term-out={`work/${p.id}`} data-title={p.data.title}>
      <TermProject project={p} />
    </template>
  ))
}
