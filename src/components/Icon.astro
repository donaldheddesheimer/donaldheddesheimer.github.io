export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: cls = 'size-5' } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>

<style>
  /* In screen pixels: the 1.5px stroke keeps its width at every icon size. */
  svg > :global(*) {
    vector-effect: non-scaling-stroke;
  }
</style>
