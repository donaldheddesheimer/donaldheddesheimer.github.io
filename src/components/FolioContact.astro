---
// Contact: email first, then the address to copy and the social links. From src/data/site.ts.
import Icon from './Icon.astro';
import NewTab from './NewTab.astro';
import { contact, profile, socials } from '../data/site';
import '../styles/folio.css';

interface Props {
  /** The section heading's level: 1 on a page of its own, 2 on the page with all four. */
  level?: 1 | 2;
}
const { level = 2 } = Astro.props;
const H = `h${level}` as 'h1' | 'h2';
---

<section id="contact" class="folio fc" aria-labelledby="contact-title">
  <header class="folio-head">
    <div>
      <H class="folio-title" id="contact-title">Contact</H>
      <p class="folio-lede">{contact.title} {contact.note}</p>
    </div>
  </header>
  <p class="fc-address">
    <a href={`mailto:${profile.email}`}>{profile.email}</a>
  </p>
  <div class="folio-actions fc-actions">
    <a href={`mailto:${profile.email}`} class="btn btn-primary"><Icon name="mail" class="size-4" />Email me</a>
    <button type="button" class="btn" data-copy-email={profile.email}><Icon name="copy" class="size-4" /><span>Copy address</span></button>
    {
      socials
        .filter((s) => s.id !== 'email')
        .map((s) => (
          <a href={s.href} class="btn btn-ghost" target="_blank" rel="noopener">
            <Icon name={s.icon} class="size-4" />
            {s.label}
            <NewTab class="size-3.5 text-dim" />
          </a>
        ))
    }
  </div>
  <p class="folio-meta fc-where">Based in {profile.location}.</p>
</section>

<script>
  // Copy the address; where the clipboard can't be written, open the mail client instead.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((b) =>
    b.addEventListener('click', async () => {
      const label = b.querySelector('span')!;
      try {
        await navigator.clipboard.writeText(b.dataset.copyEmail!);
        label.textContent = 'Copied';
        setTimeout(() => (label.textContent = 'Copy address'), 1600);
      } catch {
        location.href = `mailto:${b.dataset.copyEmail}`;
      }
    }),
  );
</script>

<style>
  .fc {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .fc-address {
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
    font-weight: 600;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .fc-address a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .fc-actions {
    margin-top: 1.5rem;
  }
  .fc-where {
    margin-top: 1.5rem;
  }
</style>
