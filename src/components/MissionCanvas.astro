---
// Illustrative rover-autonomy simulation for the Mission panel (not recorded rover data).
// The host sizes this figure's parent; the stage takes whatever height is left after the telemetry bar
// and the legend row, which folds the caption into an "About" disclosure.
// The core runs once here at build time to draw a light SVG poster (the no-JS view); the canvas replaces it.
import Icon from './Icon.astro';
import { CUTOFF, DEFAULT_SEED, DIMS, FOV, RANGE, ROBOT_R, Sim, makeWorld, toFirstReplan, type Pt } from '../scripts/rover-sim';

interface Props {
  seed?: number;
  class?: string;
}
const { seed = DEFAULT_SEED, class: cls } = Astro.props;

const s = toFirstReplan(new Sim(makeWorld(seed, 'landscape')));
const [cols, rows] = DIMS.landscape;
const K = 10; // SVG units per cell
const f = (v: number) => Math.round(v * K * 10) / 10;
const xy = (p: Pt) => `${f(p.x)},${f(p.y)}`;
// Poster polylines: keep only the route's turning points, and every third track sample (about 0.9 cells apart).
const turns = (pts: Pt[]) =>
  pts.filter((p, i) => i === 0 || i === pts.length - 1 || (p.x - pts[i - 1].x) * (pts[i + 1].y - p.y) !== (p.y - pts[i - 1].y) * (pts[i + 1].x - p.x));
const spaced = (pts: Pt[]) => pts.filter((_, i, a) => i % 3 === 0 || i === a.length - 1);
const rover = { x: s.x, y: s.y };
const track = spaced([...s.track, rover]).map(xy).join(' ');
const route = s.path.length ? [xy(rover), ...turns(s.path.slice(s.pi + 1)).map(xy)].join(' ') : '';
const ray = (a: number) => xy({ x: s.x + RANGE * Math.cos(s.h + a), y: s.y + RANGE * Math.sin(s.h + a) });
const wedge = `M${xy(rover)}L${ray(-FOV)}A${RANGE * K} ${RANGE * K} 0 0 1 ${ray(FOV)}Z`;
const seen = s.w.rocks.filter((k) => k.seen);
const rings = seen.map((k) => `<circle cx="${f(k.x)}" cy="${f(k.y)}" r="${f(k.r + ROBOT_R + CUTOFF)}"/>`).join('');
const bodies = seen.map((k) => `<circle cx="${f(k.x)}" cy="${f(k.y)}" r="${f(k.r)}"/>`).join('');
// 45-degree hatch chords inside each rock, computed directly so the poster needs no pattern ids.
const hatch = seen
  .map((k) => {
    let d = '';
    for (let o = -k.r + 0.3; o < k.r; o += 0.6) {
      const c = Math.sqrt(k.r * k.r - o * o) / Math.SQRT2;
      const m = { x: k.x + o / Math.SQRT2, y: k.y + o / Math.SQRT2 };
      d += `M${xy({ x: m.x - c, y: m.y + c })}L${xy({ x: m.x + c, y: m.y - c })}`;
    }
    return d;
  })
  .join('');
const wps = s.w.wps
  .map((p, k) => `<path class="${p.status === 1 ? 'pw pd' : 'pw'}" d="M${f(p.x)} ${f(p.y) - 7}l7 7-7 7-7-7z"/><text x="${f(p.x) + 11}" y="${f(p.y) + 4}">WP${k + 1}</text>`)
  .join('');
const grid = [
  ...Array.from({ length: cols / 8 - 1 }, (_, i) => `M${(i + 1) * 8 * K} 0v${rows * K}`),
  ...Array.from({ length: rows / 8 - 1 }, (_, j) => `M0 ${(j + 1) * 8 * K}h${cols * K}`),
].join('');
const RX = f(s.x);
const RY = f(s.y);
const poster = [
  `<rect class="pb" width="${cols * K}" height="${rows * K}"/><path class="pg" d="${grid}"/>`,
  `<path class="pf" d="${wedge}"/><g class="ph">${rings}</g><g class="pk">${bodies}</g><path class="px" d="${hatch}"/>`,
  `<polyline class="pt" points="${track}"/>`,
  route && `<polyline class="pr" points="${route}"/>`,
  `<g class="pl">${wps}</g>`,
  `<g class="pv" transform="translate(${RX} ${RY}) rotate(${Math.round((s.h * 180) / Math.PI)})"><path d="M-9-6.5H9v3L4 0l5 3.5v3H-9z"/></g>`,
  s.replans && `<g class="pm"><rect x="${RX + 10}" y="${RY - 28}" width="54" height="18"/><text x="${RX + 15}" y="${RY - 14.5}">REPLAN</text></g>`,
]
  .filter(Boolean)
  .join('');
const n = s.w.wps.length;
const legend = [
  { key: 'route', label: 'Planned route' },
  { key: 'track', label: 'Driven route' },
  { key: 'fov', label: 'LiDAR field of view' },
  { key: 'hazard', label: 'Obstacle + inflated cost' },
  { key: 'fog', label: 'Unexplored' },
  { key: 'wp', label: 'GNSS waypoint' },
];
const capId = `sim-cap-${seed}`;
---

<figure data-mission-root data-seed={seed} data-running="false" aria-labelledby={capId} class:list={['mission flex h-full min-h-0 flex-col', cls]}>
  <div class="stage relative min-h-0 flex-1 overflow-hidden" data-mission-stage>
    <svg class="poster" viewBox={`0 0 ${cols * K} ${rows * K}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true" set:html={poster} />
    <canvas aria-hidden="true"></canvas>
    <p class="badge">Simulation · illustrative · not recorded rover data</p>
  </div>
  <!-- Telemetry: the readouts and playback controls sit under the map, so nothing but the badge covers it. -->
  <div class="telemetry">
    <dl class="hud" data-sim-readouts>
      <div class="hud-state"><dt>State</dt><dd data-sim-readout="state">{s.state}</dd></div>
      <div>
        <dt><span class="lbl-long">Waypoint</span><span class="lbl-short" aria-hidden="true">WP</span></dt>
        <dd data-sim-readout="waypoint">{Math.min(s.target + 1, n)} of {n}</dd>
      </div>
      <div>
        <dt><span class="lbl-long">Obstacles seen</span><span class="lbl-short" aria-hidden="true">OBS</span></dt>
        <dd data-sim-readout="obstacles">{s.seenRocks}</dd>
      </div>
    </dl>
    <div class="ctl-bar">
      <button type="button" class="btn btn-icon ctl" data-mission-toggle aria-pressed="false" aria-label="Pause simulation" title="Pause / play">
        <Icon name="pause" class="i-pause size-4" />
        <Icon name="play" class="i-play size-4" />
      </button>
      <button type="button" class="btn btn-icon ctl" data-mission-restart aria-label="Restart simulation with a new run" title="Restart (new run)">
        <Icon name="reset" class="size-4" />
      </button>
    </div>
  </div>
  <figcaption class="key">
    <ul class="legend" aria-label="Legend">
      {
        legend.map((l) => (
          <li>
            <svg class={`sw sw-${l.key}`} viewBox="0 0 22 14" aria-hidden="true">
              {l.key === 'route' && <path d="M1 7h20" />}
              {l.key === 'track' && <path d="M1 7h20" />}
              {l.key === 'fov' && <path d="M2 7 20 1.5a9 9 0 0 1 0 11z" />}
              {l.key === 'hazard' && (
                <>
                  <circle class="h" cx="11" cy="7" r="6.25" />
                  <circle cx="11" cy="7" r="3.75" />
                  <path class="x" d="M8.8 9.2l4.4-4.4M9 7l2-2M11 9l2-2" />
                </>
              )}
              {l.key === 'fog' && (
                <>
                  <rect x="4.5" y="1.5" width="13" height="11" />
                  <path class="x" d="M4.5 7.5l6-6M4.5 12.5l11-11M10 12.5l7.5-7.5" />
                </>
              )}
              {l.key === 'wp' && <path d="M11 1.5 16.5 7 11 12.5 5.5 7z" />}
            </svg>
            {l.label}
          </li>
        ))
      }
    </ul>
    <details class="about">
      <summary>About<Icon name="chevron" class="size-3.5" /></summary>
      <p id={capId}>
        Illustrative simulation of the planning approach: a grid A* planner replans around obstacles as the LiDAR reveals them. Not recorded
        rover data.
      </p>
    </details>
  </figcaption>
</figure>

<script>
  import { mountAll } from '../scripts/rover-render';
  mountAll();
</script>

<style>
  /* The figure is the size container, so the telemetry bar and the legend row can shorten their labels. */
  .mission {
    container-type: inline-size;
  }
  .stage {
    background: var(--panel);
  }
  .poster,
  canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  [data-drawn] .poster {
    display: none;
  }

  /* Poster (no-JS still), in the canvas's colors: turquoise = the planner (route, field of view,
     replan), ink = what the rover has done, slate = obstacles. */
  .poster :global(.pb) {
    fill: var(--panel-2);
    stroke: var(--line);
  }
  .poster :global(.pg) {
    stroke: var(--line-2);
    stroke-opacity: 0.6;
  }
  .poster :global(.pf) {
    fill: color-mix(in srgb, var(--turquoise) 8%, transparent);
    stroke: color-mix(in srgb, var(--turquoise) 60%, transparent);
  }
  .poster :global(.ph) {
    fill: none;
    stroke: var(--line-2);
    stroke-dasharray: 4 4;
  }
  .poster :global(.pk) {
    fill: var(--panel);
    stroke: var(--slate);
    stroke-width: 1.25;
  }
  .poster :global(.px) {
    stroke: var(--slate);
    stroke-opacity: 0.7;
  }
  .poster :global(.pt),
  .poster :global(.pr) {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .poster :global(.pt) {
    stroke: var(--ink);
    stroke-width: 2;
  }
  .poster :global(.pr) {
    stroke: var(--turquoise);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .poster :global(.pw) {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
  }
  .poster :global(.pd) {
    fill: var(--ink);
    stroke: var(--ink);
  }
  .poster :global(text) {
    font: 500 12px var(--font-mono);
    fill: var(--muted);
  }
  .poster :global(.pv) {
    fill: var(--text);
    stroke: var(--panel);
  }
  .poster :global(.pm rect) {
    fill: var(--panel);
    stroke: var(--turquoise);
  }
  .poster :global(.pm text) {
    fill: var(--turquoise);
  }

  /* The one overlay: the sim's disclaimer, in its exact wording, on a solid surface. */
  .badge {
    position: absolute;
    left: 8px;
    bottom: 8px;
    max-width: calc(100% - 16px);
    padding: 2px 6px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-1);
    background: var(--panel);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 500;
    line-height: 1rem;
    color: var(--muted);
  }

  /* Telemetry bar: readouts on the left, playback on the right. */
  .telemetry {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 2.25rem;
    padding: 0 0.25rem 0 0.75rem;
    border-top: 1px solid var(--line);
    background: var(--panel);
  }
  .hud {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    min-width: 0;
  }
  .hud > div {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .hud dt {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .hud dd {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--text);
    white-space: nowrap;
  }
  .hud [data-sim-readout='state'] {
    min-width: 16ch; /* the longest state, so the readouts never shift */
  }
  .lbl-short {
    display: none;
  }
  .ctl-bar {
    display: flex;
    flex-shrink: 0;
    gap: 0.25rem;
    margin-left: auto;
  }
  .mission:not([data-mounted]) .ctl-bar {
    display: none;
  }
  .ctl[aria-pressed='true'] :global(.i-pause),
  .ctl[aria-pressed='false'] :global(.i-play) {
    display: none;
  }
  @media (pointer: coarse) {
    .ctl {
      width: var(--h-touch);
      height: var(--h-touch);
    }
  }
  /* Narrow: the state speaks for itself, the other labels shorten (screen readers still hear the
     full ones), and a long state gives way before anything overflows. */
  @container (width < 560px) {
    .telemetry {
      gap: 0.5rem;
    }
    .hud {
      flex: 1 1 auto;
      gap: 0.875rem;
      overflow: hidden;
    }
    .hud > .hud-state {
      min-width: 0;
      flex-shrink: 1;
    }
    .hud-state dt,
    .lbl-long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .lbl-short {
      display: inline;
    }
    .hud [data-sim-readout='state'] {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  /* Legend row. The labels are phrases, so they are set like the map legend; the caption folds into
     an "About" disclosure at the row's end. */
  .key {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.25rem 1rem;
    padding: 0.5rem 0.75rem;
    border-top: 1px solid var(--line);
  }
  .legend {
    display: flex;
    flex: 1 1 0;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    min-width: min(100%, 16rem);
    font-size: var(--text-2xs);
    color: var(--dim);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    line-height: 1rem;
  }
  .about {
    margin-left: auto;
    font-size: var(--text-2xs);
  }
  .about[open] {
    flex-basis: 100%;
  }
  .about summary {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    width: max-content;
    margin-left: auto;
    line-height: 1rem;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
  }
  .about summary::-webkit-details-marker {
    display: none;
  }
  .about summary:hover {
    color: var(--text);
  }
  .about summary :global(svg) {
    transition: rotate var(--dur-1) var(--ease);
  }
  .about[open] summary :global(svg) {
    rotate: 90deg;
  }
  .about p {
    max-width: var(--measure);
    margin-top: 0.375rem;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--muted);
  }
  @media (pointer: coarse) {
    .about summary {
      min-height: var(--h-touch);
    }
  }
  .sw {
    width: 22px;
    height: 14px;
    flex-shrink: 0;
    fill: none;
    stroke-width: 1.5;
  }
  .sw-route {
    stroke: var(--turquoise);
    stroke-dasharray: 4 3;
  }
  .sw-track {
    stroke: var(--ink);
    stroke-width: 2;
  }
  .sw-fov {
    stroke: var(--turquoise);
    stroke-width: 1;
    fill: color-mix(in srgb, var(--turquoise) 8%, transparent);
  }
  .sw-hazard {
    stroke: var(--slate);
    stroke-width: 1.25;
  }
  .sw-hazard .h {
    stroke: var(--edge);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }
  .sw-hazard .x,
  .sw-fog .x {
    stroke-width: 1;
  }
  .sw-fog {
    stroke: var(--line-2);
    fill: color-mix(in srgb, var(--bg) 70%, var(--panel-2));
  }
  .sw-fog .x {
    stroke: var(--dim);
    stroke-opacity: 0.6;
  }
  .sw-wp {
    stroke: var(--text);
  }
</style>
