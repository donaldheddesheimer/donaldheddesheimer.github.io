---
// Illustrative rover-autonomy simulation for the Mission panel (not recorded rover data).
// The host sizes this figure's parent; the stage takes whatever height is left after the legend and caption.
// The core runs once here at build time to draw a light SVG poster (the no-JS view); the canvas replaces it.
import Icon from './Icon.astro';
import { CUTOFF, DEFAULT_SEED, DIMS, FOV, RANGE, ROBOT_R, Sim, makeWorld, toFirstReplan, type Pt } from '../scripts/rover-sim';

interface Props {
  seed?: number;
  class?: string;
}
const { seed = DEFAULT_SEED, class: cls } = Astro.props;

const s = toFirstReplan(new Sim(makeWorld(seed, 'landscape')));
const [cols, rows] = DIMS.landscape;
const K = 10; // SVG units per cell
const f = (v: number) => Math.round(v * K * 10) / 10;
const xy = (p: Pt) => `${f(p.x)},${f(p.y)}`;
// Poster polylines: keep only the route's turning points, and every third track sample (about 0.9 cells apart).
const turns = (pts: Pt[]) =>
  pts.filter((p, i) => i === 0 || i === pts.length - 1 || (p.x - pts[i - 1].x) * (pts[i + 1].y - p.y) !== (p.y - pts[i - 1].y) * (pts[i + 1].x - p.x));
const spaced = (pts: Pt[]) => pts.filter((_, i, a) => i % 3 === 0 || i === a.length - 1);
const rover = { x: s.x, y: s.y };
const track = spaced([...s.track, rover]).map(xy).join(' ');
const route = s.path.length ? [xy(rover), ...turns(s.path.slice(s.pi + 1)).map(xy)].join(' ') : '';
const ray = (a: number) => xy({ x: s.x + RANGE * Math.cos(s.h + a), y: s.y + RANGE * Math.sin(s.h + a) });
const wedge = `M${xy(rover)}L${ray(-FOV)}A${RANGE * K} ${RANGE * K} 0 0 1 ${ray(FOV)}Z`;
const seen = s.w.rocks.filter((k) => k.seen);
const halos = seen.flatMap((k) => [CUTOFF, 2, 0].map((e) => `<circle cx="${f(k.x)}" cy="${f(k.y)}" r="${f(k.r + ROBOT_R + e)}"/>`)).join('');
const bodies = seen.map((k) => `<circle cx="${f(k.x)}" cy="${f(k.y)}" r="${f(k.r)}"/>`).join('');
// 45-degree hatch chords inside each rock, computed directly so the poster needs no pattern ids.
const hatch = seen
  .map((k) => {
    let d = '';
    for (let o = -k.r + 0.3; o < k.r; o += 0.6) {
      const c = Math.sqrt(k.r * k.r - o * o) / Math.SQRT2;
      const m = { x: k.x + o / Math.SQRT2, y: k.y + o / Math.SQRT2 };
      d += `M${xy({ x: m.x - c, y: m.y + c })}L${xy({ x: m.x + c, y: m.y - c })}`;
    }
    return d;
  })
  .join('');
const wps = s.w.wps
  .map((p, k) => `<path class="${p.status === 1 ? 'pw pd' : 'pw'}" d="M${f(p.x)} ${f(p.y) - 7}l7 7-7 7-7-7z"/><text x="${f(p.x) + 11}" y="${f(p.y) + 4}">WP${k + 1}</text>`)
  .join('');
const grid = [
  ...Array.from({ length: cols / 8 - 1 }, (_, i) => `M${(i + 1) * 8 * K} 0v${rows * K}`),
  ...Array.from({ length: rows / 8 - 1 }, (_, j) => `M0 ${(j + 1) * 8 * K}h${cols * K}`),
].join('');
const RX = f(s.x);
const RY = f(s.y);
const poster = [
  `<rect class="pb" width="${cols * K}" height="${rows * K}"/><path class="pg" d="${grid}"/>`,
  `<path class="pf" d="${wedge}"/><g class="ph">${halos}</g><g class="pk">${bodies}</g><path class="px" d="${hatch}"/>`,
  `<polyline class="pt" points="${track}"/>`,
  route && `<polyline class="pr" points="${route}"/>`,
  `<g class="pl">${wps}</g>`,
  `<g class="pv" transform="translate(${RX} ${RY}) rotate(${Math.round((s.h * 180) / Math.PI)})"><path d="M-9-6.5H9v3L4 0l5 3.5v3H-9z"/></g>`,
  s.replans && `<g class="pm"><rect x="${RX + 10}" y="${RY - 26}" width="50" height="16"/><text x="${RX + 15}" y="${RY - 14.5}">REPLAN</text></g>`,
]
  .filter(Boolean)
  .join('');
const n = s.w.wps.length;
const legend = [
  { key: 'route', label: 'Planned route' },
  { key: 'track', label: 'Driven route' },
  { key: 'fov', label: 'LiDAR field of view' },
  { key: 'hazard', label: 'Obstacle + inflated cost' },
  { key: 'fog', label: 'Unexplored' },
  { key: 'wp', label: 'GNSS waypoint' },
];
---

<figure data-mission-root data-seed={seed} data-running="false" class:list={['mission flex h-full min-h-0 flex-col', cls]}>
  <div class="stage relative min-h-0 flex-1 overflow-hidden" data-mission-stage>
    <svg class="poster" viewBox={`0 0 ${cols * K} ${rows * K}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true" set:html={poster} />
    <canvas aria-hidden="true"></canvas>
    <div class="ctl-bar">
      <button type="button" class="btn btn-icon ctl" data-mission-toggle aria-pressed="false" aria-label="Pause simulation" title="Pause / play">
        <svg class="i-pause size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 5v14M15 5v14"></path></svg>
        <svg class="i-play size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true"><path d="M7 4.5v15L19 12z"></path></svg>
      </button>
      <button type="button" class="btn btn-icon ctl" data-mission-restart aria-label="Restart simulation with a new run" title="Restart (new run)">
        <Icon name="reset" class="size-4" />
      </button>
    </div>
    <dl class="hud" data-sim-readouts>
      <div><dt>State</dt><dd data-sim-readout="state">{s.state}</dd></div>
      <div><dt>Waypoint</dt><dd data-sim-readout="waypoint">{Math.min(s.target + 1, n)} of {n}</dd></div>
      <div><dt>Obstacles seen</dt><dd data-sim-readout="obstacles">{s.seenRocks}</dd></div>
    </dl>
    <p class="badge">Simulation · illustrative · not recorded rover data</p>
  </div>
  <ul class="legend" aria-label="Legend">
    {
      legend.map((l) => (
        <li>
          <svg class={`sw sw-${l.key}`} viewBox="0 0 22 14" aria-hidden="true">
            {l.key === 'route' && <path d="M1 7h20" />}
            {l.key === 'track' && <path d="M1 7h20" />}
            {l.key === 'fov' && <path d="M2 7 20 1.5a9 9 0 0 1 0 11z" />}
            {l.key === 'hazard' && (
              <>
                <circle class="h" cx="11" cy="7" r="6.5" />
                <circle cx="11" cy="7" r="4" />
                <path class="x" d="M8.5 9.5l5-5M8 7.5l3-3M10.5 10l3-3" />
              </>
            )}
            {l.key === 'fog' && (
              <>
                <rect x="4.5" y="1.5" width="13" height="11" />
                <path class="x" d="M4.5 7.5l6-6M4.5 12.5l11-11M10 12.5l7.5-7.5" />
              </>
            )}
            {l.key === 'wp' && <path d="M11 1.5 16.5 7 11 12.5 5.5 7z" />}
          </svg>
          {l.label}
        </li>
      ))
    }
  </ul>
  <figcaption>
    Illustrative simulation of the planning approach: a grid A* planner replans around obstacles as the LiDAR reveals them. Not recorded rover
    data.
  </figcaption>
</figure>

<script>
  import { mountAll } from '../scripts/rover-render';
  mountAll();
</script>

<style>
  .stage {
    container-type: inline-size;
    background: var(--panel);
  }
  .poster,
  canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  [data-drawn] .poster {
    display: none;
  }

  /* Poster (no-JS still). */
  .poster :global(.pb) {
    fill: var(--panel-2);
    stroke: var(--line);
  }
  .poster :global(.pg) {
    stroke: var(--line-2);
    stroke-opacity: 0.6;
  }
  .poster :global(.pf) {
    fill: color-mix(in srgb, var(--blue-3) 8%, transparent);
    stroke: color-mix(in srgb, var(--blue-3) 60%, transparent);
  }
  .poster :global(.ph) {
    fill: var(--orange);
    fill-opacity: 0.08;
  }
  .poster :global(.pk) {
    fill: var(--panel);
    stroke: var(--orange);
    stroke-width: 1.5;
  }
  .poster :global(.px) {
    stroke: var(--orange);
    stroke-opacity: 0.7;
  }
  .poster :global(.pt),
  .poster :global(.pr) {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .poster :global(.pt) {
    stroke: var(--green);
    stroke-width: 2.5;
  }
  .poster :global(.pr) {
    stroke: var(--blue-3);
    stroke-width: 1.75;
    stroke-dasharray: 6 5;
  }
  .poster :global(.pw) {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.75;
  }
  .poster :global(.pd) {
    fill: var(--green);
    stroke: var(--green-2);
  }
  .poster :global(text) {
    font: 500 12px var(--font-mono);
    fill: var(--muted);
  }
  .poster :global(.pv) {
    fill: var(--text);
    stroke: var(--panel);
  }
  .poster :global(.pm rect) {
    fill: var(--panel);
    stroke: var(--blue-3);
  }
  .poster :global(.pm text) {
    fill: var(--blue-3);
    font-size: 10px;
  }

  /* Overlays: solid surfaces so they read over any part of the map. */
  .ctl-bar {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    gap: 4px;
  }
  .mission:not([data-mounted]) .ctl-bar {
    display: none;
  }
  .ctl[aria-pressed='true'] .i-pause,
  .ctl[aria-pressed='false'] .i-play {
    display: none;
  }
  .ctl[aria-pressed='true'] {
    background: color-mix(in srgb, var(--blue) 20%, var(--panel-3));
    color: var(--blue-3);
  }
  @media (pointer: coarse) {
    .ctl {
      width: 44px;
      height: 44px;
    }
  }
  /* Narrow stages: one "label value" row per readout, as slim as possible. Wider: an aligned two-column table. */
  .hud {
    position: absolute;
    top: 8px;
    left: 8px;
    display: grid;
    column-gap: 12px;
    padding: 5px 9px 6px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--panel);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.35);
  }
  .hud > div {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .hud dt,
  .badge,
  .legend {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .hud dt {
    line-height: 16px;
    color: var(--dim);
  }
  .hud [data-sim-readout='state'] {
    min-width: 16ch; /* longest state, so the block never changes width */
  }
  .hud dd {
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 16px;
    color: var(--text);
    white-space: nowrap;
  }
  @container (min-width: 560px) {
    .hud {
      grid-template-columns: auto auto;
    }
    .hud > div {
      display: contents;
    }
  }
  .badge {
    position: absolute;
    left: 8px;
    bottom: 8px;
    max-width: calc(100% - 16px);
    padding: 2px 6px;
    letter-spacing: 0.03em;
    border: 1px solid var(--line-2);
    border-radius: 2px;
    background: var(--panel);
    line-height: 16px;
    color: var(--muted);
  }

  /* Legend and caption. */
  .legend {
    padding: 8px 12px 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    color: var(--dim);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    line-height: 16px;
  }
  figcaption {
    padding: 6px 12px 10px;
    font-size: 12px;
    line-height: 1.45;
    color: var(--muted);
  }
  .sw {
    width: 22px;
    height: 14px;
    flex-shrink: 0;
    fill: none;
    stroke-width: 1.5;
  }
  .sw-route {
    stroke: var(--blue-3);
    stroke-dasharray: 4 3;
  }
  .sw-track {
    stroke: var(--green);
    stroke-width: 2;
  }
  .sw-fov {
    stroke: var(--blue-3);
    stroke-width: 1;
    fill: color-mix(in srgb, var(--blue-3) 8%, transparent);
  }
  .sw-hazard {
    stroke: var(--orange);
    stroke-width: 1.25;
  }
  .sw-hazard .h {
    stroke: none;
    fill: color-mix(in srgb, var(--orange) 16%, transparent);
  }
  .sw-hazard .x,
  .sw-fog .x {
    stroke-width: 1;
  }
  .sw-fog {
    stroke: var(--line-2);
    fill: color-mix(in srgb, var(--bg) 70%, var(--panel-2));
  }
  .sw-fog .x {
    stroke: var(--dim);
    stroke-opacity: 0.6;
  }
  .sw-wp {
    stroke: var(--text);
  }
</style>
