---
// The console's center: the featured mission by default, or the evidence for whatever is selected.
// Each entity's evidence waits in a <template> and is cloned in when it's selected.
import Icon from './Icon.astro';
import MissionCanvas from './MissionCanvas.astro';
import Evidence from './Evidence.astro';
import { getModel, MISSION } from '../lib/model';
import { mission, orgs } from '../data/site';
import { fmtMonth } from '../lib/format';

const model = await getModel();
const m = model.get(MISSION);
const exp = m.exp!;
const org = orgs.find((o) => o.id === exp.org)!;
---

<section class="pane pane-stage panel" data-pane="mission" id="pane-stage" aria-labelledby="stage-title" data-stage>
  <header class="panel-head">
    <Icon name="target" class="size-4 shrink-0 text-dim" />
    <h2 class="panel-title" id="stage-title" data-stage-title>Mission</h2>
    <span class="stage-sub code-chip min-w-0 truncate max-sm:hidden" data-stage-sub hidden></span>
    <button type="button" class="btn btn-ghost ml-auto shrink-0" data-stage-back hidden>
      <Icon name="arrow-left" class="size-4" />
      <span>Back to mission</span>
    </button>
  </header>

  <div class="stage-body">
    <div class="stage-view mission-view" data-stage-view="mission">
      <div class="mission-head">
        <div class="flex items-center gap-3">
          <h3 class="text-md font-semibold">{mission.title}</h3>
          <span class={`pill pill-${m.status!.tone} ml-auto`}>{m.status!.label}</span>
        </div>
        <p class="mt-0.5 flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5 text-sm text-muted">
          <span>{org.name} · {exp.unit}</span>
          <span class="readout text-xs">{fmtMonth(exp.start)} – {fmtMonth(exp.end)}</span>
        </p>
      </div>
      <div class="mission-canvas">
        <MissionCanvas />
      </div>
    </div>
    <div class="stage-view evidence-view" data-stage-view="evidence" tabindex="-1" hidden></div>
  </div>

  {
    model
      .list()
      .filter((e) => e.id !== MISSION)
      .map((e) => (
        <template data-evidence={e.id}>
          <Evidence entity={e} />
        </template>
      ))
  }
</section>

<script>
  import { DEFAULT_SEL, onSelect, select } from '../scripts/selection';

  const stage = document.querySelector<HTMLElement>('[data-stage]');
  if (stage) {
    const missionView = stage.querySelector<HTMLElement>('[data-stage-view="mission"]')!;
    const evidenceView = stage.querySelector<HTMLElement>('[data-stage-view="evidence"]')!;
    const title = stage.querySelector<HTMLElement>('[data-stage-title]')!;
    const sub = stage.querySelector<HTMLElement>('[data-stage-sub]')!;
    const back = stage.querySelector<HTMLButtonElement>('[data-stage-back]')!;
    const missionRoot = missionView.querySelector<HTMLElement>('[data-mission-root]');
    // The inspector trims to a properties sheet while the stage shows the object's evidence.
    const inspector = document.querySelector<HTMLElement>('[data-pane="details"]');

    onSelect(({ id, source }) => {
      const isMission = id === DEFAULT_SEL;
      if (source !== 'init') stage.dataset.swapped = '';
      missionView.hidden = !isMission;
      evidenceView.hidden = isMission;
      back.hidden = isMission;
      missionRoot?.toggleAttribute('data-suspended', !isMission);
      title.textContent = isMission ? 'Mission' : 'Evidence';
      document.dispatchEvent(new CustomEvent('stage:title', { detail: title.textContent }));
      sub.hidden = isMission;
      if (inspector) inspector.dataset.mode = isMission ? 'mission' : 'evidence';
      if (isMission) {
        evidenceView.replaceChildren();
        return;
      }
      const tpl = stage.querySelector<HTMLTemplateElement>(`template[data-evidence="${CSS.escape(id)}"]`);
      evidenceView.replaceChildren(tpl ? tpl.content.cloneNode(true) : '');
      evidenceView.scrollTop = 0;
      // Evidence to evidence keeps the view shown, so replay its fade by hand.
      evidenceView.getAnimations().forEach((a) => (a.cancel(), a.play()));
      // The header chip names the object by its short map label; the full title is the h3 below it.
      sub.textContent = evidenceView.querySelector<HTMLElement>('.ev')?.dataset.label ?? '';
    });
    back.addEventListener('click', () => select(DEFAULT_SEL, 'stage'));
  }
</script>
