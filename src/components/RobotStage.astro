        <linearGradient id="rs-graphite" x1="0" x2="1">
          <stop offset="0" stop-color="#6d7681" />
          <stop offset="1" stop-color="#3f464f" />
        </linearGradient>
        <linearGradient id="rs-terracotta" x1="0" x2="1">
          <stop offset="0" stop-color="#cf7f60" />
          <stop offset="1" stop-color="#8c4c37" />
        </linearGradient>
      </defs>
      <!-- The workstation, left of the robots and outside the box, where the scene puts it on wide
           screens (hidden in narrower framings, as in the scene): lamp, monitor, keyboard. Drawn at
           full size, then shrunk about its footprint on the floor like the scene's (DESK.scale). -->
