        <rect x="-186.5" y="172" width="156" height="97" rx="3" fill="#141619" />
        <rect x="-181" y="177" width="146" height="87" fill="#0c0f13" />
        <g fill="#12161c" stroke="#232a34" stroke-width="0.8">
          <rect x="-178" y="180" width="140" height="7" /><rect x="-178" y="190" width="86" height="71" />
          <rect x="-89" y="190" width="51" height="34" /><rect x="-89" y="227" width="51" height="34" />
        </g>
        <path d="M-165 208-150 200-132 214-155 232-120 238M-150 200-110 204" stroke="#26364d" stroke-width="1.2" fill="none" />
        <g fill="#3a5072"><circle cx="-165" cy="208" r="2" /><circle cx="-150" cy="200" r="2" /><circle cx="-155" cy="232" r="2" /><circle cx="-120" cy="238" r="2" /><circle cx="-110" cy="204" r="2" /></g>
        <circle cx="-132" cy="214" r="2.8" fill="#7fa6e0" />
        <path d="M-85 218c8-2 10-18 20-15s12-8 23-10" stroke="#2f8a7e" stroke-width="1.4" fill="none" />
        <g fill="#141619">
          <rect x="-109" y="269" width="7" height="29" /><rect x="-137.5" y="295" width="62" height="4" rx="2" />
        </g>
        <rect x="-176" y="305" width="99" height="5" rx="1.5" fill="#1d1e21" />
        <rect x="-64" y="304.5" width="14" height="5" rx="2.5" fill="#1d1e21" />
        <ellipse cx="-200" cy="301" rx="15" ry="3" fill="#2a2c30" />
        <path d="M-201 300-203 221" stroke="#2a2c30" stroke-width="2" />
        <polygon points="-206,228 -223,253 -195,253" fill="#2c2a27" />
        <circle cx="-209" cy="252" r="4" fill="#ffe2b8" />
      </g>

      <ellipse cx="310" cy="382" rx="270" ry="42" fill="url(#rs-pool)" />
      <ellipse cx="150" cy="373" rx="70" ry="10" fill="url(#rs-shadow)" />
      <ellipse cx="488" cy="379" rx="48" ry="8" fill="url(#rs-shadow)" />
      <ellipse cx="300" cy="390" rx="66" ry="10" fill="url(#rs-shadow)" />

      <!-- Graphite: stout, arms up in a V; furthest back -->
      <g transform="translate(150 372) scale(0.88) translate(-163 -382)">
        <g stroke-linecap="round" fill="none">
          <path d="M145 300 140 336 142 372M178 300 183 336 184 372" stroke="url(#rs-graphite)" stroke-width="20" />
          <path d="M112 216 86 180 72 146M210 216 236 180 250 146" stroke="url(#rs-graphite)" stroke-width="15" />
        </g>
        <g fill="#1b1e23">
          <rect x="120" y="368" width="42" height="14" rx="5" /><rect x="164" y="368" width="42" height="14" rx="5" />
          <circle cx="140" cy="336" r="10" /><circle cx="183" cy="336" r="10" />
          <circle cx="86" cy="180" r="9" /><circle cx="236" cy="180" r="9" />
          <circle cx="70" cy="142" r="10" /><circle cx="252" cy="142" r="10" />
          <rect x="130" y="284" width="62" height="24" rx="8" />
        </g>
        <rect x="112" y="204" width="98" height="84" rx="16" fill="url(#rs-graphite)" />
        <circle cx="112" cy="214" r="15" fill="url(#rs-graphite)" /><circle cx="210" cy="214" r="15" fill="url(#rs-graphite)" />
        <rect x="138" y="222" width="46" height="30" rx="5" fill="#1b1e23" />
        <rect x="130" y="158" width="62" height="46" rx="20" fill="url(#rs-graphite)" />
        <rect x="135" y="172" width="52" height="15" rx="7" fill="#07090b" />
        <rect x="147" y="177.5" width="28" height="4" rx="2" fill="#9cc4ff" />
      </g>

      <!-- Terracotta: small and round, mid robot-pop -->
      <g transform="translate(488 378) scale(0.96) translate(-444 -381)">
        <g stroke-linecap="round" fill="none" stroke="url(#rs-terracotta)">
          <path d="M433 320 427 347 428 374M451 320 457 347 458 374" stroke-width="13" />
          <path d="M476 266 500 266 500 242M408 266 384 266 384 290" stroke-width="11" />
        </g>
        <g fill="#262a30">
          <rect x="414" y="370" width="30" height="11" rx="4" /><rect x="444" y="370" width="30" height="11" rx="4" />
          <circle cx="427" cy="347" r="7" /><circle cx="457" cy="347" r="7" />
          <circle cx="500" cy="266" r="6" /><circle cx="384" cy="266" r="6" />
          <circle cx="500" cy="238" r="8" /><circle cx="384" cy="294" r="8" />
          <rect x="421" y="307" width="44" height="18" rx="8" />
        </g>
        <rect x="410" y="252" width="66" height="60" rx="22" fill="url(#rs-terracotta)" />
        <circle cx="442" cy="220" r="31" fill="url(#rs-terracotta)" />
        <rect x="420" y="209" width="44" height="19" rx="9.5" fill="#07090b" />
        <circle cx="433" cy="218.5" r="3.5" fill="#ffe3b8" /><circle cx="451" cy="218.5" r="3.5" fill="#ffe3b8" />
      </g>

      <!-- Ivory: tall lead, pointing up, hand on hip; one step forward -->
      <g transform="translate(300 390) scale(1.06) translate(-304 -382)">
        <g stroke-linecap="round" fill="none" stroke="url(#rs-ivory)">
          <path d="M292 286 287 330 287 372M311 286 316 330 318 372" stroke-width="15" />
          <path d="M334 200 362 170 378 132M269 200 246 226 266 254" stroke-width="12" />
        </g>
        <g fill="#262a30">
          <rect x="268" y="368" width="36" height="13" rx="5" /><rect x="304" y="368" width="36" height="13" rx="5" />
          <circle cx="287" cy="330" r="8" /><circle cx="316" cy="330" r="8" />
          <circle cx="334" cy="200" r="8" /><circle cx="269" cy="200" r="8" />
          <circle cx="362" cy="170" r="7" /><circle cx="246" cy="226" r="7" />
          <rect x="370" y="118" width="16" height="18" rx="5" /><rect x="258" y="248" width="16" height="16" rx="5" />
          <rect x="281" y="268" width="42" height="24" rx="8" />
          <rect x="296" y="176" width="12" height="16" rx="3" />
          <rect x="300.5" y="106" width="3" height="24" />
        </g>
        <rect x="271" y="190" width="62" height="80" rx="13" fill="url(#rs-ivory)" />
        <rect x="286" y="208" width="32" height="26" rx="5" fill="#262a30" />
        <circle cx="310" cy="214" r="2.5" fill="#ffb561" />
        <rect x="272" y="128" width="60" height="50" rx="13" fill="url(#rs-ivory)" />
        <rect x="280" y="141" width="44" height="21" rx="8" fill="#07090b" />
        <rect x="288" y="148" width="8" height="6" rx="2" fill="#ffb561" /><rect x="308" y="148" width="8" height="6" rx="2" fill="#ffb561" />
        <circle cx="302" cy="104" r="4.5" fill="#ffb561" />
      </g>
    </svg>
  </div>
  <div class="robots-ctl">
    <a href="/systems/" class="robots-pill robots-enter" data-lab-enter>
      Enter the lab<span class="sr-only">: open the systems map</span>
      <Icon name="arrow-right" class="size-3.5" />
    </a>
    <button type="button" class="robots-pill robots-toggle" data-robot-toggle data-state="paused" aria-label="Play the robot animation">
      <Icon name="pause" class="i-pause size-3.5" />
      <Icon name="play" class="i-play size-3.5" />
      <span data-robot-toggle-label>Play</span>
    </button>
  </div>
  <figcaption class="robots-cap"><span class="cap-title">After hours in the lab.</span> <span class="cap-note">Illustration</span></figcaption>
</figure>

<dialog class="lab" data-lab-dialog aria-labelledby="lab-title" tabindex="-1" data-title={`Systems map · ${profile.name}`}>
  <div class="lab-bar" data-lab-bar>
    <button type="button" class="btn btn-ghost" data-lab-back><Icon name="arrow-left" class="size-4" />Back to portfolio</button>
    <h2 id="lab-title" class="lab-title">Systems map</h2>
    <div class="lab-actions">
      <a href="/systems/" class="btn" data-lab-expand><Icon name="expand" class="size-4" />Expand dashboard</a>
      <button type="button" class="btn lab-pause" data-robot-toggle data-state="playing" aria-label="Pause the robot animation">
        <Icon name="pause" class="i-pause size-4" />
        <Icon name="play" class="i-play size-4" />
        <span data-robot-toggle-label>Pause</span>
      </button>
    </div>
  </div>
</dialog>

<script>
  import type { RobotScene } from '../scripts/robot-scene';
  import { initLab } from '../scripts/lab';

  const root = document.querySelector<HTMLElement>('[data-robot-root]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-robot-toggle]');
  if (root && toggle) {
    let scene: RobotScene | null = null;
    let requested = false;
    const html = document.documentElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const motionOK = () => !reduce.matches && html.dataset.motion !== 'off';
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    const fail = () => {
      delete root.dataset.offer;
      root.setAttribute('data-failed', '');
    };
    const load = (play: boolean) => {
      if (requested) return;
      requested = true;
      import('../scripts/robot-scene')
        .then((m) => {
          scene = m.mountRobots(root, { play, toggles: [...document.querySelectorAll<HTMLButtonElement>('[data-robot-toggle]')] });
          if (!scene) fail();
          delete root.dataset.offer;
        })
        .catch(fail);
    };
    const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1200 }) : setTimeout(fn, 150));
    // Text first: the 3D bundle is requested once the page has loaded and the stage is (nearly) on screen.
    const whenLoaded = (fn: () => void) => (document.readyState === 'complete' ? fn() : addEventListener('load', fn, { once: true }));
    let watching = false;
    const auto = () => {
      if (watching || requested) return;
      watching = true;
      whenLoaded(() => {
        const io = new IntersectionObserver(
          ([e]) => {
            if (!e.isIntersecting) return;
            io.disconnect();
            idle(() => load(false));
          },
          { rootMargin: '200px' },
        );
        io.observe(root);
      });
    };
    // Until the scene is loaded, the button offers to load and start it; once mounted, the scene runs it.
    toggle.addEventListener('click', () => {
      if (!requested) load(true);
    });
    if (saveData || !motionOK()) root.dataset.offer = '';
    else auto();
    // Turning Motion on loads the scene as if it had been on from the start.
    const onMotion = () => {
      if (!requested && !saveData && motionOK()) {
        delete root.dataset.offer;
        auto();
      }
    };
    new MutationObserver(onMotion).observe(html, { attributes: true, attributeFilter: ['data-motion'] });
    reduce.addEventListener('change', onMotion);
    addEventListener('pagehide', (e) => {
      if (e.persisted || !scene) return;
      scene.dispose();
      scene = null;
    });
    const dialog = document.querySelector<HTMLDialogElement>('[data-lab-dialog]');
    if (dialog) initLab(root, dialog, () => scene);
  }
</script>

<style>
  .robots {
    position: relative;
    margin: 0;
  }
  .robots-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  /* The canvas covers the right-hand (1 - --scene-crop) of the stage; the text covers the rest. */
  .robots-stage :global(canvas) {
    position: absolute;
    inset: 0 0 0 auto;
    display: block;
    width: calc(100% - var(--scene-crop, 0) * 100%);
    height: 100%;
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  [data-drawn] .robots-stage :global(canvas) {
    opacity: 1;
  }
  [data-failed] .robots-stage :global(canvas) {
    display: none;
  }
  /* The still sits where the 3D group will stand, then gives way once the scene has drawn. */
  .still {
    position: absolute;
    bottom: var(--still-bottom, 6%);
    left: calc(50% + var(--scene-shift, 0) * 100%);
    width: min(calc(var(--scene-usable, 1) * var(--still-scale, 94%)), 900px);
    height: 86%;
    translate: -50% 0;
    transition: opacity 0.25s ease;
  }
  [data-drawn]:not([data-failed]) .still {
    opacity: 0;
  }
  .still-desk {
    display: none;
  }
  @media (width >= 64rem) {
    .still-desk {
      display: inline;
    }
  }

  /* Caption: bottom left, and from lg centred under the robots. */
  .robots-cap {
    position: absolute;
    left: var(--cap-left, 1rem);
    bottom: var(--cap-bottom, 0.875rem);
    z-index: 2;
    translate: var(--cap-translate, 0) 0;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--muted);
    white-space: nowrap;
  }
  .cap-title {
    font-style: italic;
  }
  .cap-note {
    margin-left: 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }
  /* Bottom right: into the lab, and pause / play. */
  .robots-ctl {
    position: absolute;
    right: 1rem;
    bottom: 0.625rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .robots-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: var(--h-md);
    padding: 0 0.75rem 0 0.625rem;
    border-radius: 999px;
    background: rgb(22 20 18 / 0.72);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    backdrop-filter: blur(6px);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    touch-action: manipulation;
  }
  .robots-pill:hover {
    background: rgb(46 42 38 / 0.92);
  }
  .robots-enter {
    padding: 0 0.625rem 0 0.75rem;
  }
  /* Shown once the scene runs it, or while it offers to load the scene (Motion off). */
  .robots:not([data-mounted], [data-offer]) .robots-toggle,
  .robots[data-failed] .robots-toggle {
    display: none;
  }
  .robots-toggle[data-state='playing'] :global(.i-play),
  .robots-toggle[data-state='paused'] :global(.i-pause) {
    display: none;
  }
  @media (pointer: coarse) {
    .robots-pill {
      height: var(--h-touch);
      padding: 0 1rem 0 0.875rem;
    }
  }
  /* Stacked layouts (under lg): the picture is a band under the text, and the caption and controls are
     an ordinary row under the picture, in the page's flow, never over the robots. The band's height is
     --stage-h (global.css); the scrim stays on the picture (grid-area there too). */
  @media (width < 64rem) {
    .robots {
      display: grid;
      grid-template:
        'stage stage' minmax(var(--stage-h, 13rem), 1fr)
        'cap ctl' auto
        / minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 0.75rem;
    }
    .robots-stage {
      position: relative;
      grid-area: stage;
      align-self: stretch;
    }
    .robots-cap,
    .robots-ctl {
      position: relative;
      inset: auto;
      padding-block: 0.625rem;
    }
    .robots-cap {
      grid-area: cap;
      padding-left: var(--home-inset, 1rem);
      translate: none;
    }
    .robots-ctl {
      grid-area: ctl;
      padding-right: var(--home-inset, 1rem);
    }
  }
  /* Phones: pause/play is an icon button (it keeps its aria-label), and the caption is smaller, with
     the note under it (and wraps if it still has to), to leave the controls their room. */
  @media (width < 40rem) {
    .robots-toggle {
      justify-content: center;
      aspect-ratio: 1;
      padding: 0;
    }
    .robots-toggle [data-robot-toggle-label] {
      display: none;
    }
    .robots {
      column-gap: 0.5rem;
    }
    .robots-cap {
      font-size: var(--text-xs);
      white-space: normal;
    }
    .cap-note {
      display: block;
      margin-left: 0;
    }
  }

  /* The lab: the whole window, see-through but for its toolbar and the map's frame (added by lab.ts),
     over the scene, which fills the window under it (global.css, html[data-lab]). */
  .lab {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: transparent;
    color: var(--text);
    outline: none;
  }
  .lab::backdrop {
    background: transparent;
  }
  .lab-bar {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.5rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--line);
    background: rgb(14 13 12 / 0.94);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0.3s;
  }
  :global(html[data-lab='open']) .lab-bar {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s var(--ease);
  }
  .lab-title {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .lab-actions {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }
  .lab-pause[data-state='playing'] :global(.i-play),
  .lab-pause[data-state='paused'] :global(.i-pause) {
    display: none;
  }
  .lab :global(.lab-frame) {
    position: absolute;
    top: 0;
    left: 0;
    border: 0;
    background: var(--bg);
    transform-origin: 0 0;
    opacity: 0;
    pointer-events: none;
  }
  :global(html[data-lab='open']) .lab :global(.lab-frame) {
    pointer-events: auto;
    transition: opacity 0.2s var(--ease);
  }
  /* Too small a window for the desk's framing: the map fills it under the toolbar. */
  :global(html[data-lab-full]) .lab :global(.lab-frame) {
    top: 3.5rem;
    width: 100% !important;
    height: calc(100% - 3.5rem) !important;
    transform: none !important;
  }
</style>
