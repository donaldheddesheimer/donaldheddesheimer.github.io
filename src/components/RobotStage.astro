---
// The homepage opening: three robots dancing on a dark stage. Playful illustration, not a record of past work.
// A composed SVG still renders with the page and stays as the fallback (no JS, no WebGL); the
// Three.js scene (src/scripts/robot-scene.ts) loads after the text, when the stage is near the
// viewport. With Motion off (or reduced data) the scene isn't downloaded: the still shows with a Play
// button that loads it. Layout decides framing through --scene-shift / --scene-usable / --scene-crop.
// A desk with a monitor stands beside the robots: "Enter the lab" (or the monitor) flies the camera to
// it and the systems map comes up on its screen (src/scripts/lab.ts), in the dialog below the figure.
import Icon from './Icon.astro';
import { profile } from '../data/site';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<figure data-robot-root class:list={['robots', cls]}>
  <div class="robots-stage" data-robot-stage>
    <svg class="still" viewBox="0 0 600 420" preserveAspectRatio="xMidYMax meet" overflow="visible" aria-hidden="true">
      <defs>
        <radialGradient id="rs-pool" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#4a3b2e" stop-opacity="0.95" />
          <stop offset="0.6" stop-color="#2e2620" stop-opacity="0.6" />
          <stop offset="1" stop-color="#2e2620" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="rs-shadow" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#000" stop-opacity="0.7" />
          <stop offset="1" stop-color="#000" stop-opacity="0" />
