---
// The systems map: every entity as a real <button> over an aria-hidden layer of typed edges. Node
// positions are percentages, so the no-JS view is the build-time layout; with JS the layout reruns
// for the panel's actual size. A list view gives the same objects without the graph. Capabilities
// start hidden (except those related to the selection), so the docked map reads at a glance.
import Icon from './Icon.astro';
import EntityShape from './EntityShape.astro';
import { getModel, MISSION, typeName, typeOrder, typePlural, type Entity } from '../lib/model';
import { layout, type EntityType } from '../lib/layout';
import { profile } from '../data/site';

const model = await getModel();
const entities = model.list();
const W = 1000;
const H = 620;
const pos = layout(
  entities.map((e) => ({ id: e.id, type: e.type, label: e.label })),
  model.relations,
  { width: W, height: H, pad: 34, labelScale: 1.1 },
);
const at = new Map(entities.map((e, i) => [e.id, { x: (pos[i].x / W) * 100, y: (pos[i].y / H) * 100 }]));
const pct = (n: number) => `${n.toFixed(2)}%`;

const nodeName = (e: Entity) => {
  const bits = [`${typeName[e.type]}: ${e.title}`];
  if (e.status) bits.push(e.status.label.toLowerCase());
  bits.push(`${model.degree(e.id)} links`);
  return bits.join(', ');
};
const filters: EntityType[] = ['org', 'project', 'skill'];
// Capabilities start filtered out; the expanded map turns them on until the chip is touched.
const startHidden: EntityType[] = ['skill'];
// Every relation kind drawn, grouped by how it is drawn: weight and dash, not hue.
const legend = [
  { cls: 'lg-solid', label: 'Affiliation, built at, personal' },
  { cls: 'lg-dash', label: 'Part of, related' },
  { cls: 'lg-dot', label: 'Uses capability' },
];
---

<section class="pane pane-map panel" data-pane="map" data-map id="pane-map" aria-labelledby="map-title">
  <header class="panel-head">
    <Icon name="graph" class="size-4 shrink-0 text-dim" />
    <h2 class="panel-title" id="map-title">Systems map</h2>
    <span class="map-count code-chip">{entities.length} OBJ · {model.relations.length} LNK</span>
    <div class="ml-auto flex shrink-0 items-center gap-1">
      <div class="seg" role="group" aria-label="Map layout">
        <button type="button" data-map-view="graph" aria-pressed="true" aria-label="Graph" title="Graph"><Icon name="graph" class="size-3.5" /></button>
        <button type="button" data-map-view="list" aria-pressed="false" aria-label="List" title="List"><Icon name="list" class="size-3.5" /></button>
      </div>
      <button type="button" class="map-expand btn btn-ghost btn-icon" data-map-expand aria-pressed="false" aria-label="Expand systems map" title="Expand map">
        <Icon name="expand" class="ico-expand size-4" />
        <Icon name="collapse" class="ico-collapse size-4" />
      </button>
    </div>
  </header>

  <div class="map-tools">
    <div class="map-chips" role="group" aria-label="Show on map">
      {
        filters.map((t) => {
          const on = !startHidden.includes(t);
          return (
            <button type="button" class="chip" data-map-filter={t} aria-pressed={String(on)} title={`${typePlural[t]}: ${on ? 'shown' : 'hidden'}`}>
              <EntityShape type={t} class="size-3 shrink-0" />
              <span class="chip-text">{typePlural[t]}</span>
              <span class="chip-n">{model.list(t).length}</span>
            </button>
          );
        })
      }
      <button type="button" class="chip chip-reset ml-auto" data-map-reset aria-label="Reset map" title="Show the default types and return to the mission">
        <Icon name="reset" class="size-3.5 shrink-0" />
        <span class="chip-text">Reset</span>
      </button>
    </div>
    <ul class="map-legend" aria-label="Edge legend">
      {
        legend.map((l) => (
          <li>
            <svg class="h-2 w-5 shrink-0" aria-hidden="true">
              <line x1="1" y1="4" x2="19" y2="4" class={l.cls} />
            </svg>
            {l.label}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="map-body">
    <div class:list={['map-stage gridfield', startHidden.map((t) => `hide-${t}`)]} data-map-stage>
      <svg class="edges" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {
          model.relations.map((r) => {
            const a = at.get(r.source)!;
            const b = at.get(r.target)!;
            return (
              <line
                class={`ge r-${r.kind}`}
                data-kind={r.kind}
                data-s={r.source}
                data-t={r.target}
                data-types={`${r.source.split(':')[0]} ${r.target.split(':')[0]}`}
                x1={a.x.toFixed(2)}
                y1={a.y.toFixed(2)}
                x2={b.x.toFixed(2)}
                y2={b.y.toFixed(2)}
              />
            );
          })
        }
      </svg>
      <div class="edge-tags" aria-hidden="true" data-edge-tags></div>
      <div class="nodes" role="group" aria-label="Systems map. Arrow keys move between objects, Enter selects." data-map-nodes>
        {
          entities.map((e) => {
            const p = at.get(e.id)!;
            return (
              <button
                type="button"
                class={`gn t-${e.type}`}
                data-id={e.id}
                data-type={e.type}
                data-label={e.label}
                data-href={e.type === 'project' ? e.href : undefined}
                tabindex={e.id === MISSION ? 0 : -1}
                aria-label={nodeName(e)}
                aria-current={e.id === MISSION ? 'true' : undefined}
                style={`left:${pct(p.x)};top:${pct(p.y)}`}
              >
                <span class="shape">
                  {e.type === 'person' && <span class="initials">{profile.initials}</span>}
                  {e.status?.tone === 'active' || e.status?.tone === 'current' ? <span class="live" /> : null}
                </span>
                <span class="lbl" aria-hidden="true">
                  {e.label}
                </span>
              </button>
            );
          })
        }
      </div>
      <p class="map-hint readout" aria-hidden="true">Hover to trace · Select to inspect · Select a project again to open it</p>
    </div>

    <div class="map-list" data-map-list hidden>
      {
        typeOrder.map((t) => (
          <section>
            <h3 class="kicker sticky top-0 z-[1] flex items-center gap-2 border-b border-line bg-panel px-3 py-1.5">
              <EntityShape type={t} class="size-2.5" />
              {t === 'person' ? 'Person' : typePlural[t]}
            </h3>
            <ul>
              {model.list(t).map((e) => (
                <li>
                  <button type="button" class="list-row" data-map-select={e.id} aria-current={e.id === MISSION ? 'true' : undefined}>
                    <span class="min-w-0 flex-1 truncate">{e.title}</span>
                    {e.status && <span class="kicker">{e.status.label}</span>}
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>


  <div class="map-selbar" data-map-selbar>
    <span class="min-w-0 flex-1 truncate text-sm"><span class="kicker mr-1.5">Selected</span><span data-selbar-label></span></span>
    <button type="button" class="btn" data-goto-tab="details">Details</button>
  </div>
</section>

<script>
  import { layout, type EntityType, type LNode, type LEdge } from '../lib/layout';
  import { DEFAULT_SEL, getSel, onPreview, onSelect, preview, select } from '../scripts/selection';

  const pane = document.querySelector<HTMLElement>('[data-map]');
  if (pane) {
    const stage = pane.querySelector<HTMLElement>('[data-map-stage]')!;
    const tags = stage.querySelector<HTMLElement>('[data-edge-tags]')!;
    const list = pane.querySelector<HTMLElement>('[data-map-list]')!;
    const nodes = [...pane.querySelectorAll<HTMLButtonElement>('.gn')];
    const lines = [...pane.querySelectorAll<SVGLineElement>('.ge')];
    const byId = new Map(nodes.map((n) => [n.dataset.id!, n]));
    const adj = new Map<string, Set<string>>();
    for (const l of lines) {
      const { s, t } = l.dataset as { s: string; t: string };
      if (!adj.has(s)) adj.set(s, new Set());
      if (!adj.has(t)) adj.set(t, new Set());
      adj.get(s)!.add(t);
      adj.get(t)!.add(s);
    }
    const lnodes: LNode[] = nodes.map((n) => ({ id: n.dataset.id!, type: n.dataset.type as EntityType, label: n.dataset.label! }));
    const ledges: LEdge[] = lines.map((l) => ({ source: l.dataset.s!, target: l.dataset.t! }));

    // Boxes that must not overlap: node shapes and the labels already placed.
    type Box = { left: number; top: number; right: number; bottom: number };
    const hits = (a: Box, b: Box, m = 2) => a.left < b.right + m && b.left < a.right + m && a.top < b.bottom + m && b.top < a.bottom + m;
    const within = (a: Box, b: Box) => a.left >= b.left && a.right <= b.right && a.top >= b.top && a.bottom <= b.bottom;
    const visible = (n: Element) => (n as HTMLElement).offsetParent !== null;

    // A compact map has room for only some labels. The selection and the traced node always get
    // theirs; then the person, orgs and live projects, in that order, each only where it collides
    // with no node and no label already placed. Each label tries below, above, right, then left.
    const RANK: Record<string, number> = { person: 2, org: 3, project: 4 };
    const rank = (n: HTMLElement) =>
      n.classList.contains('sel') ? 0 : n.classList.contains('traced') ? 1 : n.dataset.type === 'project' && !n.querySelector('.live') ? -1 : (RANK[n.dataset.type!] ?? -1);
    const SIDES = ['b', 't', 'r', 'l'] as const;
    const around = (s: DOMRect, w: number, h: number, side: (typeof SIDES)[number]): Box => {
      const cx = s.left + s.width / 2;
      const cy = s.top + s.height / 2;
      const left = side === 'r' ? s.right + 4 : side === 'l' ? s.left - 4 - w : cx - w / 2;
      const top = side === 'b' ? s.bottom + 3 : side === 't' ? s.top - 3 - h : cy - h / 2;
      return { left, top, right: left + w, bottom: top + h };
    };
    const placeLabels = (shown: HTMLElement[], taken: Box[]) => {
      const want = shown.filter((n) => rank(n) >= 0).sort((a, b) => rank(a) - rank(b));
      stage.classList.add('lbl-measure');
      const sizes = want.map((n) => n.querySelector('.lbl')!.getBoundingClientRect());
      stage.classList.remove('lbl-measure');
      const frame = stage.getBoundingClientRect();
      want.forEach((n, i) => {
        const shape = n.querySelector('.shape')!.getBoundingClientRect();
        // A label sits 3-4px off its own shape, so the 2px margin never counts that as a clash.
        const clash = (b: Box) => taken.filter((t) => hits(t, b)).length + (within(b, frame) ? 0 : 1);
        const tries = SIDES.map((side) => ({ side, box: around(shape, sizes[i].width, sizes[i].height, side) }));
        let pick = tries.find((t) => !clash(t.box));
        // The selection and the traced node are always labelled, in the least crowded spot.
        if (!pick && rank(n) <= 1) pick = tries.reduce((a, b) => (clash(b.box) < clash(a.box) ? b : a));
        if (!pick) return;
        if (pick.side !== 'b') n.dataset.lp = pick.side;
        n.classList.add('lbl-on');
        taken.push(pick.box);
      });
    };

    // While a node is traced, each of its edges is named near its midpoint, where there is room:
    // the tag slides along the edge to the first clear spot, or is left out.
    const REL: Record<string, string> = { affiliation: 'affiliation', partOf: 'part of', builtAt: 'built at', personal: 'personal', related: 'related', uses: 'uses' };
    const ALONG = [0.5, 0.4, 0.6, 0.3, 0.7];
    const tagEdges = (taken: Box[]) => {
      if (!traced) return;
      for (const l of lines) {
        if (!l.classList.contains('on') || !visible(byId.get(l.dataset.s!)!) || !visible(byId.get(l.dataset.t!)!)) continue;
        const [x1, y1, x2, y2] = ['x1', 'y1', 'x2', 'y2'].map((k) => +l.getAttribute(k)!);
        const t = document.createElement('span');
        t.className = 'etag';
        t.textContent = REL[l.dataset.kind!] ?? '';
        tags.append(t);
        const spot = ALONG.find((f) => {
          t.style.left = `${x1 + (x2 - x1) * f}%`;
          t.style.top = `${y1 + (y2 - y1) * f}%`;
          const b = t.getBoundingClientRect();
          if (taken.some((o) => hits(o, b))) return false;
          taken.push(b);
          return true;
        });
        if (spot === undefined) t.remove();
      }
    };
    const relabel = () => {
      nodes.forEach((n) => {
        n.classList.remove('lbl-on');
        delete n.dataset.lp;
      });
      tags.replaceChildren();
      if (stage.hidden || !lastW) return;
      const shown = nodes.filter(visible);
      const taken: Box[] = shown.map((n) => n.querySelector('.shape')!.getBoundingClientRect());
      // A wide map shows every label, so only the edge tags need placing around them.
      if (lastW < 480) placeLabels(shown, taken);
      else for (const n of shown) taken.push(n.querySelector('.lbl')!.getBoundingClientRect());
      tagEdges(taken);
    };

    // Re-run the layout for the panel's real size (compact panels reserve less room for labels).
    let lastW = 0;
    let lastH = 0;
    const relayout = () => {
      const { width, height } = stage.getBoundingClientRect();
      if (width < 60 || height < 60 || (Math.abs(width - lastW) < 2 && Math.abs(height - lastH) < 2)) return;
      lastW = width;
      lastH = height;
      const compact = width < 480;
      const pos = layout(lnodes, ledges, { width, height, pad: compact ? 20 : 34, labels: !compact, labelScale: 1.1 });
      const pct = new Map(lnodes.map((n, i) => [n.id, [(pos[i].x / width) * 100, (pos[i].y / height) * 100]]));
      for (const n of nodes) {
        const [x, y] = pct.get(n.dataset.id!)!;
        n.style.left = `${x.toFixed(2)}%`;
        n.style.top = `${y.toFixed(2)}%`;
      }
      for (const l of lines) {
        const [x1, y1] = pct.get(l.dataset.s!)!;
        const [x2, y2] = pct.get(l.dataset.t!)!;
        l.setAttribute('x1', x1.toFixed(2));
        l.setAttribute('y1', y1.toFixed(2));
        l.setAttribute('x2', x2.toFixed(2));
        l.setAttribute('y2', y2.toFixed(2));
      }
      relabel();
    };
    let queued = 0;
    new ResizeObserver(() => {
      cancelAnimationFrame(queued);
      queued = requestAnimationFrame(relayout);
    }).observe(stage);

    // Highlight the selected (or hovered / focused) entity and its direct relationships only.
    let traced: string | null = null;
    const paint = () => {
      const sel = getSel();
      const focus = traced ?? sel;
      const near = adj.get(focus) ?? new Set<string>();
      stage.classList.add('focus');
      stage.classList.toggle('tracing', !!traced);
      for (const n of nodes) {
        const id = n.dataset.id!;
        n.classList.toggle('on', id === focus || near.has(id));
        n.classList.toggle('sel', id === sel);
        n.classList.toggle('traced', id === traced && id !== sel);
        if (id === sel) n.setAttribute('aria-current', 'true');
        else n.removeAttribute('aria-current');
      }
      for (const l of lines) l.classList.toggle('on', l.dataset.s === focus || l.dataset.t === focus);
      list.querySelectorAll<HTMLElement>('[data-map-select]').forEach((b) => b.toggleAttribute('aria-current', b.dataset.mapSelect === sel));
      relabel();
    };

    // One tab stop for the whole graph; arrow keys move between visible nodes.
    let rove = byId.get(getSel()) ?? nodes[0];
    const setRove = (n: HTMLButtonElement) => {
      if (n === rove) return;
      rove.tabIndex = -1;
      rove = n;
      rove.tabIndex = 0;
    };
    nodes.forEach((n) => (n.tabIndex = n === rove ? 0 : -1));
    const center = (n: HTMLElement) => {
      const r = n.getBoundingClientRect();
      return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
    };
    const DIRS: Record<string, [number, number]> = { ArrowRight: [1, 0], ArrowLeft: [-1, 0], ArrowDown: [0, 1], ArrowUp: [0, -1] };

    stage.addEventListener('keydown', (e) => {
      const n = (e.target as Element).closest<HTMLButtonElement>('.gn');
      if (!n) return;
      let next: HTMLButtonElement | undefined;
      if (e.key in DIRS) {
        const [dx, dy] = DIRS[e.key];
        const a = center(n);
        let best = Infinity;
        for (const m of nodes) {
          if (m === n || !visible(m)) continue;
          const b = center(m);
          const along = (b.x - a.x) * dx + (b.y - a.y) * dy;
          if (along < 4) continue;
          const across = Math.abs((b.x - a.x) * dy - (b.y - a.y) * dx);
          const score = along + across * 2.2;
          if (score < best) {
            best = score;
            next = m;
          }
        }
      } else if (e.key === 'Home') next = byId.get('person:me');
      else if (e.key === 'End') next = byId.get(getSel());
      else return;
      e.preventDefault();
      if (next && visible(next)) {
        setRove(next);
        next.focus();
      }
    });

    stage.addEventListener('click', (e) => {
      const n = (e.target as Element).closest<HTMLButtonElement>('.gn');
      if (!n) return;
      const id = n.dataset.id!;
      setRove(n);
      if (id === getSel() && n.dataset.href) {
        location.href = n.dataset.href;
        return;
      }
      select(id, 'map');
    });

    // Hover and keyboard focus both trace a node's relationships.
    stage.addEventListener('pointerover', (e) => {
      const n = (e.target as Element).closest<HTMLElement>('.gn');
      if (n && e.pointerType === 'mouse') preview(n.dataset.id!);
    });
    stage.addEventListener('pointerout', (e) => {
      const n = (e.target as Element).closest<HTMLElement>('.gn');
      if (n && e.pointerType === 'mouse' && !n.contains(e.relatedTarget as Node)) preview(null);
    });
    stage.addEventListener('focusin', (e) => {
      const n = (e.target as Element).closest<HTMLButtonElement>('.gn');
      if (n) {
        setRove(n);
        if (n.matches(':focus-visible')) preview(n.dataset.id!);
      }
    });
    stage.addEventListener('focusout', () => preview(null));

    onPreview((id) => {
      traced = id;
      paint();
    });
    onSelect(({ id }) => {
      const n = byId.get(id);
      if (n && document.activeElement?.closest('[data-map-stage]') == null) setRove(n);
      paint();
    });

    // Type filters. A hidden type still shows what is related to the selection or the traced node.
    // Capabilities are off in the docked map and on in the expanded one, until their chip is used.
    const filterBtns = [...pane.querySelectorAll<HTMLButtonElement>('[data-map-filter]')];
    const skillBtn = filterBtns.find((b) => b.dataset.mapFilter === 'skill')!;
    const con = pane.closest<HTMLElement>('[data-console]');
    const expanded = () => con?.dataset.expanded === 'true';
    let skillsTouched = false;
    const setFilter = (b: HTMLButtonElement, on: boolean) => {
      b.setAttribute('aria-pressed', String(on));
      b.title = `${b.querySelector('.chip-text')!.textContent}: ${on ? 'shown' : 'hidden'}`;
      stage.classList.toggle(`hide-${b.dataset.mapFilter}`, !on);
      relabel();
    };
    filterBtns.forEach((b) =>
      b.addEventListener('click', () => {
        if (b === skillBtn) skillsTouched = true;
        setFilter(b, b.getAttribute('aria-pressed') !== 'true');
        if (!visible(rove)) setRove(byId.get('person:me')!);
      }),
    );
    if (con) new MutationObserver(() => skillsTouched || setFilter(skillBtn, expanded())).observe(con, { attributes: true, attributeFilter: ['data-expanded'] });
    // Makes sure a type is showing before something of that type is revealed.
    document.addEventListener('map:show-type', (e) => {
      const b = filterBtns.find((x) => x.dataset.mapFilter === (e as CustomEvent<string>).detail);
      if (b && b.getAttribute('aria-pressed') !== 'true') setFilter(b, true);
    });
    pane.querySelector('[data-map-reset]')!.addEventListener('click', () => {
      skillsTouched = false;
      filterBtns.forEach((b) => setFilter(b, b !== skillBtn || expanded()));
      select(DEFAULT_SEL, 'reset');
    });

    // Graph / list.
    const viewBtns = [...pane.querySelectorAll<HTMLButtonElement>('[data-map-view]')];
    viewBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const asList = b.dataset.mapView === 'list';
        viewBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        list.hidden = !asList;
        stage.hidden = asList;
        pane.dataset.view = asList ? 'list' : 'graph';
        if (!asList)
          requestAnimationFrame(() => {
            relayout();
            relabel();
          });
      }),
    );

    pane.addEventListener('map:focus-node', (e) => {
      const id = (e as CustomEvent<string>).detail;
      if (pane.dataset.view === 'list') {
        list.querySelector<HTMLElement>(`[data-map-select="${CSS.escape(id)}"]`)?.focus({ preventScroll: true });
        return;
      }
      const n = byId.get(id);
      if (n && visible(n)) {
        setRove(n);
        n.focus({ preventScroll: true });
      }
    });
  }
</script>
