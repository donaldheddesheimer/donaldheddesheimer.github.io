---
// What `work <id>` prints: one project, in the terminal's own type. It opens on the brief, each fact once:
// the name, what it does, what it's built with and when (and with whom), its one standout result, then my
// part and the hard part, where the brief has them (without one, the summary). Then where to find it (source, and
// demo), and the detail folded away to unfold in place: the cover, the write-up's sections, the Markdown
// its case study (/projects/<id>/) renders, laid out as the terminal lays out text (TermProse.astro), and
// its figures. Last, related work and the way back to `work`. Nothing here is written for the terminal
// alone: a line the brief doesn't have is left out, not guessed at. The lab's terminal holds each in a
// <template> until it's run (Terminal.astro); /computer/work/<id>/ prints one on a page of its own (`live`
// false: commands are links to their pages, and the write-up's headings keep their ids, for that page's
// anchors).
//
// The project's name is the view's heading, an h2 (TermHead.astro), and its parts h3.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import TermCmd from './TermCmd.astro';
import TermHead from './TermHead.astro';
import TermProse from './TermProse.astro';
import { mediaKindLabel, statusLabel } from '../lib/format';
import { related, workMeta } from '../lib/folio';
import { labHref } from '../scripts/lab/routes';

interface Props {
  project: CollectionEntry<'projects'>;
  live?: boolean;
}
const { project, live = true } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const more = related(project, await getCollection('projects'));
// A project's command: the lab running it, or its page.
const href = (id: string) => (live ? labHref(`work/${id}`) : `/computer/work/${id}/`);
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const coverKind = d.evidence.find((m) => m.src === d.cover)?.kind;
const posters = Object.fromEntries(d.evidence.flatMap((m) => (m.poster ? [[m.src, m.poster]] : [])));
const meta = [d.stack, workMeta(d), d.team, statusLabel[d.status].toLowerCase()].filter(Boolean).join(' · ');
// The brief's prose, under its labels, those it has. Its result is the short one `work`'s index shows,
// where there is one (the rest of the brief's is in the write-up or its numbers, so it isn't said twice);
// without one, the brief's, as prose.
const parts = [
  ['My part', d.brief?.mine],
  ['The hard part', d.brief?.hard],
  ['The result', d.result ? undefined : d.brief?.shown],
].filter(([, v]) => v) as [string, string][];
---

<div class="t-out t-project" data-announce={`${d.title}.`} data-project={live ? project.id : undefined}>
  <TermHead view={`work/${project.id}`} title={d.title}>
    <p class="t-purpose">{d.brief?.does ?? d.summary}</p>
    <p class="t-sub">{meta}</p>
  </TermHead>
  {d.result && <p class="t-outcome">{d.result}</p>}
  {
    parts.map(([label, text]) => (
      <section class="t-part">
        <h3 class="t-label">{label}</h3>
        <p class="t-prose">{text}</p>
      </section>
    ))
  }
  <p class="t-links t-actions">
    {
      d.repo ? (
        <a href={d.repo} target="_blank" rel="noopener">
          source<span class="t-dim"> · {host(d.repo)}</span>
          <span aria-hidden="true">↗</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      ) : (
        <span class="t-dim">{d.repoNote ?? 'Private repository'}</span>
      )
    }
    {
      d.demo && (
        <a href={d.demo} target="_blank" rel="noopener">
          demo<span class="t-dim"> · {host(d.demo)}</span>
          <span aria-hidden="true">↗</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      )
    }
  </p>
  <div class="t-detail">
    {
      d.cover && (
        <details class="t-fig">
          <summary>
            <span class="t-dim">cover{coverKind && ` · ${mediaKindLabel[coverKind].toLowerCase()}`}</span> {d.coverAlt}
          </summary>
          <figure class="t-fig-body">
            <img src={d.cover} alt={d.coverAlt ?? ''} loading="lazy" decoding="async" />
          </figure>
        </details>
      )
    }
    <TermProse ids={!live} posters={posters}><Content /></TermProse>
    {
      d.stats.length > 0 && (
        <details class="t-sec">
          <summary>
            <h3 class="t-section">In numbers</h3>
          </summary>
          <dl class="t-kv t-kv-wide t-sec-body">
            {d.stats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd class="t-strong">{s.value}</dd>
              </div>
            ))}
          </dl>
        </details>
      )
    }
  </div>
  {
    more.length > 0 && (
      <p class="t-links">
        <span class="t-dim">related</span>
        {more.map((p) => (
          <TermCmd name={`work ${p.id}`} live={live} href={href(p.id)} />
        ))}
      </p>
    )
  }
  <p class="t-hint">
    Back to <TermCmd name="work" live={live} href={live ? undefined : '/computer/#work'} /> for every project.
  </p>
</div>
