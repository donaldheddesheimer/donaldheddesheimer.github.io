---
// The homepage's room (/, in its main landmark, after the name): a robotics lab after hours, across the
// whole window, with the portfolio on the desk's computer. The figure holds the scene
// (src/scripts/lab/scene.ts) over a still rendered from it, which shows with the page and stays as the
// fallback (no JS, no WebGL, Save-Data until the lab is entered). The dialog is the lab once entered: the
// computer's screen, a terminal (Terminal.astro), and on a touch screen the power button on the
// monitor's bezel that leaves, as Esc does elsewhere (src/scripts/lab/computer.ts). Reduced motion (or
// Motion off, in Settings) holds one composed moment, with no looking around; going in cuts rather than
// flies.
//
// The monitor is the way in, and the only one: a link over it ("Explore my work", to the terminal's page,
// /computer/, which stands alone without JavaScript) where the still shows it (the --mon-* properties
// below, from the still's own numbers), then where the scene draws it (mountLab's onFit). It takes the
// keyboard's focus (a ring round the monitor, which brightens), a screen reader's, and a click without
// the scene; once the scene has drawn, the pointer goes to the scene, which tells a click on the monitor
// from a drag to look around.
import { getCollection } from 'astro:content';
import Terminal from './Terminal.astro';
import { profile } from '../data/site';
import { TERMINAL, pageHref } from '../scripts/lab/routes';

// The projects' ids and names, for the computer's addresses (/?computer=work/<id>) and its title.
const projects = Object.fromEntries((await getCollection('projects')).map((p) => [p.id, p.data.title]));
---

<figure data-lab-root class="lab">
  <div class="lab-canvas" data-lab-stage>
    <picture class="still">
      <source media="(max-aspect-ratio: 4/5)" srcset="/lab/opening-tall.webp" width="720" height="1440" />
      <img src="/lab/opening-wide.webp" alt="" width="1600" height="1000" fetchpriority="high" decoding="async" />
    </picture>
    <a href={pageHref(TERMINAL)} class="lab-monitor" data-lab-monitor aria-label="Explore my work" draggable="false"></a>
  </div>
  <figcaption class="sr-only">A robotics lab after hours: a computer on a desk, three robots dancing behind it, an unfinished one on its stand. Illustration.</figcaption>
</figure>

<dialog class="pc" data-pc-dialog aria-label="Portfolio terminal, on the lab's computer" tabindex="-1" data-projects={JSON.stringify(projects)} data-title={`Terminal · ${profile.name}`}>
  <div class="pc-screen" data-pc-screen>
    <Terminal />
  </div>
  <button type="button" class="pc-exit" data-pc-exit aria-label="Leave the computer" aria-keyshortcuts="Escape">
    <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <path d="M5 3.9a5.4 5.4 0 1 0 6 0" />
      <path d="M8 1.9v5.2" />
    </svg>
  </button>
</dialog>

<script>
  import type { LabScene, Rect } from '../scripts/lab/scene';
  import { initComputer } from '../scripts/lab/computer';

  const html = document.documentElement;
  const root = document.querySelector<HTMLElement>('[data-lab-root]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-pc-dialog]');
  const link = document.querySelector<HTMLElement>('[data-lab-monitor]');
  const avoid = document.querySelector<HTMLElement>('[data-lab-avoid]');

  // The link over the monitor, where the scene draws it; without the scene (not yet, or lost), where the
  // still shows it.
  function place(mon: Rect | null) {
    if (!link) return;
    const on = mon && root?.dataset.failed == null;
    for (const [k, v] of [['left', mon?.x], ['top', mon?.y], ['width', mon?.w], ['height', mon?.h]] as const) {
      if (on) link.style.setProperty(k, `${Math.round(v!)}px`);
      else link.style.removeProperty(k);
    }
  }

  if (root && dialog) {
    let scene: LabScene | null = null;
    let loading: Promise<LabScene | null> | null = null;
    const saveData = !!(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    // Focused from the keyboard, the link rings the monitor where it's drawn, following it as the room
    // sways, and the monitor brightens as it does under the pointer: from the focus, or from the room's
    // first frame if the focus came first.
    let follow = 0;
    const track = () => {
      const s = scene as LabScene | null;
      follow = s && document.activeElement === link && root.dataset.failed == null ? requestAnimationFrame(track) : 0;
      if (follow) place(s!.monitor());
    };
    const ring = () => {
      const s = scene as LabScene | null;
      if (!s || !link || follow || root.dataset.drawn == null || root.dataset.failed != null) return;
      if (document.activeElement !== link || !link.matches(':focus-visible')) return;
      s.highlight(true);
      track();
    };
    const onFit = (r: Rect) => {
      if (!follow) place(r);
      ring();
    };
    const load = () =>
      (loading ??= import('../scripts/lab/scene')
        .then((m) => {
          scene = m.mountLab(root, { avoid, onFit });
          if (!scene) root.setAttribute('data-failed', '');
          // For the review's measurements (docs/evidence/lab-cinematic-2026-09-28): /?probe.
          if (new URLSearchParams(location.search).has('probe')) Object.assign(window, { __lab: scene });
          return scene;
        })
        .catch(() => {
          root.setAttribute('data-failed', '');
          return null;
        }));
    const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1200 }) : setTimeout(fn, 150));
    // Text first: the scene is requested once the page has loaded. With reduced motion it still loads,
    // and holds still; with Save-Data it waits for the lab to be entered.
    if (!saveData) {
      const start = () => idle(() => load());
      if (document.readyState === 'complete') start();
      else addEventListener('load', start, { once: true });
    }
    addEventListener('pagehide', (e) => {
      if (e.persisted || !scene) return;
      scene.dispose();
      scene = null;
      loading = null;
      place(null);
    });
    // Drawn, the ring (if the focus is there already); lost, the still's monitor again.
    new MutationObserver(() => (root.dataset.failed != null ? place(null) : ring())).observe(root, { attributes: true, attributeFilter: ['data-failed', 'data-drawn'] });
    link?.addEventListener('focus', ring);
    link?.addEventListener('blur', () => {
      cancelAnimationFrame(follow);
      follow = 0;
      (scene as LabScene | null)?.highlight(false);
    });
    initComputer(root, dialog, () => scene, load, !saveData);
  }
</script>

<style>
  /* The still's own numbers: its aspect, and the monitor's bezel in it (fractions of its width and
     height, as the scene measured them when it drew the still), for the monitor's link to stand where the
     still shows it. Retake them with the stills (docs/lab-scene-handoff.md). The still
     covers the window, centred, or in a window more than twice as wide as it is tall, lower (--still-py:
     its top as a share of the overflow), so the monitor stays in view. */
  :global(:root) {
    --still-a: 1.6;
    --still-ml: 0.3392;
    --still-mt: 0.5889;
    --still-mr: 0.5396;
    --still-mb: 0.7884;
  }
  @media (max-aspect-ratio: 4/5) {
    :global(:root) {
      --still-a: 0.5;
      --still-ml: 0.253;
      --still-mt: 0.4627;
      --still-mr: 0.747;
      --still-mb: 0.6173;
    }
  }
  :global(:root) {
    --still-py: 0.5;
  }
  @media (min-aspect-ratio: 2/1) {
    :global(:root) {
      --still-py: 0.75;
    }
  }
  :global(:root) {
    --still-w: max(100vw, 100dvh * var(--still-a));
    --still-h: calc(var(--still-w) / var(--still-a));
    --mon-l: calc((100vw - var(--still-w)) / 2 + var(--still-w) * var(--still-ml));
    --mon-r: calc((100vw - var(--still-w)) / 2 + var(--still-w) * var(--still-mr));
    --mon-t: calc((100dvh - var(--still-h)) * var(--still-py) + var(--still-h) * var(--still-mt));
    --mon-b: calc((100dvh - var(--still-h)) * var(--still-py) + var(--still-h) * var(--still-mb));
  }

  /* The room: the whole window, behind everything, still while the page over it scrolls. */
  .lab {
    position: fixed;
    inset: 0;
    margin: 0;
  }
  .lab-canvas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: #0a0908;
  }
  .lab-canvas :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  [data-drawn] .lab-canvas :global(canvas) {
    opacity: 1;
  }
  [data-failed] .lab-canvas :global(canvas) {
    display: none;
  }
  :global(html[data-motion='off']) .lab-canvas :global(canvas) {
    transition: none;
  }
  /* Reading: the room steps back behind the page while the robots come to rest (scene.ts quiet()). */
  .lab-canvas::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(5 4 3 / 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease);
  }
  :global(html[data-pc='read']) .lab-canvas::after {
    opacity: 1;
  }
  /* The still stands where the room will draw, then gives way once the scene has drawn. */
  .still,
  .still img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .still img {
    object-fit: cover;
    object-position: 50% calc(var(--still-py) * 100%);
    transition: opacity 0.25s ease;
  }
  [data-drawn]:not([data-failed]) .still img {
    opacity: 0;
  }
  /* The way in: the monitor, and a ring round it when the keyboard is on it. Once the scene has drawn,
     the pointer passes through to it (scene.ts picks the monitor, and tells a click from a drag). */
  .lab-monitor {
    position: absolute;
    z-index: 1;
    left: var(--mon-l);
    top: var(--mon-t);
    width: calc(var(--mon-r) - var(--mon-l));
    height: calc(var(--mon-b) - var(--mon-t));
    border-radius: 3px;
    cursor: pointer;
    -webkit-user-drag: none;
  }
  .lab-monitor:focus-visible {
    outline: 2px solid var(--blue-3);
    outline-offset: 5px;
  }
  [data-drawn]:not([data-failed]) .lab-monitor {
    pointer-events: none;
  }
  :global(html[data-pc-loading]) .lab-monitor {
    cursor: progress;
  }

  /* The lab, once entered: the whole window, see-through but for the computer's screen, over the scene,
     which fills the window under it. The screen (computer.ts sizes and places it) rides the drawn one in
     flight and lies flat over it to read; the terminal fills it. */
  .pc {
    --chin: env(safe-area-inset-bottom);
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: transparent;
    color: var(--text);
    outline: none;
  }
  .pc::backdrop {
    background: transparent;
  }
  .pc-screen {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    container-type: size;
    background: #171513;
    transform-origin: 0 0;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  /* The way out on a touch screen, with no Esc to hand: a power button on the bezel, under the screen at
     its right. A finger's target: 44px, reaching on down past a bezel too narrow for its box
     (computer.ts). With a mouse or a keyboard, Esc leaves, and there's no button. */
  .pc-exit {
    position: absolute;
    top: 0;
    left: 0;
    display: none;
    place-items: center;
    width: var(--pc-exit, 2.75rem);
    height: var(--pc-exit, 2.75rem);
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #8a8278;
    cursor: pointer;
    transform: translate(-50%, -50%);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0.3s,
      color 0.15s ease;
  }
  @media (pointer: coarse) {
    .pc-exit {
      display: grid;
    }
  }
  :global(html[data-pc='read']) .pc-exit {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.3s var(--ease) 0.15s,
      color 0.15s ease;
  }
  .pc-exit:focus-visible {
    color: #ebe5da;
    outline: 2px solid #e2a95c;
    outline-offset: -3px;
  }
  .pc-exit::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 2.75rem;
    height: 2.75rem;
    transform: translateX(-50%);
  }
  :global(html[data-motion='off']) .pc-screen,
  :global(html[data-motion='off']) .pc-exit {
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .pc-screen,
    .pc-exit {
      transition: none;
    }
  }
  /* A window too small to read on the monitor with the room round it: the screen across the window,
     inside its safe area and above a keyboard (--vv-*: what can be seen, computer.ts), with a chin
     under it for the power button on a touch screen. While a keyboard is up, the chin and the button
     go. */
  :global(html[data-pc-full]) .pc {
    background: #0e0d0c;
  }
  @media (pointer: coarse) {
    .pc {
      --chin: calc(2.75rem + env(safe-area-inset-bottom));
    }
  }
  :global(html[data-pc-kb]) .pc {
    --chin: 0px;
  }
  :global(html[data-pc-full]) .pc-screen {
    top: calc(var(--vv-top, 0px) + env(safe-area-inset-top));
    left: env(safe-area-inset-left);
    width: calc(100% - env(safe-area-inset-left) - env(safe-area-inset-right)) !important;
    height: calc(var(--vv-h, 100dvh) - env(safe-area-inset-top) - var(--chin)) !important;
    transform: none !important;
  }
  :global(html[data-pc-full]) .pc-exit {
    top: calc(var(--vv-top, 0px) + var(--vv-h, 100dvh) - env(safe-area-inset-bottom) - 1.375rem);
    left: calc(100% - max(1.75rem, env(safe-area-inset-right) + 1.5rem));
  }
  :global(html[data-pc-kb]) .pc-exit {
    display: none;
  }
</style>
