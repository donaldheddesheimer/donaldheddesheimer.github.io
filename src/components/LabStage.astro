---
// The homepage's opening (/): a robotics lab after hours with the portfolio on the desk's computer. The
// figure holds the scene (src/scripts/lab/scene.ts) over a composed SVG still of the robots, which renders
// with the page and stays as the fallback (no JS, no WebGL). The dialog is the lab once entered: nothing
// but the frame the portfolio reads in (src/scripts/lab/computer.ts); the way out is on the computer.
// Save-Data leaves the scene unloaded until the lab is entered (the still stands in). Reduced motion (or
// Motion off, in the page's settings or its footer) loads it and holds one composed moment, with no
// looking around; going in cuts rather than flies.
import { profile } from '../data/site';
import { workLede, workMeta, workProjects } from '../lib/folio';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;

// The monitor's picture before the page is laid over it: the computer's Work page, as it first shows.
const { lead, rest } = await workProjects();
const screen = {
  name: profile.name,
  lede: workLede,
  cards: lead.map(({ p, still }) => ({ title: p.data.title, meta: workMeta(p.data), img: still!.src, contain: p.data.cardFit === 'contain' })),
};
const projects = [...lead, ...rest].map(({ p }) => p.id);
---

