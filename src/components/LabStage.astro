    </svg>
  </div>
  <figcaption class="lab-cap"><span class="cap-title">After hours in the lab.</span> <span class="cap-note">Illustration</span></figcaption>
</figure>

<dialog class="pc" data-pc-dialog aria-label="Portfolio, on the lab's computer" tabindex="-1" data-projects={JSON.stringify(projects)}></dialog>

<script>
  import type { LabScene, ScreenData } from '../scripts/lab/scene';
  import { initComputer } from '../scripts/lab/computer';

  const root = document.querySelector<HTMLElement>('[data-lab-root]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-pc-dialog]');
  if (root && dialog) {
    let scene: LabScene | null = null;
    let loading: Promise<LabScene | null> | null = null;
    let screen: ScreenData | null = null;
    try {
      screen = JSON.parse(root.dataset.screen ?? 'null');
    } catch {}
    const saveData = !!(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    const load = () =>
      (loading ??= import('../scripts/lab/scene')
        .then((m) => {
          scene = m.mountLab(root, { screen, avoid: document.querySelector<HTMLElement>('[data-lab-avoid]') });
          if (!scene) root.setAttribute('data-failed', '');
          // For the review's measurements (docs/evidence/lab-cinematic-2026-09-28): /?probe.
          if (new URLSearchParams(location.search).has('probe')) Object.assign(window, { __lab: scene });
          return scene;
        })
        .catch(() => {
          root.setAttribute('data-failed', '');
          return null;
        }));
    const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1200 }) : setTimeout(fn, 150));
    // Text first: the scene is requested once the page has loaded. With reduced motion it still loads,
    // and holds still; with Save-Data it waits for the lab to be entered.
    if (!saveData) {
      const start = () => idle(() => load());
      if (document.readyState === 'complete') start();
      else addEventListener('load', start, { once: true });
    }
    addEventListener('pagehide', (e) => {
      if (e.persisted || !scene) return;
      scene.dispose();
      scene = null;
      loading = null;
    });
    initComputer(root, dialog, () => scene, load, !saveData);
  }
</script>

<style>
  .lab {
    position: relative;
    margin: 0;
  }
  .lab-canvas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: #0a0908;
  }
  .lab-canvas :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  [data-drawn] .lab-canvas :global(canvas) {
    opacity: 1;
  }
  [data-failed] .lab-canvas :global(canvas) {
    display: none;
  }
  /* Reading: the room steps back behind the page while the robots come to rest (scene.ts quiet()). */
  .lab-canvas::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(5 4 3 / 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease);
  }
  :global(html[data-pc='read']) .lab-canvas::after {
    opacity: 1;
  }
  /* The still stands where the dancers will, then gives way once the scene has drawn. */
  .still {
    position: absolute;
    bottom: var(--still-bottom, 8%);
    left: var(--still-x, 50%);
    width: min(var(--still-w, 90%), 780px);
    height: 80%;
    translate: -50% 0;
    transition: opacity 0.25s ease;
  }
  [data-drawn]:not([data-failed]) .still {
    opacity: 0;
  }

  .lab-cap {
    position: absolute;
    left: var(--cap-left, 1rem);
    bottom: var(--cap-bottom, 0.875rem);
    z-index: 2;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--muted);
    white-space: nowrap;
  }
  .cap-title {
    font-style: italic;
  }
  .cap-note {
    margin-left: 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }
  /* Stacked (phones, and any window the lab can't open in): the picture is a band, its caption and
     controls a row under it, in the page's flow. */
  @media not ((width >= 64rem) and (height >= 36rem) and (min-aspect-ratio: 3/2)) {
    .lab {
      display: grid;
      grid-template:
        'stage' var(--stage-h, 15rem)
        'cap' auto
        / minmax(0, 1fr);
    }
    .lab-canvas {
      position: relative;
      grid-area: stage;
      align-self: stretch;
    }
    .lab-cap {
      position: relative;
      inset: auto;
      grid-area: cap;
      padding: 0.625rem var(--home-inset, 1rem);
    }
  }
  @media (width < 40rem) {
    .lab-cap {
      font-size: var(--text-xs);
      white-space: normal;
    }
    .cap-note {
      display: block;
      margin-left: 0;
    }
  }

  /* The lab, once entered: the whole window, see-through but for the page's frame (added by
     computer.ts), over the scene, which fills the window under it. */
  .pc {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: transparent;
    color: var(--text);
    outline: none;
  }
  .pc::backdrop {
    background: transparent;
  }
  .pc :global(.pc-frame) {
    position: absolute;
    top: 0;
    left: 0;
    border: 0;
    background: var(--bg);
    transform-origin: 0 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease);
  }
  :global(html[data-pc='read']) .pc :global(.pc-frame) {
    pointer-events: auto;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06),
      0 24px 80px rgb(0 0 0 / 0.55);
  }
  /* A window too small for the room round it: the page, across the window. */
  :global(html[data-pc-full]) .pc :global(.pc-frame) {
    width: 100% !important;
    height: 100% !important;
    transform: none !important;
    box-shadow: none;
  }
  :global(html[data-pc-loading]) [data-lab-enter] {
    cursor: progress;
  }
</style>
