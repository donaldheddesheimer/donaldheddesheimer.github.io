      <ellipse cx="150" cy="373" rx="70" ry="10" fill="url(#ls-shadow)" />
      <ellipse cx="488" cy="379" rx="48" ry="8" fill="url(#ls-shadow)" />
      <ellipse cx="300" cy="390" rx="66" ry="10" fill="url(#ls-shadow)" />
      <g transform="translate(150 372) scale(0.88) translate(-163 -382)">
        <g stroke-linecap="round" fill="none">
          <path d="M145 300 140 336 142 372M178 300 183 336 184 372" stroke="url(#ls-graphite)" stroke-width="20" />
          <path d="M112 216 86 180 72 146M210 216 236 180 250 146" stroke="url(#ls-graphite)" stroke-width="15" />
        </g>
        <g fill="#1b1e23">
          <rect x="120" y="368" width="42" height="14" rx="5" /><rect x="164" y="368" width="42" height="14" rx="5" />
          <circle cx="140" cy="336" r="10" /><circle cx="183" cy="336" r="10" />
          <circle cx="86" cy="180" r="9" /><circle cx="236" cy="180" r="9" />
          <circle cx="70" cy="142" r="10" /><circle cx="252" cy="142" r="10" />
