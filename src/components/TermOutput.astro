---
// What one of the terminal's commands prints, as real HTML: `help`, the four it lists, and the answers
// to a project that isn't there and to anything else. From src/data/site.ts and the projects, nothing
// added. (A project's own, `work <id>`, is TermProject.astro.) The lab's terminal holds each in a
// <template> until it's run (Terminal.astro); the /computer/ transcript prints them all (`live` false:
// commands are links to where they ran, and there's nothing to copy with).
//
// Plain text laid out as a terminal lays it out: a heading per part, key and value columns, "- " lists.
// Each view opens with where it is and its title, an h2 (TermHead.astro); parts are h3 and entries h4.
// The answers to a mistake aren't views: the lab's terminal says them over its prompt (terminal.ts).
import { getCollection } from 'astro:content';
import TermCmd from './TermCmd.astro';
import TermHead from './TermHead.astro';
import WorkRow from './WorkRow.astro';
import { contact, education, experience, offDuty, orgs, profile, skills, socials } from '../data/site';
import { fmtMonth } from '../lib/format';
import { byWork } from '../lib/folio';
import { HELP, NOT_FOUND, NO_PROJECT } from '../lib/terminal';

interface Props {
  cmd: 'help' | 'about' | 'work' | 'resume' | 'contact' | 'no-project' | 'not-found';
  live?: boolean;
}
const { cmd, live = true } = Astro.props;

const org = (id: string) => orgs.find((o) => o.id === id)!;
const host = (href: string) => href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const projects = (await getCollection('projects')).sort(byWork);
// `work` shows the featured first; the rest wait behind a line that shows them.
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
const file = `${profile.name.replace(/\s+/g, '-')}-Resume.pdf`;
const current = experience.find((e) => !e.end);
---

{
  cmd === 'help' && (
    <div class="t-out t-stagger" data-announce={`Commands: ${HELP.map((h) => h.cmd).join(', ')}.`}>
      <TermHead view="help" title="Commands" />
      <ul class="t-help">
        {HELP.map((h, i) => (
          <li style={`--i:${i}`}>
            <TermCmd name={h.cmd} live={live} />
            <span>{h.label}</span>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  cmd === 'about' && (
    <div class="t-out" data-announce="About me.">
      <TermHead view="about" title="About" />
      <p>
        <strong class="t-strong">{profile.name}</strong> <span class="t-dim">· {profile.headline}</span>
      </p>
      <p class="t-dim">
        {profile.school} · {profile.location}
      </p>
      {profile.about.map((para) => (
        <p class="t-prose">{para}</p>
      ))}
      <dl class="t-kv">
        {current && (
          <div>
            <dt>now</dt>
            <dd>
              {current.role}, {org(current.org).name}
            </dd>
          </div>
        )}
        <div>
          <dt>off duty</dt>
          <dd>{offDuty.map((h) => h.name).join(', ')}</dd>
        </div>
      </dl>
      <p class="t-hint">
        Run <TermCmd name="work" live={live} /> to see what I've built, or <TermCmd name="contact" live={live} /> to say hello.
      </p>
    </div>
  )
}

{
  cmd === 'work' && (
    <div class="t-out" data-announce={`Selected work: ${featured.length} featured of ${projects.length} projects.`}>
      <TermHead view="work" title="Selected work">
        <p class="t-sub">GPU software, simulation and tools, and a few from before.</p>
      </TermHead>
      <ol class="t-work" role="list">
        {featured.map((p, i) => (
          <WorkRow project={p} n={i + 1} live={live} />
        ))}
      </ol>
      {rest.length > 0 && (
        <details class="t-more">
          <summary>
            <span class="t-more-show">Show all {projects.length} projects</span>
            <span class="t-more-hide">Show featured only</span>
          </summary>
          <ol class="t-work" role="list">
            {rest.map((p, i) => (
              <WorkRow project={p} n={featured.length + i + 1} live={live} />
            ))}
          </ol>
        </details>
      )}
      <p class="t-hint">
        Or run <span class="t-strong">work &lt;id&gt;</span>; Tab completes the id.
      </p>
    </div>
  )
}

{
  cmd === 'resume' && (
    <div class="t-out" data-announce="Résumé, with the PDF to download.">
      <TermHead view="resume" title="Résumé" />
      <p class="t-links">
        <a href={profile.resume} download={file}>
          <span aria-hidden="true">↓ </span>Download the PDF
        </a>
        <span class="t-dim">{file}</span>
      </p>

      <h3 class="t-section">Experience</h3>
      <ul class="t-list">
        {experience.map((e) => (
          <li>
            <div class="t-row">
              <h4 class="t-strong">
                {e.role}, {org(e.org).name}
              </h4>
              <span class="t-dim">
                {fmtMonth(e.start)} – {e.end ? fmtMonth(e.end) : 'Present'}
              </span>
            </div>
            <p class="t-dim">
              {e.unit && `${e.unit} · `}
              {e.location}
            </p>
            <ul class="t-points">
              {e.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>

      <h3 class="t-section">Education</h3>
      <div class="t-row">
        <h4 class="t-strong">{education.school}</h4>
        <span class="t-dim">
          {fmtMonth(education.start)} – {fmtMonth(education.end)} (expected)
        </span>
      </div>
      <p>
        {education.degree} · {education.program} · {education.thread} · GPA {education.gpa}
      </p>
      <p class="t-dim">Coursework: {education.coursework.join(', ')}</p>

      <h3 class="t-section">Skills</h3>
      <dl class="t-kv t-kv-wide">
        {skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>{s.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
      <p class="t-hint">
        Run <TermCmd name="contact" live={live} /> to get in touch.
      </p>
    </div>
  )
}

{
  cmd === 'contact' && (
    <div class="t-out" data-announce="Contact: email, GitHub and LinkedIn.">
      <TermHead view="contact" title="Contact" />
      <p class="t-prose">
        {contact.title} {contact.note}
      </p>
      <dl class="t-kv">
        <div>
          <dt>email</dt>
          <dd>
            <a href={`mailto:${profile.email}`} data-term-email>
              {profile.email}
            </a>
            {live && (
              <button type="button" class="t-cmd t-copy" data-term-copy={profile.email} aria-label={`copy ${profile.email}`}>
                copy
              </button>
            )}
          </dd>
        </div>
        {socials
          .filter((s) => s.id !== 'email')
          .map((s) => (
            <div>
              <dt>{s.id}</dt>
              <dd>
                <a href={s.href} target="_blank" rel="noopener" aria-label={`${s.label}: ${host(s.href)} (opens in a new tab)`}>
                  {host(s.href)}
                  <span aria-hidden="true">↗</span>
                </a>
              </dd>
            </div>
          ))}
      </dl>
      <p class="t-dim">Based in {profile.location}.</p>
    </div>
  )
}

{
  cmd === 'no-project' && (
    <div class="t-out">
      <p>
        {NO_PROJECT[0]}
        <span class="t-strong" data-term-arg />
        {NO_PROJECT[1]}
        <TermCmd name="work" live={live} />
        {NO_PROJECT[2]}
      </p>
      <p data-term-guess hidden>
        Did you mean <span data-term-guesses />?
      </p>
    </div>
  )
}

{
  cmd === 'not-found' && (
    <div class="t-out">
      <p>
        <span class="t-strong" data-term-arg />
        {NOT_FOUND[0]}
        <TermCmd name="help" live={live} />
        {NOT_FOUND[1]}
      </p>
    </div>
  )
}
