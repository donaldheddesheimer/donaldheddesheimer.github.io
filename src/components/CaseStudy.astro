---
// A case study's content: its title band, write-up, details and related work, and the pager. On the
// project's own page (/projects/<id>/) and on the lab computer (/computer/work/<id>/).
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import NewTab from './NewTab.astro';
import Stat from './Stat.astro';
import { fmtMonth, mediaKindLabel, statusLabel } from '../lib/format';

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
  /** Where another project's case study is. */
  projectHref?: (id: string) => string;
  /** Where "All projects" goes. */
  indexHref?: string;
}
const { project, prev, next, projectHref = (id: string) => `/projects/${id}/`, indexHref = '/computer/work/' } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const all = await getCollection('projects');
// Related projects: most shared tags.
const related = all
  .filter((p) => p.id !== project.id)
  .map((p) => ({ p, shared: p.data.tags.filter((t) => d.tags.includes(t)).length }))
  .filter((r) => r.shared > 0)
  .sort((a, b) => b.shared - a.shared || b.p.data.code.localeCompare(a.p.data.code))
  .slice(0, 3);

// The cover's caption names its kind only when the evidence list already says what it is.
const coverKind = d.evidence.find((m) => m.src === d.cover)?.kind;
---

<!-- A case study reads like the room it opens from: a title over a warm dark band, the write-up, and
     a quiet column of details and related work. -->
<header class="cs-head">
  <a href={indexHref} class="cs-back">
    <Icon name="arrow-left" class="size-3.5" /> All projects
  </a>
  <p class="cs-meta">
    <span class={`pill pill-${d.status}`}>{statusLabel[d.status]}</span>
    <span>
      {fmtMonth(d.start)}
      {d.context && ` · ${d.context}`}
    </span>
  </p>
  <h1 class="cs-title">{d.title}</h1>
  <p class="cs-summary">{d.summary}</p>
  <div class="cs-actions">
    {
      d.demo && (
        <a href={d.demo} class="btn btn-primary" target="_blank" rel="noopener">
          <NewTab class="size-4" />
          Live demo
        </a>
      )
    }
    {
      d.repo ? (
        <a href={d.repo} class:list={['btn', !d.demo && 'btn-primary']} target="_blank" rel="noopener">
          <Icon name="github" class="size-4" />
          Repository
          <NewTab />
        </a>
      ) : (
        <p class="inline-flex min-h-(--h-md) items-center gap-1.5 text-dim">
          <Icon name="lock" class="size-4" />
          {d.repoNote ?? 'Private repository'}
        </p>
      )
    }
  </div>
  {
    d.stats.length > 0 && (
      <dl class="cs-stats">
        {d.stats.map((s) => (
          <Stat label={s.label} value={s.value} />
        ))}
      </dl>
    )
  }
</header>

<div class="cs-body">
  <div class="min-w-0">
    {
      d.cover && (
        <figure class="cs-cover">
          <div class="cs-cover-well">
            <img src={d.cover} alt={d.coverAlt ?? ''} />
          </div>
          <figcaption class="fig-cap">
            <span class="kicker">Cover{coverKind && ` · ${mediaKindLabel[coverKind]}`}</span>
            {d.coverAlt}
          </figcaption>
        </figure>
      )
    }
    <article class="prose">
      <Content />
    </article>
  </div>

  <aside class="cs-aside" aria-label="About this project">
    <section>
      <h2 class="cs-aside-title">Details</h2>
      <dl class="cs-facts">
        <div>
          <dt>Started</dt>
          <dd>{fmtMonth(d.start)}</dd>
        </div>
        <div>
          <dt>Context</dt>
          <dd>{d.context ?? 'Personal project'}</dd>
        </div>
        {
          d.team && (
            <div>
              <dt>Team</dt>
              <dd>{d.team}</dd>
            </div>
          )
        }
        <div>
          <dt>Source</dt>
          <dd class="wrap-anywhere">
            {
              d.repo ? (
                <a href={d.repo} class="inline-flex max-w-full items-center gap-1 text-blue-3 hover:underline pointer-coarse:-my-3 pointer-coarse:py-3" target="_blank" rel="noopener">
                  {d.repo.replace('https://github.com/', '')}
                  <NewTab />
                </a>
              ) : (
                <span class="text-dim">{d.repoNote ?? 'Private'}</span>
              )
            }
          </dd>
        </div>
      </dl>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {d.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </section>

    {
      related.length > 0 && (
        <section>
          <h2 class="cs-aside-title">Related work</h2>
          <div class="cs-group">
            <ul>
              {related.map(({ p }) => (
                <li>
                  <a href={projectHref(p.id)} class="cs-link">
                    <span class="min-w-0 flex-1 truncate">{p.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </aside>
</div>

<nav class="cs-pager" aria-label="More projects">
  {
    prev ? (
      <a href={projectHref(prev.id)} class="cs-pager-link">
        <span class="cs-pager-dir">
          <Icon name="arrow-left" class="size-3.5" /> Previous
        </span>
        <span class="cs-pager-title">{prev.data.title}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next && (
      <a href={projectHref(next.id)} class="cs-pager-link is-next">
        <span class="cs-pager-dir">
          Next <Icon name="arrow-right" class="size-3.5" />
        </span>
        <span class="cs-pager-title">{next.data.title}</span>
      </a>
    )
  }
</nav>

<style>
  /* The title band: the opening's warm dark, running up under the header bar and down into the page. */
  /* --cs-under: the height of the bar it runs under (the computer's own bar: Screen.astro). */
  .cs-head {
    margin-top: calc(-1 * var(--cs-under, 3.5rem));
    padding: calc(var(--cs-under, 3.5rem) + clamp(1.25rem, 4vw, 3.5rem)) var(--home-edge) clamp(2rem, 4vw, 3rem);
    background:
      radial-gradient(55% 90% at 15% 0%, rgb(255 184 120 / 0.075), transparent 70%),
      linear-gradient(#0a0908, #0a0908 55%, var(--bg));
  }
  .cs-back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: var(--h-md);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .cs-back:hover {
    color: var(--text);
  }
  .cs-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.75rem;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--dim);
  }
  .cs-title {
    margin-top: 0.75rem;
    max-width: 18ch;
    font-size: clamp(2.25rem, 7vw, 4rem);
    line-height: 1.02;
    font-weight: 650;
    letter-spacing: -0.03em;
    color: var(--text);
    text-wrap: balance;
  }
  .cs-summary {
    margin-top: 1rem;
    max-width: 58ch;
    font-size: clamp(var(--text-md), 1.6vw, var(--text-lg));
    line-height: 1.55;
    color: var(--muted);
  }
  .cs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  /* The figures on one rule, as many as there are: no empty cells. */
  .cs-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.25rem 2rem;
    max-width: 52rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .cs-body {
    display: grid;
    gap: 3rem;
    padding: 1rem var(--home-edge) 0;
  }
  @media (width >= 64rem) {
    .cs-body {
      grid-template-columns: minmax(0, 1fr) 17.5rem;
      gap: clamp(3rem, 5vw, 5rem);
    }
  }
  .cs-cover {
    margin-bottom: 2.5rem;
  }
  .cs-cover-well {
    display: grid;
    place-items: center;
    padding: clamp(0.75rem, 3%, 1.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-2);
    background: radial-gradient(70% 60% at 50% 100%, rgb(255 255 255 / 0.04), transparent 72%), var(--well);
  }
  .cs-cover-well img {
    max-height: 70vh;
    object-fit: contain;
  }

  /* Details and connections: text on the page, no panels. */
  .cs-aside {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  @media (width >= 64rem) {
    .cs-aside {
      align-self: start;
      padding-top: 0;
      border-top: 0;
    }
  }
  .cs-aside-title {
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
  }
  .cs-facts {
    display: grid;
    gap: 0.625rem;
    margin-top: 0.875rem;
    font-size: var(--text-sm);
  }
  .cs-facts > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
  }
  .cs-facts dt {
    color: var(--dim);
  }
  .cs-group {
    margin-top: 0.875rem;
  }
  .cs-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .cs-link:hover {
    color: var(--text);
  }
  @media (pointer: coarse) {
    .cs-link {
      min-height: var(--h-touch);
    }
  }

  .cs-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 4rem var(--home-edge) 0;
    padding: 1.5rem 0 3rem;
    border-top: 1px solid var(--line);
  }
  .cs-pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }
  .cs-pager-link.is-next {
    align-items: flex-end;
    text-align: right;
  }
  .cs-pager-dir {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--dim);
  }
  .cs-pager-title {
    max-width: 100%;
    overflow: hidden;
    font-size: clamp(var(--text-md), 2vw, var(--text-xl));
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cs-pager-link:hover :is(.cs-pager-dir, .cs-pager-title) {
    color: var(--text);
  }
</style>
