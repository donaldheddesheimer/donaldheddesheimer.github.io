---
// The terminal's pixel robot: beside my name at the startup (TermHello.astro) and in `about`
// (TermOutput.astro). Decoration, in the terminal's own colours, drawn from the grid below (a letter to
// a pixel, a rect to each run of one colour in a row) so it stays crisp at any size: metal lit from the
// left, a dark visor, and the accent for its eyes, ear, antenna and chest light.
const GRID = [
  '...............we...............',
  '..............eeee..............',
  '...............oo...............',
  '...............oo...............',
  '........oooooooooooooooo........',
  '.......ollllllllllllllllo.......',
  '......olmmmmmmmmmmmmmmmmmo......',
  '.....olmmffffffffffffffmmso.....',
  '...ooolmfffweffffffwefffmso.....',
  '..oaaolmfffeeffffffeefffmsoo....',
  '..oeeolmfffeeffffffeefffmsomo...',
  '..oeeolmfffeeffffffeefffmsomo...',
  '..oaaolmfffffffaafffffffmsoo....',
  '...ooolmmffffffffffffffmmso.....',
  '......ommmmmmmmmmmmmmmmmmo......',
  '.......osssssssssssssssso.......',
  '........oooooooooooooooo........',
  '.............ommmmo.............',
  '.............oooooo.............',
  '.........oooooooooooooo.........',
  '........ollllllllllllllo........',
  '...oo..olmmmmmmmmmmmmmmmo..oo...',
  '..olmoolmmmmffffffffmmmmsoomso..',
  '..olmoolmmmffffffffffmmmsoomso..',
  '..olmoolmmmffwefsssffmmmsoomso..',
  '..olmoolmmmffeeffffffmmmsoomso..',
  '..olmoolmmmfffffsssffmmmsoomso..',
  '..olmoolmmmmffffffffmmmmsoomso..',
  '..olmoolmmmmmmmmmmmmmmmmsoomso..',
  '..olmoolmmmmmmmmmmmmmmmmsoomso..',
];
const FILL: Record<string, string> = {
  o: '#5c534a', // outline
  s: '#4a433b', // shadow
  m: '#a39787', // metal
  l: 'var(--t-fg)', // lit edge
  f: '#2a2622', // visor and panel
  e: 'var(--t-accent)',
  a: '#a8722f', // the accent, darker
  w: 'var(--t-fg)', // glint
};
const runs = GRID.flatMap((row, y) => [...row.matchAll(/([^.])\1*/g)].map((m) => ({ x: m.index!, y, w: m[0].length, c: FILL[m[1]] })));
---

<svg class="t-bot" viewBox={`0 0 ${GRID[0].length} ${GRID.length}`} shape-rendering="crispEdges" aria-hidden="true" focusable="false">
  {runs.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" style={`fill:${r.c}`} />)}
</svg>
