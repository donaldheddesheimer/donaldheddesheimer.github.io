---
// Link-analysis graph plus its inspector. Renders two sibling panels; the parent grid places them.
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { buildGraph, layout, type GNode, type NodeType } from '../lib/graph';

interface Props {
  graphClass?: string;
  inspectorClass?: string;
}
const { graphClass, inspectorClass } = Astro.props;

const projects = await getCollection('projects');
const g = buildGraph(projects);
// Three layouts; CSS container queries show whichever best matches the panel's shape.
const variants = [
  { key: 'w', w: 1000, h: 600, fs: 11, nodes: layout(g, { width: 1000, height: 600, pad: 40 }) },
  { key: 's', w: 760, h: 700, fs: 11, nodes: layout(g, { width: 760, height: 700, pad: 38 }) },
  { key: 't', w: 440, h: 700, fs: 12, nodes: layout(g, { width: 440, height: 700, pad: 30, labelScale: 1.1 }) },
];

const typeName: Record<NodeType, string> = { person: 'Person', org: 'Organization', project: 'Project', skill: 'Capability' };
const glyph: Record<Exclude<NodeType, 'skill'>, string> = {
  person: '',
  org: 'M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M16 9h2a2 2 0 0 1 2 2v10M2 21h20M8 7h4M8 11h4M8 15h4',
  project: 'm21 7.5-9-5-9 5v9l9 5 9-5zm-18 0 9 5 9-5M12 12.5V21.5',
};
const legend: { type: NodeType; label: string }[] = [
  { type: 'org', label: 'Orgs' },
  { type: 'project', label: 'Projects' },
  { type: 'skill', label: 'Capabilities' },
];
const byId = (nodes: GNode[]) => new Map(nodes.map((n) => [n.id, n] as const));
const ME = 'person:me';
---

<section class:list={['panel flex min-w-0 flex-col', graphClass]} aria-label="Entity graph">
  <header class="panel-head flex-wrap">
    <Icon name="graph" class="size-4 text-dim" />
    <h2 class="panel-title">Link analysis</h2>
    <span class="code-chip">{g.nodes.length} OBJ · {g.edges.length} LNK</span>
    <div class="ml-auto flex items-center gap-1" data-legend>
      {
        legend.map((l) => (
          <button type="button" class="legend-btn" data-toggle={l.type} aria-pressed="true">
            <span class={`dot t-${l.type}`} />
            {l.label}
          </button>
        ))
      }
      <button type="button" class="btn btn-ghost btn-icon ml-1" data-reset aria-label="Reset selection" title="Reset">
        <Icon name="reset" class="size-4" />
      </button>
    </div>
  </header>
  <div class="relative min-h-[560px] flex-1 md:min-h-[520px]">
    <div class="stage gridfield absolute inset-0" data-graph>
      {
        variants.map((v) => {
          const pos = byId(v.nodes);
          return (
            <svg viewBox={`0 0 ${v.w} ${v.h}`} class={`v-${v.key} select-none`} style={`--fs:${v.fs}px`} role="group" aria-label="Graph of organizations, projects, and capabilities">
              <g>
                {g.edges.map((e) => {
                  const s = pos.get(e.source)!;
                  const t = pos.get(e.target)!;
                  return <line class:list={['ge', e.weak && 'weak']} data-s={e.source} data-t={e.target} data-types={`${s.type} ${t.type}`} x1={s.x} y1={s.y} x2={t.x} y2={t.y} />;
                })}
              </g>
              <g>
                {v.nodes.map((n) => (
                  <g class={`gn t-${n.type}`} data-id={n.id} data-type={n.type} transform={`translate(${n.x} ${n.y})`} tabindex="0" role="button" aria-label={`${typeName[n.type]}: ${n.label}`}>
                    {n.type === 'person' && <circle class="pulse" r={n.r} />}
                    <circle class="halo" r={n.r + 5} />
                    <circle class="body" r={n.r} />
                    {n.type === 'person' && (
                      <text class="initials" dy="0.35em">
                        DH
                      </text>
                    )}
                    {(n.type === 'org' || n.type === 'project') && (
                      <path class="glyph" d={glyph[n.type]} transform={`translate(${-n.r * 0.55} ${-n.r * 0.55}) scale(${(n.r * 1.1) / 24})`} />
                    )}
                    {n.status === 'active' && <circle class="live" cx={n.r * 0.72} cy={-n.r * 0.72} r="3" />}
                    <text class="lbl" y={n.r + (n.type === 'skill' ? 11 : 14)}>
                      {n.label}
                    </text>
                  </g>
                ))}
              </g>
            </svg>
          );
        })
      }
      <p class="pointer-events-none absolute bottom-2 left-3 readout text-[10px] text-faint">
        <span class="hidden md:inline">HOVER TO TRACE · </span>CLICK TO INSPECT · CLICK A PROJECT AGAIN TO OPEN IT
      </p>
    </div>
  </div>
</section>

<aside class:list={['panel flex min-w-0 flex-col', inspectorClass]} aria-label="Inspector" aria-live="polite">
  <header class="panel-head">
    <Icon name="search" class="size-4 text-dim" />
    <h2 class="panel-title">Inspector</h2>
  </header>
  <div class="min-h-0 flex-1 overflow-y-auto">
    {
      Object.entries(g.details).map(([id, d]) => {
        const type = id.split(':')[0] as NodeType;
        return (
          <div data-detail={id} hidden={id !== ME} class="p-4">
            <div class="flex items-center gap-2">
              <span class={`dot t-${type}`} />
              <span class="kicker">{d.kind}</span>
              {d.code && <span class="code-chip ml-auto">{d.code}</span>}
            </div>
            <h3 class="mt-2 text-[17px] leading-snug font-semibold">{d.title}</h3>
            {d.summary && <p class="mt-1.5 text-[13px] leading-relaxed text-muted">{d.summary}</p>}
            {d.props.length > 0 && (
              <dl class="kv mt-4 border-t border-line pt-3 text-[12.5px]">
                {d.props.map(([k, v]) => (
                  <>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </>
                ))}
              </dl>
            )}
            {d.href && (
              <a href={d.href} class="btn btn-primary mt-4 w-full">
                {d.hrefLabel}
                <Icon name="arrow-right" class="size-4" />
              </a>
            )}
            <div class="mt-5 flex items-center justify-between">
              <span class="kicker">Linked objects</span>
              <span class="readout text-[11px]">{d.links.length}</span>
            </div>
            <ul class="mt-2 divide-y divide-line border-y border-line">
              {d.links.map((l) => (
                <li>
                  <button type="button" data-select={l.id} class="flex w-full items-center gap-2.5 px-1 py-1.5 text-left text-[13px] hover:bg-panel-2">
                    <span class={`dot t-${l.type}`} />
                    <span class="min-w-0 flex-1 truncate">{l.label}</span>
                    <span class="kicker text-[9.5px]">{typeName[l.type]}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </div>
</aside>

<script>
  const root = document.querySelector<HTMLElement>('[data-graph]');
  if (root) {
    const svgs = [...root.querySelectorAll('svg')];
    const details = [...document.querySelectorAll<HTMLElement>('[data-detail]')];
    const ME = 'person:me';

    // Adjacency from the first SVG's edges.
    const adj = new Map<string, Set<string>>();
    svgs[0].querySelectorAll<SVGLineElement>('.ge').forEach((l) => {
      const { s, t } = l.dataset as { s: string; t: string };
      if (!adj.has(s)) adj.set(s, new Set());
      if (!adj.has(t)) adj.set(t, new Set());
      adj.get(s)!.add(t);
      adj.get(t)!.add(s);
    });

    let selected: string | null = null;

    function focus(id: string | null) {
      for (const svg of svgs) {
        svg.classList.toggle('focus', !!id);
        svg.querySelectorAll<SVGGElement>('.gn').forEach((n) => {
          const nid = n.dataset.id!;
          n.classList.toggle('on', !!id && (nid === id || adj.get(id)!.has(nid)));
          n.classList.toggle('sel', nid === selected);
        });
        svg.querySelectorAll<SVGLineElement>('.ge').forEach((l) => {
          l.classList.toggle('on', !!id && (l.dataset.s === id || l.dataset.t === id));
        });
      }
    }

    function select(id: string | null) {
      selected = id;
      const show = id ?? ME;
      details.forEach((d) => (d.hidden = d.dataset.detail !== show));
      focus(id);
    }

    function activate(id: string) {
      if (id === selected && id.startsWith('project:')) {
        const link = document.querySelector<HTMLAnchorElement>(`[data-detail="${CSS.escape(id)}"] a.btn`);
        if (link) location.href = link.href;
        return;
      }
      select(id);
    }

    root.addEventListener('click', (e) => {
      const n = (e.target as Element).closest<SVGGElement>('.gn');
      if (n) activate(n.dataset.id!);
      else select(null);
    });
    root.addEventListener('keydown', (e) => {
      const n = (e.target as Element).closest<SVGGElement>('.gn');
      if (n && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        activate(n.dataset.id!);
      }
    });
    root.addEventListener('pointerover', (e) => {
      const n = (e.target as Element).closest<SVGGElement>('.gn');
      if (n && e.pointerType === 'mouse') focus(n.dataset.id!);
    });
    root.addEventListener('pointerout', (e) => {
      const n = (e.target as Element).closest<SVGGElement>('.gn');
      if (n && e.pointerType === 'mouse') focus(selected);
    });

    document.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-select]');
      if (b) select(b.dataset.select!);
    });
    document.querySelector('[data-reset]')?.addEventListener('click', () => select(null));

    document.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((b) =>
      b.addEventListener('click', () => {
        const on = b.getAttribute('aria-pressed') !== 'true';
        b.setAttribute('aria-pressed', String(on));
        root.classList.toggle(`hide-${b.dataset.toggle}`, !on);
      }),
    );
  }
</script>

<style>
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--c);
    flex-shrink: 0;
  }
  .t-person {
    --c: var(--blue);
  }
  .t-org {
    --c: var(--orange);
  }
  .t-project {
    --c: var(--turquoise);
  }
  .t-skill {
    --c: var(--violet);
  }

  .legend-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 1.625rem;
    padding: 0 0.5rem;
    border-radius: 3px;
    font-size: 12px;
    color: var(--muted);
  }
  .legend-btn:hover {
    background: var(--panel-3);
  }
  .legend-btn[aria-pressed='false'] {
    color: var(--faint);
    text-decoration: line-through;
  }
  .legend-btn[aria-pressed='false'] .dot {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--c);
  }

  /* The stage is absolutely sized (flex-stretched heights read as unknown to container queries),
     so the SVG can fill it and the query can pick the layout that fits its shape. */
  .stage {
    container-type: size;
  }
  .stage svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }
  @container (aspect-ratio >= 27/20) {
    .stage .v-w {
      display: block;
    }
  }
  @container (17/20 <= aspect-ratio < 27/20) {
    .stage .v-s {
      display: block;
    }
  }
  @container (aspect-ratio < 17/20) {
    .stage .v-t {
      display: block;
    }
  }

  .ge {
    stroke: #4a5361;
    stroke-width: 1;
    transition: opacity 0.15s;
  }
  .ge.weak {
    stroke-dasharray: 3 3;
  }
  .gn {
    cursor: pointer;
    outline: none;
    transition: opacity 0.15s;
  }
  .gn .body {
    fill: var(--panel);
    stroke: var(--c);
    stroke-width: 1.5;
  }
  .gn.t-person .body {
    fill: var(--blue-2);
    stroke: var(--blue-3);
  }
  .gn.t-skill .body {
    fill: color-mix(in srgb, var(--violet) 35%, var(--panel));
  }
  .gn .halo {
    fill: none;
    stroke: var(--c);
    stroke-width: 1;
    stroke-opacity: 0;
    transition: stroke-opacity 0.15s;
  }
  .gn:hover .halo,
  .gn:focus-visible .halo {
    stroke-opacity: 0.55;
  }
  .gn.sel .halo {
    stroke-opacity: 1;
    stroke-width: 1.5;
    stroke-dasharray: 3 2;
  }
  .gn .glyph {
    fill: none;
    stroke: var(--c);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .gn .pulse {
    fill: none;
    stroke: none;
  }
  .gn .initials {
    fill: #fff;
    font-size: 12px;
    font-weight: 700;
    text-anchor: middle;
    letter-spacing: 0.03em;
  }
  .gn .live {
    fill: var(--green);
    stroke: var(--panel);
    stroke-width: 1.5;
  }
  .gn .lbl {
    font-size: var(--fs);
    fill: #c5cbd3;
    text-anchor: middle;
    paint-order: stroke;
    stroke: #13171c;
    stroke-width: 3.5px;
    stroke-linejoin: round;
    pointer-events: none;
  }
  .gn.t-person .lbl {
    font-weight: 600;
    fill: var(--text);
  }
  .gn.t-org .lbl {
    fill: #e5c79f;
  }
  .gn.t-skill .lbl {
    font-size: calc(var(--fs) - 1px);
    fill: var(--dim);
  }

  svg.focus .gn:not(.on) {
    opacity: 0.16;
  }
  svg.focus .ge:not(.on) {
    opacity: 0.06;
  }
  svg.focus .ge.on {
    stroke: var(--blue-3);
    stroke-width: 1.4;
    stroke-dasharray: 4 3;
  }
  svg.focus .gn.on .lbl {
    fill: var(--text);
  }

  .hide-org :is(.gn.t-org, .ge[data-types~='org']),
  .hide-project :is(.gn.t-project, .ge[data-types~='project']),
  .hide-skill :is(.gn.t-skill, .ge[data-types~='skill']) {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    svg.focus .ge.on {
      animation: flow 0.9s linear infinite;
    }
    .gn .pulse {
      fill: none;
      stroke: var(--blue);
      transform-box: fill-box;
      transform-origin: center;
      animation: pulse 3s ease-out infinite;
    }
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -7;
    }
  }
  @keyframes pulse {
    from {
      transform: scale(1);
      stroke-opacity: 0.7;
    }
    to {
      transform: scale(2.4);
      stroke-opacity: 0;
    }
  }
</style>
