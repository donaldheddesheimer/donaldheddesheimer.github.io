---
// The lab computer's screen: one page of the portfolio (Work, a case study, About, Résumé or Contact) as
// the monitor on the homepage shows it, in the frame src/scripts/lab/computer.ts lays over the screen.
// The content is the site's own (src/components/Folio*.astro, CaseStudy.astro); this layout gives it the
// computer's one slim bar.
//
// The lab owns the address (/?computer=<path>) and the history; this page never navigates itself. A
// plain click on a link to another page the computer has asks the lab to go there (pc:go); a modified
// click opens that page's own address in a new tab. Links the computer has no page for open in a new
// tab, so the lab stays; downloads and mail links do what they do. "Leave computer" and Escape ask the
// lab to close (pc:leave, pc:escape); "Open ordinary page" leaves the lab for the page with the same
// content. These pages are the frame's, not addresses of their own (noindex, canonical to the ordinary
// page): opened on their own (a copied frame address), each goes to the lab reading it, or to its
// ordinary page in a window the lab doesn't open in.
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { profile } from '../data/site';
import { labHref, ordinaryHref } from '../scripts/lab/routes';

interface Props {
  title: string;
  /** This page's computer path (routes.ts). */
  path: string;
}
const { title, path } = Astro.props;
const page = ordinaryHref(path);
const lab = labHref(path);
const section = path.split('/')[0];
const nav = [
  ['work', 'Work'],
  ['about', 'About'],
  ['resume', 'Résumé'],
  ['contact', 'Contact'],
] as const;
---

<!doctype html>
<html lang="en" data-embed data-screen>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(page, Astro.site).href} />
    <base target="_top" />
    <script is:inline define:vars={{ page, lab }}>
      if (window.top === window.self) {
        var roomy = matchMedia('(width >= 64rem) and (height >= 36rem) and (min-aspect-ratio: 3/2)').matches;
        location.replace(roomy ? lab : page);
      }
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        var saved = null;
        try {
          saved = localStorage.getItem('motion');
        } catch (e) {}
        h.dataset.motion = saved || (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'off' : 'on');
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body data-path={path}>
    <header class="scr-bar">
      <a href={labHref('work')} class="scr-home" aria-label={`${profile.name}, work`}>
        <Mark class="size-5 shrink-0" />
        <span class="scr-name">{profile.name}</span>
      </a>
      <nav class="scr-nav" aria-label="Portfolio">
        {
          nav.map(([id, label]) => (
            <a href={labHref(id)} aria-current={path === id ? 'page' : section === id ? 'true' : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
      <div class="scr-end">
        <a href={page} class="scr-quiet" data-top>Open ordinary page</a>
        <button type="button" class="scr-leave" data-leave aria-label="Leave computer">Leave<span class="scr-more">&nbsp;computer</span></button>
      </div>
    </header>
    <main id="main" class="scr-main">
      <slot />
    </main>

    <script>
      import { pathOf } from '../scripts/lab/routes';

      const html = document.documentElement;
      const here = document.body.dataset.path!;
      const post = (msg: object) => parent !== window && parent.postMessage(msg, location.origin);

      const smooth = () => html.dataset.motion !== 'off' && !matchMedia('(prefers-reduced-motion: reduce)').matches;
      function scrollToHash(hash: string) {
        const el = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
        if (el instanceof HTMLDetailsElement) el.open = true;
        if (el) el.scrollIntoView({ block: 'start', behavior: smooth() ? 'smooth' : 'auto' });
        else scrollTo({ top: 0, behavior: smooth() ? 'smooth' : 'auto' });
      }

      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0) return;
        const a = (e.target as Element).closest<HTMLAnchorElement>('a[href]');
        if (!a || a.hasAttribute('download') || a.hasAttribute('data-top') || a.target === '_blank') return;
        const u = new URL(a.href);
        if (u.protocol !== 'https:' && u.protocol !== 'http:') return; // mail links
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // the link's own address, in a new tab or window
        e.preventDefault();
        const to = pathOf(u, location.origin);
        if (!to) window.open(u.href, '_blank', 'noopener');
        else if (to === here) scrollToHash(u.hash);
        else post({ type: 'pc:go', path: to, hash: u.hash });
      });
      document.querySelector('[data-leave]')?.addEventListener('click', () => post({ type: 'pc:leave' }));

      // Tell the lab which page this is, and pass Escape up to it unless something here is using it.
      post({ type: 'pc:page', path: here, title: document.title });
      addEventListener(
        'keydown',
        (e) => {
          if (e.key !== 'Escape' || e.defaultPrevented || document.querySelector('dialog[open]')) return;
          post({ type: 'pc:escape' });
        },
        true,
      );
      if (location.hash) requestAnimationFrame(() => scrollToHash(location.hash));
    </script>

    <style>
      /* The computer's own bar: whose it is, its four places, and the way out. */
      .scr-bar {
        position: sticky;
        top: 0;
        z-index: 40;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        height: 2.75rem;
        padding: 0 var(--home-edge);
        border-bottom: 1px solid var(--line);
        background: rgb(19 18 17 / 0.94);
        backdrop-filter: blur(8px);
        font-size: var(--text-sm);
      }
      .scr-home {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 2rem;
        font-weight: 600;
        color: var(--text);
        white-space: nowrap;
      }
      .scr-nav {
        display: flex;
        gap: 0.125rem;
        margin-left: auto;
      }
      .scr-nav a,
      .scr-end > * {
        display: inline-flex;
        align-items: center;
        min-height: 2rem;
        padding: 0 0.625rem;
        border-radius: var(--radius-2);
        white-space: nowrap;
      }
      .scr-nav a {
        color: var(--muted);
      }
      .scr-nav a:hover,
      .scr-end > *:hover {
        color: var(--text);
        background: var(--hover-bg);
      }
      .scr-nav a[aria-current] {
        color: var(--text);
        box-shadow: inset 0 -2px 0 var(--text);
        border-radius: 0;
      }
      .scr-end {
        display: flex;
        gap: 0.25rem;
        margin-left: 0.75rem;
        padding-left: 0.75rem;
        border-left: 1px solid var(--line);
      }
      .scr-quiet {
        color: var(--dim);
      }
      .scr-leave {
        color: var(--muted);
      }
      /* A narrow screen: the name goes first, then the ordinary page's link, and the rest closes up. The
         places scroll inside the bar before the bar would push "Leave" out of the window. */
      @media (width < 56rem) {
        .scr-name {
          display: none;
        }
      }
      @media (width < 44rem) {
        .scr-bar {
          gap: 0.5rem;
        }
        .scr-nav {
          min-width: 0;
          overflow-x: auto;
          scrollbar-width: none;
        }
        .scr-nav a,
        .scr-end > * {
          padding: 0 0.4375rem;
        }
        .scr-end {
          flex-shrink: 0;
          margin-left: 0;
          padding-left: 0.375rem;
        }
        .scr-end > .scr-quiet,
        .scr-more {
          display: none;
        }
      }
      @media (width < 24rem) {
        .scr-nav a,
        .scr-end > * {
          padding: 0 0.3125rem;
        }
      }
      .scr-main {
        --cs-under: 2.75rem;
        padding-bottom: 2rem;
      }
      /* A screen is narrower than the windows the page's edge is set for; anchors land under the bar. */
      :global(html[data-screen]) {
        --home-inset: clamp(1.25rem, 4vw, 2.5rem);
        scroll-padding-top: 3.5rem;
      }
      :global(html[data-screen] .folio) {
        padding-top: clamp(2rem, 5vw, 3.5rem);
      }
    </style>
  </body>
</html>
