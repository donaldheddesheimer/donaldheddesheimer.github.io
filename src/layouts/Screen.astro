---
// A project's case study (CaseStudy.astro), and the site's few other pages (the 404), under one slim
// bar: the name (to the lab, /) and the terminal's commands (its page's anchors, /computer/#work, which
// open the lab running them).
import Base from './Base.astro';
import Mark from '../components/Mark.astro';
import { profile } from '../data/site';
import { COMMANDS, pageHref } from '../scripts/lab/routes';

interface Props {
  title: string;
  /** Which of the terminal's commands the page belongs to, if any. */
  section?: string;
  description?: string;
  /** Its canonical address, or false for none (the 404). */
  canonical?: string | false;
  noindex?: boolean;
}
const { title, section, description, canonical, noindex } = Astro.props;
const labels: Record<string, string> = { about: 'About', work: 'Work', resume: 'Résumé', contact: 'Contact' };
const nav = (['work', ...COMMANDS.filter((c) => c !== 'work')] as string[]).map((id) => [id, labels[id]] as const);
---

<Base title={title} description={description} canonical={canonical} noindex={noindex} screen>
  <div class="scr">
    <header class="scr-bar">
      <a href="/" class="scr-home" aria-label={`${profile.name}, the lab`}>
        <Mark class="size-5 shrink-0" />
        <span class="scr-name">{profile.name}</span>
      </a>
      <nav class="scr-nav" aria-label="Portfolio">
        {
          nav.map(([id, label]) => (
            <a href={pageHref(id)} aria-current={section === id ? 'true' : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main" class="scr-main">
      <slot />
    </main>
  </div>
</Base>

<script>
  const html = document.documentElement;
  const smooth = () => html.dataset.motion !== 'off' && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  function scrollToHash(hash: string) {
    const el = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
    if (el instanceof HTMLDetailsElement) el.open = true;
    if (el) el.scrollIntoView({ block: 'start', behavior: smooth() ? 'smooth' : 'auto' });
    else scrollTo({ top: 0, behavior: smooth() ? 'smooth' : 'auto' });
  }

  if (location.hash) requestAnimationFrame(() => scrollToHash(location.hash));
</script>

<style>
  /* The bar: the name and the terminal's commands, the window's safe area (a phone's notch and home
     bar) kept clear. */
  .scr-bar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: env(safe-area-inset-top) max(var(--home-edge), env(safe-area-inset-right)) 0 max(var(--home-edge), env(safe-area-inset-left));
    border-bottom: 1px solid var(--line);
    background: rgb(19 18 17 / 0.94);
    backdrop-filter: blur(8px);
    font-size: var(--text-sm);
  }
  .scr-home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }
  .scr-nav {
    display: flex;
    gap: 0.125rem;
    margin-left: auto;
  }
  .scr-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.625rem;
    border-radius: var(--radius-2);
    white-space: nowrap;
  }
  .scr-nav a {
    color: var(--muted);
  }
  .scr-nav a:hover {
    color: var(--text);
    background: var(--hover-bg);
  }
  .scr-nav a[aria-current] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--text);
    border-radius: 0;
  }
  @media (pointer: coarse) {
    .scr-home,
    .scr-nav a {
      min-height: var(--h-touch);
    }
  }
  /* A narrow screen: the name goes first, and the rest closes up, the places scrolling inside the bar. */
  @media (width < 44rem) {
    .scr-name {
      display: none;
    }
    .scr-bar {
      gap: 0.5rem;
    }
    .scr-nav {
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .scr-nav a {
      padding: 0 0.4375rem;
    }
  }
  @media (width < 24rem) {
    .scr-nav a {
      padding: 0 0.3125rem;
    }
  }
  .scr-main {
    --cs-under: 2.75rem;
    padding: 0 env(safe-area-inset-right) calc(2rem + env(safe-area-inset-bottom)) env(safe-area-inset-left);
  }
  /* A screen is narrower than the windows the page's edge is set for; anchors land under the bar. */
  :global(html[data-screen]) {
    --home-inset: clamp(1.25rem, 4vw, 2.5rem);
    scroll-padding-top: 3.5rem;
    scroll-padding-bottom: 1rem;
  }
</style>
