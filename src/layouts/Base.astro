---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title = profile.name, description = profile.tagline } = Astro.props;

const nav = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#hobbies', label: 'Hobbies' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <script is:inline>
      // Set theme before paint to avoid a flash.
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <header class="sticky top-3 z-50 px-4">
      <nav
        class="mx-auto flex max-w-6xl items-center justify-between gap-2 rounded-full border border-line bg-surface/80 px-2 py-2 pl-3 backdrop-blur-md"
      >
        <a href="#top" class="font-display text-lg font-extrabold tracking-tight">
          <span class="inline-grid size-9 place-items-center rounded-full bg-accent text-sm text-accent-ink">DH</span>
        </a>
        <ul class="hidden items-center gap-1 text-sm sm:flex">
          {nav.map((n) => (
            <li>
              <a href={n.href} class="rounded-full px-3 py-2 text-muted transition hover:bg-surface-2 hover:text-ink">
                {n.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="flex items-center gap-1">
          <a
            href={profile.resume}
            class="rounded-full bg-ink px-4 py-2 text-sm font-semibold text-bg transition hover:opacity-85"
          >
            Resume
          </a>
          <button
            id="theme-toggle"
            type="button"
            class="grid size-9 place-items-center rounded-full text-muted transition hover:bg-surface-2 hover:text-ink"
            aria-label="Toggle dark mode"
          >
            <span class="dark:hidden"><Icon name="moon" class="size-4" /></span>
            <span class="hidden dark:inline"><Icon name="sun" class="size-4" /></span>
          </button>
        </div>
      </nav>
    </header>

    <main id="top" class="mx-auto max-w-6xl px-4 pt-8 pb-16 sm:pt-12">
      <slot />
    </main>

    <footer class="mx-auto max-w-6xl px-4 pb-10 text-sm text-muted">
      <div class="flex flex-wrap items-center justify-between gap-2 border-t border-line pt-6">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <p class="font-mono text-xs">Built with Astro + Tailwind</p>
      </div>
    </footer>

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
