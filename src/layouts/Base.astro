---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Icon, { type IconName } from '../components/Icon.astro';
import NewTab from '../components/NewTab.astro';
import Mark from '../components/Mark.astro';
import { profile, socials } from '../data/site';
import { build } from '../lib/build';

interface Props {
  title?: string;
  description?: string;
  /** The homepage (the lab): its header links to the sections on the page itself. */
  home?: boolean;
  /** A page of its own under the same header (a project case study, the 404): the name always shows. */
  story?: boolean;
  /** The section this page belongs to, marked current in the header and tab bar. */
  section?: string;
  /** False for a page with no address of its own (the 404), which gets no canonical link. */
  canonical?: boolean;
  /** Kept out of search results. */
  noindex?: boolean;
}
const { title = profile.name, description = profile.tagline, home = false, story = false, section, canonical = true, noindex = false } = Astro.props;
// Absolute URLs for link previews. public/og.jpg is a render of the homepage's opening (see src/data/site.ts).
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;

const base = home ? '' : '/';
// The homepage's sections: in the header (all but Home) and the phone tab bar (all five).
const nav: { id: string; label: string; icon: IconName }[] = [
  { id: 'top', label: 'Home', icon: 'home' },
  { id: 'work', label: 'Work', icon: 'star' },
  { id: 'about', label: 'About', icon: 'briefcase' },
  { id: 'resume', label: 'Résumé', icon: 'file' },
  { id: 'contact', label: 'Contact', icon: 'radio' },
];
const sourceHref = 'https://github.com/donaldheddesheimer/donaldheddesheimer.github.io';

// Everything the ⌘K search can jump to: one row per object, under the group it lists in. `terms` is
// extra text that matches but isn't shown.
const projects = (await getCollection('projects')).sort((a, b) => b.data.code.localeCompare(a.data.code));
const search = [
  ...nav.map((n) => ({ group: 'Sections', code: 'NAV', label: n.label, sub: '', href: `/#${n.id}` })),
  ...projects.map((p) => ({ group: 'Projects', code: 'PRJ', label: p.data.title, sub: p.data.tags.join(' · '), terms: `${p.data.summary} ${p.data.context ?? ''}`, href: `/projects/${p.id}/` })),
  { group: 'Links', code: 'PDF', label: 'Resume', sub: 'Download PDF', href: profile.resume },
  ...socials.map((s) => ({ group: 'Links', code: 'EXT', label: s.label, sub: s.handle, href: s.href })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#131211" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    {canonical && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}: ${profile.headline}. His name over a robotics lab after hours, three robots dancing beside a desk with a computer.`} />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={pageUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Before first paint: note that JS runs, and apply the saved Motion setting (off by default
      // for people who've asked their OS for reduced motion).
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        var saved = null;
        try {
          saved = localStorage.getItem('motion');
        } catch (e) {}
        h.dataset.motion = saved || (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'off' : 'on');
      })();
    </script>
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 btn btn-primary">Skip to content</a>

    <header class:list={['home-bar', story && 'home-bar-story']} data-home-bar>
      <a href={home ? '#top' : base} class="home-mark" aria-label={home ? `${profile.name}, back to top` : `${profile.name}, home`}>
        <Mark class="size-7 shrink-0" />
        <span class="home-mark-name">{profile.name}</span>
      </a>
      <nav aria-label="Sections" class="home-nav">
        {
          nav.slice(1).map((n) => (
            <a href={`${base}#${n.id}`} aria-current={section === n.id ? 'true' : undefined}>
              {n.label}
            </a>
          ))
        }
      </nav>
      <!-- Settings: the Motion switch, out of the way until asked for (the footer has it too). -->
      <div class="home-bar-end settings" data-settings>
        <button type="button" class="btn btn-ghost btn-icon settings-btn" aria-expanded="false" aria-controls="settings" aria-label="Settings" title="Settings" data-settings-toggle>
          <Icon name="sliders" class="size-4" />
        </button>
        <div id="settings" class="settings-pop" role="group" aria-label="Settings" hidden>
          <button type="button" role="switch" aria-checked="true" class="motion-switch" data-motion-toggle aria-describedby="settings-motion-note">
            Motion <span class="sw" aria-hidden="true" />
          </button>
          <p id="settings-motion-note" class="settings-note">The lab's robots and camera, and the page's transitions. It starts off if your system asks for reduced motion, and the robots and camera then stay still.</p>
        </div>
      </div>
    </header>

    <!-- Phones have no header links beyond the mark, so the tab bar carries them; the footer closes the page. -->
    <main id="main" class:list={story ? 'home-main story-main' : 'home-main'}>
      <slot />
      <footer class="home-foot readout">
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <button type="button" role="switch" aria-checked="true" class="motion-switch" data-motion-toggle title="Turn animation on or off">
          Motion <span class="sw" aria-hidden="true" />
        </button>
        {
          build && (
            <span>
              BUILD <span class="text-muted">{build.sha} {build.date}</span>
            </span>
          )
        }
        <a href={sourceHref} target="_blank" rel="noopener">
          Source
          <NewTab class="size-3 shrink-0" />
        </a>
      </footer>
    </main>

    <!-- Bottom bar (phones, every page). After main in the source, so it lands at the page end when it stops being fixed. -->
    <nav aria-label="Sections" class="tabbar fixed inset-x-0 bottom-0 z-40 grid h-14 grid-cols-5 border-t border-line bg-panel pb-[env(safe-area-inset-bottom)] md:hidden">
      {
        nav.map((n) => (
          <a
            href={`${base}#${n.id}`}
            data-spy={n.id}
            class="tab-btn relative flex flex-col items-center justify-center gap-1 text-2xs text-dim"
            aria-current={n.id === section ? 'true' : undefined}
          >
            <Icon name={n.icon} class="size-[18px]" />
            {n.label}
          </a>
        ))
      }
    </nav>

    <!-- ⌘K search -->
    <dialog id="cmdk" class="m-auto mt-[12vh] w-[min(640px,calc(100%-2rem))] rounded-2 border border-line-2 bg-panel p-0 text-text shadow-elev-3 backdrop:bg-black/60" aria-label="Search">
      <div class="flex items-center gap-2 border-b border-line px-3">
        <Icon name="search" class="size-4 text-dim" />
        <input
          id="cmdk-input"
          type="text"
          role="combobox"
          aria-expanded="true"
          aria-controls="cmdk-list"
          aria-autocomplete="list"
          aria-label="Search"
          placeholder="Search projects, sections…"
          autocomplete="off"
          spellcheck="false"
          class="h-12 flex-1 bg-transparent text-md outline-none placeholder:text-dim"
        />
        <kbd class="code-chip">ESC</kbd>
      </div>
      <div id="cmdk-list" role="listbox" aria-label="Search results" class="max-h-[55vh] overflow-y-auto pb-1"></div>
      <p id="cmdk-empty" class="px-3 py-6 text-center text-dim" hidden>Nothing matches that query.</p>
      <div class="flex gap-4 border-t border-line px-3 py-2 readout text-2xs text-dim">
        <span class="pointer-coarse:hidden">↑↓ move · ↵ open · esc close · / also opens</span><span class="ml-auto" id="cmdk-count" role="status"></span>
      </div>
    </dialog>
    <script type="application/json" id="cmdk-data" set:html={JSON.stringify(search).replace(/</g, '\\u003c')} />

    <script>
      // Scroll-spy for the tab bar, on the page that has the sections.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
      const sections = links
        .map((a) => document.getElementById(a.dataset.spy!))
        .filter((el): el is HTMLElement => !!el)
        .sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1));
      if (sections.length) {
        // The last section is too short to cross the middle band, so it wins at the bottom of the page.
        let current = sections[0].id;
        const mark = () => {
          const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
          const id = atBottom ? sections[sections.length - 1].id : current;
          links.forEach((a) => (a.dataset.spy === id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
        };
        const spy = new IntersectionObserver(
          (entries) => {
            for (const e of entries) if (e.isIntersecting) current = e.target.id;
            mark();
          },
          { rootMargin: '-40% 0px -55% 0px' },
        );
        sections.forEach((s) => spy.observe(s));
        addEventListener('scroll', mark, { passive: true });
      }

      // ⌘K search.
      type Item = { group: string; code: string; label: string; sub: string; terms?: string; href: string };
      const dialog = document.getElementById('cmdk') as HTMLDialogElement;
      const input = document.getElementById('cmdk-input') as HTMLInputElement;
      const list = document.getElementById('cmdk-list')!;
      const empty = document.getElementById('cmdk-empty')!;
      const count = document.getElementById('cmdk-count')!;
      const items: Item[] = JSON.parse(document.getElementById('cmdk-data')!.textContent!);
      const CAP = 5; // rows per group
      let shown: Item[] = [];
      let active = 0;
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

      // Rank: the title starts with the query, then a word in it does (camelCase humps count, so "nav"
      // finds RoboNav), then the code matches, then any other text (tags, summary).
      const atWord = (text: string, q: string) => {
        const t = text.replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase();
        for (let at = t.indexOf(q); at >= 0; at = t.indexOf(q, at + 1)) if (at === 0 || !/[a-z0-9]/.test(t[at - 1])) return true;
        return false;
      };
      const rank = (i: Item, q: string) =>
        i.label.toLowerCase().startsWith(q) ? 0
        : atWord(i.label, q) ? 1
        : i.code.toLowerCase().includes(q) ? 2
        : `${i.label} ${i.sub} ${i.group} ${i.terms ?? ''}`.toLowerCase().includes(q) ? 3
        : -1;

      function setActive(n: number) {
        list.querySelector('[aria-selected="true"]')?.setAttribute('aria-selected', 'false');
        active = n;
        const option = document.getElementById(`cmdk-opt-${n}`);
        option?.setAttribute('aria-selected', 'true');
        if (option) input.setAttribute('aria-activedescendant', option.id);
        else input.removeAttribute('aria-activedescendant');
        return option;
      }
      // Keyboard moves keep the active row in view, with its group's header when it's the first row.
      function reveal(option: HTMLElement | null) {
        if (!option) return;
        if (option.previousElementSibling?.getAttribute('role') === 'presentation') option.previousElementSibling.scrollIntoView({ block: 'nearest' });
        option.scrollIntoView({ block: 'nearest' });
      }

      function render() {
        const q = input.value.trim().toLowerCase();
        // Groups list in the order of their best match; with no query, in the data's order.
        const groups = new Map<string, Item[]>();
        items
          .map((item, n) => ({ item, r: q ? rank(item, q) : 0, n }))
          .filter((h) => h.r >= 0)
          .sort((a, b) => a.r - b.r || a.n - b.n)
          .forEach(({ item }) => groups.set(item.group, [...(groups.get(item.group) ?? []), item]));
        shown = [];
        // Each option is the activation target itself; group headers are presentational labels.
        list.innerHTML = [...groups]
          .map(
            ([name, all], g) => `<ul role="group" aria-labelledby="cmdk-g-${g}">
                <li role="presentation" id="cmdk-g-${g}" class="flex justify-between px-3 pt-2.5 pb-1 kicker">${esc(name)}${all.length > CAP ? `<span>${CAP} of ${all.length}</span>` : ''}</li>
                ${all
                  .slice(0, CAP)
                  .map((i) => {
                    const n = shown.push(i) - 1;
                    return `<li role="option" id="cmdk-opt-${n}" aria-selected="false" data-n="${n}" class="cmdk-opt flex cursor-pointer items-center gap-3 px-3 py-2 pointer-coarse:min-h-11">
                      <span class="code-chip w-20 justify-center max-sm:hidden">${esc(i.code)}</span>
                      <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2"><span class="text-text">${esc(i.label)}</span><span class="min-w-0 truncate text-dim">${esc(i.sub)}</span></span>
                    </li>`;
                  })
                  .join('')}
              </ul>`,
          )
          .join('');
        list.hidden = !shown.length;
        empty.hidden = !!shown.length;
        input.setAttribute('aria-expanded', String(!!shown.length));
        reveal(setActive(Math.min(active, Math.max(shown.length - 1, 0))));
        // The count is a live region: only touch it when it changes, so arrowing through results stays quiet.
        const total = `${shown.length} result${shown.length === 1 ? '' : 's'}`;
        if (count.textContent !== total) count.textContent = total;
      }
      function open() {
        input.value = '';
        active = 0;
        render();
        dialog.showModal();
        input.focus();
      }
      document.querySelectorAll('[data-cmdk-open]').forEach((b) => b.addEventListener('click', open));
      document.addEventListener('keydown', (e) => {
        const typing = e.target instanceof Element && e.target.closest('input, textarea');
        if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing && !dialog.open)) {
          e.preventDefault();
          dialog.open ? dialog.close() : open();
        }
      });
      input.addEventListener('input', () => {
        active = 0;
        render();
      });
      input.addEventListener('keydown', (e) => {
        if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && shown.length) {
          e.preventDefault();
          reveal(setActive((active + (e.key === 'ArrowDown' ? 1 : -1) + shown.length) % shown.length));
        } else if (e.key === 'Enter' && shown[active]) {
          e.preventDefault();
          dialog.close();
          go(shown[active]);
        }
      });
      // The pointer moves the active row too (without scrolling it), so hover and ↵ agree.
      list.addEventListener('pointermove', (e) => {
        const option = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
        if (option && Number(option.dataset.n) !== active) setActive(Number(option.dataset.n));
      });
      list.addEventListener('click', (e) => {
        const option = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
        const item = option && shown[Number(option.dataset.n)];
        if (!item) return;
        dialog.close();
        go(item);
      });
      // A link to the section already in the address scrolls back to it.
      function go(i: Item) {
        const url = new URL(i.href, location.href);
        if (url.hash && url.hash === location.hash && url.pathname === location.pathname && url.search === location.search) {
          document.getElementById(decodeURIComponent(url.hash.slice(1)))?.scrollIntoView();
          dispatchEvent(new HashChangeEvent('hashchange'));
        } else location.href = i.href;
      }
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });

      // Motion switches (the header's settings, and the footer).
      const motionBtns = document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]');
      const showMotion = () => {
        const on = document.documentElement.dataset.motion !== 'off';
        motionBtns.forEach((b) => b.setAttribute('aria-checked', String(on)));
      };
      showMotion();
      motionBtns.forEach((b) =>
        b.addEventListener('click', () => {
          const next = document.documentElement.dataset.motion === 'off' ? 'on' : 'off';
          document.documentElement.dataset.motion = next;
          try {
            localStorage.setItem('motion', next);
          } catch {}
          showMotion();
        }),
      );

      // Settings: a disclosure. It closes on Escape (focus back on its button), when focus leaves it,
      // and on a press anywhere else.
      const settings = document.querySelector<HTMLElement>('[data-settings]');
      const settingsBtn = settings?.querySelector<HTMLButtonElement>('[data-settings-toggle]');
      const settingsPop = settings?.querySelector<HTMLElement>('#settings');
      if (settings && settingsBtn && settingsPop) {
        const show = (open: boolean) => {
          settingsPop.hidden = !open;
          settingsBtn.setAttribute('aria-expanded', String(open));
        };
        settingsBtn.addEventListener('click', () => show(settingsPop.hidden));
        settings.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape' || settingsPop.hidden) return;
          e.preventDefault();
          show(false);
          settingsBtn.focus();
        });
        settings.addEventListener('focusout', (e) => {
          if (!settings.contains(e.relatedTarget as Node | null)) show(false);
        });
        document.addEventListener('pointerdown', (e) => {
          if (!settingsPop.hidden && !settings.contains(e.target as Node)) show(false);
        });
      }

      // Header: clear over the opening, solid once the page scrolls.
      const bar = document.querySelector<HTMLElement>('[data-home-bar]');
      if (bar) {
        const onScroll = () => bar.toggleAttribute('data-scrolled', scrollY > 24);
        onScroll();
        addEventListener('scroll', onScroll, { passive: true });
      }
    </script>

    <style>
      /* Tab bar (phones): the current section is marked with a bar along its top edge. */
      .tab-btn[aria-current] {
        color: var(--text);
      }
      .tab-btn[aria-current]::before {
        content: '';
        position: absolute;
        top: 0;
        left: 30%;
        right: 30%;
        height: 2px;
        background: var(--sel-bar);
      }

      /* Header: the mark and the section links over the opening, turning solid (with the name) once the
         page scrolls. */
      .home-bar {
        position: fixed;
        inset: 0 0 auto;
        z-index: 40;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        height: 3.5rem;
        padding: 0 1rem;
        background: linear-gradient(rgb(10 9 8 / 0.8), rgb(10 9 8 / 0));
        transition:
          background-color var(--dur-2) var(--ease),
          box-shadow var(--dur-2) var(--ease),
          opacity 250ms var(--ease);
      }
      .home-bar[data-scrolled] {
        background: rgb(19 18 17 / 0.92);
        box-shadow: 0 1px 0 var(--line);
        backdrop-filter: blur(10px);
      }
      .home-mark {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        min-height: var(--h-md);
        font-size: var(--text-sm);
        font-weight: 600;
      }
      .home-mark-name {
        opacity: 0;
        transition: opacity var(--dur-2) var(--ease);
      }
      .home-bar[data-scrolled] .home-mark-name,
      .home-bar-story .home-mark-name {
        opacity: 1;
      }
      .home-nav {
        display: none;
        gap: 0.25rem;
        font-size: var(--text-sm);
      }
      .home-nav a {
        display: inline-flex;
        align-items: center;
        min-height: var(--h-md);
        padding: 0 0.625rem;
        border-radius: var(--radius-2);
        color: var(--muted);
        white-space: nowrap;
      }
      .home-nav a:hover {
        color: var(--text);
        background: var(--hover-bg);
      }
      .home-nav a[aria-current] {
        color: var(--text);
      }
      .home-bar-end {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        margin-left: auto;
      }
      @media (min-width: 768px) {
        .home-bar {
          padding: 0 1.75rem;
        }
        .home-nav {
          display: flex;
          margin-left: auto;
        }
        .home-bar-end {
          margin-left: 0;
        }
      }
      /* The name needs room: it is left out on phones and while the section links share the bar with it. */
      @media (width < 30rem), (768px <= width < 64rem) {
        .home-mark-name {
          display: none;
        }
      }
      @media (pointer: coarse) {
        .home-mark,
        .home-nav a {
          min-height: var(--h-touch);
        }
      }
      /* Very short screens: the bar scrolls away with the page instead of covering it. */
      @media (max-height: 30rem) {
        .home-bar {
          position: absolute;
        }
      }

      /* Settings: a quiet icon button, and under it a small panel with the Motion switch. */
      .settings {
        position: relative;
      }
      .settings-btn[aria-expanded='true'] {
        background: var(--panel-3);
        color: var(--text);
      }
      @media (pointer: coarse) {
        .settings-btn {
          width: var(--h-touch);
          height: var(--h-touch);
        }
      }
      .settings-pop {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        display: grid;
        gap: 0.5rem;
        width: 17rem;
        padding: 0.75rem 0.875rem 0.875rem;
        border: 1px solid var(--line-2);
        border-radius: var(--radius-2);
        background: var(--panel);
        box-shadow: var(--shadow-elev-3);
        font-size: var(--text-sm);
        color: var(--muted);
      }
      .settings-pop .motion-switch {
        justify-content: space-between;
        min-height: var(--h-md);
        padding: 0;
        color: var(--text);
        font-weight: 500;
      }
      @media (pointer: coarse) {
        .settings-pop .motion-switch {
          min-height: var(--h-touch);
        }
      }
      .settings-note {
        font-size: var(--text-xs);
        line-height: 1.5;
        color: var(--dim);
      }
      /* Without JavaScript the switches can't work (and the lab doesn't run), so they aren't offered. */
      @media (scripting: none) {
        .settings,
        .home-foot .motion-switch {
          display: none;
        }
      }

      /* The phone tab bar covers the page end, so the page ends above it. */
      .home-main {
        padding-bottom: calc(3.5rem + env(safe-area-inset-bottom));
      }
      @media (min-width: 768px) {
        .home-main {
          padding-bottom: 0;
        }
      }
      @media (max-height: 30rem) {
        .home-main {
          padding-bottom: 0;
        }
      }
      /* A page of its own starts under the bar; its own header sets the space above its title. */
      .story-main {
        position: relative;
        padding-top: 3.5rem;
      }
      .home-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.25rem 1.5rem;
        padding: 1.5rem 1rem 1.75rem;
        border-top: 1px solid var(--line);
        font-size: var(--text-2xs);
        color: var(--dim);
      }
      .home-foot a,
      .home-foot button {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        min-height: var(--h-md);
      }
      .home-foot a:hover {
        color: var(--text);
      }
      @media (pointer: coarse) {
        .home-foot a,
        .home-foot button {
          min-height: var(--h-touch);
        }
      }

      /* Motion: a switch, drawn in neutrals (green means active, and this is a preference). */
      .motion-switch {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0 0.25rem;
      }
      .motion-switch:hover {
        color: var(--text);
      }
      .sw {
        position: relative;
        width: 1.5rem;
        height: 0.875rem;
        border-radius: 999px;
        box-shadow: inset 0 0 0 1px var(--line-2);
        background: var(--bg);
        transition: background-color var(--dur-1) var(--ease);
      }
      .sw::after {
        content: '';
        position: absolute;
        top: 3px;
        left: 3px;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: var(--dim);
        transition: translate var(--dur-1) var(--ease);
      }
      [aria-checked='true'] > .sw {
        background: var(--panel-3);
      }
      [aria-checked='true'] > .sw::after {
        translate: 0.625rem 0;
        background: var(--text);
      }
    </style>
  </body>
</html>
