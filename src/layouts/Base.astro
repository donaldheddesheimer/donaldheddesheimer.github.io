---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Icon, { type IconName } from '../components/Icon.astro';
import NewTab from '../components/NewTab.astro';
import Mark from '../components/Mark.astro';
import { experience, orgs, profile, socials } from '../data/site';
import { getModel, typeName } from '../lib/model';
import { build } from '../lib/build';

interface Props {
  title?: string;
  description?: string;
  crumb?: { label: string; href?: string }[];
  home?: boolean;
  /** The rail / tab bar section this page belongs to, marked current (subpages). */
  section?: string;
  /** A short readout for the left of the status bar on pages without a selection (e.g. the 404). */
  status?: string;
  /** False for a page with no address of its own (the 404), which gets no canonical link. */
  canonical?: boolean;
}
const { title = profile.name, description = profile.tagline, crumb = [{ label: 'Overview' }], home = false, section, status, canonical = true } = Astro.props;
// Absolute URLs for link previews. public/og.png is rendered from the profile (see src/data/site.ts).
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const base = home ? '' : '/';
const nav: { id: string; label: string; icon: IconName; mobile?: boolean }[] = [
  { id: 'overview', label: 'Overview', icon: 'graph', mobile: true },
  { id: 'timeline', label: 'Timeline', icon: 'timeline' },
  { id: 'experience', label: 'Experience', icon: 'briefcase', mobile: true },
  { id: 'projects', label: 'Projects', icon: 'cube', mobile: true },
  { id: 'capabilities', label: 'Capabilities', icon: 'layers' },
  { id: 'off-duty', label: 'Off duty', icon: 'sun', mobile: true },
  { id: 'contact', label: 'Contact', icon: 'radio', mobile: true },
];

// Everything the ⌘K search can jump to. `terms` is extra text that matches but isn't shown.
const projects = (await getCollection('projects')).sort((a, b) => b.data.code.localeCompare(a.data.code));
const search = [
  ...projects.map((p) => ({ kind: 'Project', code: p.data.code, label: p.data.title, sub: p.data.tags.join(' · '), terms: `${p.data.summary} ${p.data.context ?? ''}`, href: `/projects/${p.id}/` })),
  ...experience.map((e) => ({
    kind: 'Experience',
    code: e.id.toUpperCase().slice(0, 8),
    label: orgs.find((o) => o.id === e.org)!.name,
    sub: e.role,
    terms: `${e.unit ?? ''} ${e.tags.join(' ')}`,
    href: `/#exp-${e.id}`,
  })),
  { kind: 'Experience', code: 'EDU', label: 'Georgia Institute of Technology', sub: 'B.S. Computer Science', href: '/#exp-education' },
  // Orgs and capabilities open on the homepage console with that object selected.
  ...(await getModel())
    .list()
    .filter((e) => e.type === 'org' || e.type === 'skill')
    .map((e) => ({ kind: 'Map', code: typeName[e.type].slice(0, 3).toUpperCase(), label: e.title, sub: e.kind, sel: e.id, href: `/?sel=${encodeURIComponent(e.id)}#overview` })),
  ...nav.map((n) => ({ kind: 'Section', code: 'NAV', label: n.label, sub: '', href: `/#${n.id}` })),
  { kind: 'File', code: 'PDF', label: 'Resume', sub: 'Download PDF', href: profile.resume },
  ...socials.map((s) => ({ kind: 'Link', code: 'EXT', label: s.label, sub: s.handle, href: s.href })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111418" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    {canonical && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}: ${profile.headline}. A console-style card with an abstract systems map.`} />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={pageUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Before first paint: note that JS runs, and apply the saved Motion setting (off by default
      // for people who've asked their OS for reduced motion).
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        var saved = null;
        try {
          saved = localStorage.getItem('motion');
        } catch (e) {}
        h.dataset.motion = saved || (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'off' : 'on');
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 btn btn-primary">Skip to content</a>

    <!-- Top bar -->
    <header class="fixed inset-x-0 top-0 z-40 flex h-12 items-center border-b border-line bg-panel">
      <a href="/" class="grid h-full w-12 shrink-0 place-items-center border-r border-line md:w-14" aria-label="Home">
        <Mark class="size-7" />
      </a>
      <!-- Phones show only the current page, so its title has the room. Each page links back to its parent in its own header. -->
      <nav aria-label="Breadcrumb" class="flex min-w-0 items-center gap-2 px-3 text-sm">
        <a href="/" class="hidden py-1 font-semibold whitespace-nowrap sm:inline-block pointer-coarse:py-3">{profile.name}</a>
        {
          crumb.map((c, i) => (
            <>
              <span class="hidden text-dim sm:inline" aria-hidden="true">/</span>
              {c.href ? (
                <a href={c.href} class="truncate text-muted hover:text-text max-sm:hidden pointer-coarse:py-3">
                  {c.label}
                </a>
              ) : (
                <span class:list={['truncate', i === crumb.length - 1 ? 'text-text sm:text-muted' : 'text-muted']} data-crumb-current={home && i === crumb.length - 1 ? '' : undefined}>
                  {c.label}
                </span>
              )}
            </>
          ))
        }
      </nav>

      <button
        type="button"
        data-cmdk-open
        class="mx-auto hidden h-(--h-md) w-full max-w-sm items-center gap-2 rounded-2 bg-bg px-2.5 text-left text-sm text-dim shadow-[inset_0_0_0_1px_var(--line)] hover:shadow-[inset_0_0_0_1px_var(--line-2)] md:flex pointer-coarse:h-11"
      >
        <Icon name="search" class="size-4" />
        <span>Search objects…</span>
        <kbd class="ml-auto code-chip" data-kbd>⌘K</kbd>
      </button>

      <div class="ml-auto flex items-center gap-1.5 pr-2 md:ml-0 md:gap-3 md:pr-3">
        <span class="hidden readout text-2xs lg:inline">ATL <span data-clock>--:--</span></span>
        <button type="button" data-cmdk-open class="btn btn-ghost btn-icon md:hidden" aria-label="Search">
          <Icon name="search" class="size-4" />
        </button>
        <!-- Not primary: the identity strip below holds the page's one primary action. -->
        <a href={profile.resume} class="topbar-resume btn" target="_blank" rel="noopener" aria-label="Resume (PDF, opens in new tab)">
          <Icon name="file" class="size-4" />
          <span class="max-sm:hidden">Resume</span>
          <NewTab class="size-3.5 shrink-0 max-sm:hidden" />
        </a>
      </div>
    </header>

    <!-- Left rail (desktop) -->
    <nav aria-label="Sections" class="fixed top-12 bottom-0 left-0 z-30 hidden w-14 flex-col items-center gap-1 border-r border-line bg-panel py-2 md:flex" data-rail>
      {
        nav.map((n) => (
          <a
            href={`${base}#${n.id}`}
            data-spy={n.id}
            data-spy-label={n.label}
            class="rail-btn relative grid size-10 place-items-center rounded-2 text-dim hover:bg-(--hover-bg) hover:text-text pointer-coarse:size-11"
            aria-label={n.label}
            aria-current={n.id === section ? 'true' : undefined}
          >
            <Icon name={n.icon} class="size-[18px]" />
            <span class="rail-tip" aria-hidden="true">{n.label}</span>
          </a>
        ))
      }
      <div class="mt-auto flex flex-col items-center gap-1">
        <div class="mb-1 h-px w-6 bg-line" aria-hidden="true"></div>
        {
          socials.map((s) => {
            const newTab = s.id !== 'email';
            return (
              <a
                href={s.href}
                class="rail-btn relative grid size-10 place-items-center rounded-2 text-dim hover:bg-(--hover-bg) hover:text-text pointer-coarse:size-11"
                aria-label={newTab ? `${s.label} (opens in new tab)` : s.label}
                target={newTab ? '_blank' : undefined}
                rel={newTab ? 'noopener' : undefined}
              >
                <Icon name={s.icon} class="size-[18px]" />
                <span class="rail-tip" aria-hidden="true">{newTab ? `${s.label} ↗` : s.label}</span>
              </a>
            );
          })
        }
      </div>
    </nav>

    <main id="main" class="pt-12 pb-20 md:pb-10 md:pl-14">
      <slot />
      <!-- Phones have no status bar, so its copyright line and Motion switch close the page. -->
      <footer class="flex items-center justify-center gap-4 px-4 pb-2 readout text-2xs text-dim md:hidden">
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <button type="button" role="switch" aria-checked="true" class="motion-switch pointer-coarse:min-h-11" data-motion-toggle title="Turn animation on or off">
          Motion <span class="sw" aria-hidden="true"></span>
        </button>
      </footer>
    </main>

    <!-- Bottom bar (mobile). After main in the source, so it lands at the page end when it stops being fixed. -->
    <nav aria-label="Sections" class="tabbar fixed inset-x-0 bottom-0 z-40 grid h-14 grid-cols-5 border-t border-line bg-panel pb-[env(safe-area-inset-bottom)] md:hidden">
      {
        nav
          .filter((n) => n.mobile)
          .map((n) => (
            <a
              href={`${base}#${n.id}`}
              data-spy={n.id}
              class="rail-btn flex flex-col items-center justify-center gap-1 text-2xs text-dim"
              aria-current={n.id === section ? 'true' : undefined}
            >
              <Icon name={n.icon} class="size-[18px]" />
              {n.label}
            </a>
          ))
      }
    </nav>

    <!-- Status bar (desktop) -->
    <footer class="fixed right-0 bottom-0 left-14 z-30 hidden h-8 items-center gap-4 border-t border-line bg-panel px-3 readout text-2xs text-dim md:flex">
      {
        home ? (
          <span class="flex min-w-0 items-center gap-1.5">
            SEL <span class="max-w-[32ch] truncate text-muted" data-status-sel>mission (illustrative)</span>
          </span>
        ) : (
          status && <span class="text-muted">{status}</span>
        )
      }
      <button type="button" role="switch" aria-checked="true" class="motion-switch h-full" data-motion-toggle title="Turn animation on or off">
        Motion <span class="sw" aria-hidden="true"></span>
      </button>
      <span class="hidden xl:inline">{projects.length} projects</span>
      <span class="hidden xl:inline">{experience.length} roles</span>
      <span class="ml-auto hidden xl:inline">{profile.coords}</span>
      {
        build && (
          <span class="ml-auto xl:ml-0">
            BUILD <span class="text-muted">{build.sha} {build.date}</span>
          </span>
        )
      }
      <span class="hidden lg:inline">© {new Date().getFullYear()} {profile.name}</span>
      <a href="https://github.com/donaldheddesheimer/donaldheddesheimer.github.io" class="flex h-full items-center gap-1 hover:text-text" target="_blank" rel="noopener">Source<NewTab class="size-3 shrink-0" /></a>
    </footer>

    <!-- ⌘K search -->
    <dialog id="cmdk" class="m-auto mt-[12vh] w-[min(640px,calc(100%-2rem))] rounded-2 border border-line-2 bg-panel p-0 text-text shadow-elev-3 backdrop:bg-black/60" aria-label="Search">
      <div class="flex items-center gap-2 border-b border-line px-3">
        <Icon name="search" class="size-4 text-dim" />
        <input
          id="cmdk-input"
          type="text"
          role="combobox"
          aria-expanded="true"
          aria-controls="cmdk-list"
          aria-autocomplete="list"
          aria-label="Search"
          placeholder="Search projects, roles, sections…"
          autocomplete="off"
          spellcheck="false"
          class="h-12 flex-1 bg-transparent text-md outline-none placeholder:text-dim"
        />
        <kbd class="code-chip">ESC</kbd>
      </div>
      <ul id="cmdk-list" role="listbox" aria-label="Search results" class="max-h-[55vh] overflow-y-auto py-1"></ul>
      <p id="cmdk-empty" class="px-3 py-6 text-center text-dim" hidden>No objects match that query.</p>
      <div class="flex gap-4 border-t border-line px-3 py-2 readout text-2xs text-dim">
        <span>↑↓ navigate</span><span>↵ open</span><span class="ml-auto" id="cmdk-count" role="status"></span>
      </div>
    </dialog>
    <script type="application/json" id="cmdk-data" set:html={JSON.stringify(search).replace(/</g, '\\u003c')} />

    <script>
      // Scroll-spy for the rail and bottom bar; the breadcrumb names the current section too.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
      const crumbNow = document.querySelector('[data-crumb-current]');
      const sections = [...new Set(links.map((a) => a.dataset.spy!))]
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => !!el);
      if (sections.length) {
        // The last section is too short to cross the middle band, so it wins at the bottom of the page.
        let current = sections[0].id;
        const mark = () => {
          const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
          const id = atBottom ? sections[sections.length - 1].id : current;
          links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.spy === id));
          const label = links.find((a) => a.dataset.spy === id && a.dataset.spyLabel)?.dataset.spyLabel;
          if (crumbNow && label && crumbNow.textContent !== label) crumbNow.textContent = label;
        };
        const spy = new IntersectionObserver(
          (entries) => {
            for (const e of entries) if (e.isIntersecting) current = e.target.id;
            mark();
          },
          { rootMargin: '-40% 0px -55% 0px' },
        );
        sections.forEach((s) => spy.observe(s));
        addEventListener('scroll', mark, { passive: true });
      }

      // Atlanta clock, to the minute ("20:24 EDT"), ticking as each minute turns.
      const clocks = document.querySelectorAll('[data-clock]');
      const fmt = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZoneName: 'short' });
      const tick = () => {
        const text = fmt.format(new Date()).replace(',', '');
        clocks.forEach((c) => (c.textContent = text));
        setTimeout(tick, 60_000 - (Date.now() % 60_000));
      };
      if (clocks.length) tick();

      // The search shortcut as this platform writes it.
      if (!/Mac|iPhone|iPad|iPod/.test(navigator.platform)) document.querySelectorAll('[data-kbd]').forEach((k) => (k.textContent = 'Ctrl K'));

      // ⌘K search.
      type Item = { kind: string; code: string; label: string; sub: string; terms?: string; href: string; sel?: string };
      const dialog = document.getElementById('cmdk') as HTMLDialogElement;
      const input = document.getElementById('cmdk-input') as HTMLInputElement;
      const list = document.getElementById('cmdk-list')!;
      const empty = document.getElementById('cmdk-empty')!;
      const count = document.getElementById('cmdk-count')!;
      const items: Item[] = JSON.parse(document.getElementById('cmdk-data')!.textContent!);
      let shown: Item[] = [];
      let active = 0;
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

      function render() {
        const q = input.value.trim().toLowerCase();
        shown = items.filter((i) => !q || `${i.label} ${i.sub} ${i.kind} ${i.code} ${i.terms ?? ''}`.toLowerCase().includes(q));
        active = Math.min(active, Math.max(shown.length - 1, 0));
        // Each option is the activation target itself; the highlighted row's secondary text is ink so
        // it keeps 4.5:1 on the selection tint.
        list.innerHTML = shown
          .map((i, n) => {
            const on = n === active;
            return `<li role="option" id="cmdk-opt-${n}" aria-selected="${on}" data-n="${n}" class="flex cursor-pointer items-center gap-3 px-3 py-2 pointer-coarse:min-h-11 ${on ? 'bg-(--sel-bg)' : ''}">
                  <span class="code-chip w-20 justify-center">${esc(i.code)}</span>
                  <span class="min-w-0 flex-1 truncate"><span class="text-text">${esc(i.label)}</span> <span class="${on ? 'text-ink' : 'text-dim'}">${esc(i.sub)}</span></span>
                  <span class="kicker ${on ? 'text-ink' : ''}">${esc(i.kind)}</span>
                </li>`;
          })
          .join('');
        list.hidden = !shown.length;
        empty.hidden = !!shown.length;
        input.setAttribute('aria-expanded', String(!!shown.length));
        if (shown.length) input.setAttribute('aria-activedescendant', `cmdk-opt-${active}`);
        else input.removeAttribute('aria-activedescendant');
        // The count is a live region: only touch it when it changes, so arrowing through results stays quiet.
        const total = `${shown.length} result${shown.length === 1 ? '' : 's'}`;
        if (count.textContent !== total) count.textContent = total;
        list.querySelector('[aria-selected="true"]')?.scrollIntoView({ block: 'nearest' });
      }
      function open() {
        input.value = '';
        active = 0;
        render();
        dialog.showModal();
        input.focus();
      }
      document.querySelectorAll('[data-cmdk-open]').forEach((b) => b.addEventListener('click', open));
      document.addEventListener('keydown', (e) => {
        const typing = e.target instanceof Element && e.target.closest('input, textarea');
        if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing && !dialog.open)) {
          e.preventDefault();
          dialog.open ? dialog.close() : open();
        }
      });
      input.addEventListener('input', () => {
        active = 0;
        render();
      });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          active = (active + (e.key === 'ArrowDown' ? 1 : -1) + shown.length) % Math.max(shown.length, 1);
          render();
        } else if (e.key === 'Enter' && shown[active]) {
          e.preventDefault();
          dialog.close();
          go(shown[active]);
        }
      });
      list.addEventListener('click', (e) => {
        const option = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
        const item = option && shown[Number(option.dataset.n)];
        if (!item) return;
        dialog.close();
        go(item);
      });
      // On the homepage, map objects are selected in place instead of reloading the page.
      const onConsole = () => !!document.getElementById('entity-data');
      function go(i: Item) {
        if (i.sel && onConsole()) document.dispatchEvent(new CustomEvent('entity:reveal', { detail: i.sel }));
        else location.href = i.href;
      }

      // Motion switches (status bar, and the phone footer).
      const motionBtns = document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]');
      const showMotion = () => {
        const on = document.documentElement.dataset.motion !== 'off';
        motionBtns.forEach((b) => b.setAttribute('aria-checked', String(on)));
      };
      showMotion();
      motionBtns.forEach((b) =>
        b.addEventListener('click', () => {
          const next = document.documentElement.dataset.motion === 'off' ? 'on' : 'off';
          document.documentElement.dataset.motion = next;
          try {
            localStorage.setItem('motion', next);
          } catch {}
          showMotion();
        }),
      );
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });

      // Rail labels open 300ms after a mouse arrives (keyboard focus shows them at once, in CSS) and stay
      // open while the pointer is on the button or its label. Escape closes them until the pointer
      // leaves or focus moves to another button.
      const rail = document.querySelector<HTMLElement>('[data-rail]');
      if (rail) {
        let timer = 0;
        rail.querySelectorAll<HTMLElement>('.rail-btn').forEach((btn) => {
          btn.addEventListener('pointerenter', (e) => {
            if (e.pointerType === 'mouse') timer = window.setTimeout(() => btn.toggleAttribute('data-tip', true), 300);
          });
          btn.addEventListener('pointerleave', () => {
            clearTimeout(timer);
            btn.removeAttribute('data-tip');
          });
        });
        addEventListener('keydown', (e) => {
          if (e.key !== 'Escape' || dialog.open) return;
          clearTimeout(timer);
          rail.querySelector('[data-tip]')?.removeAttribute('data-tip');
          if (rail.contains(document.activeElement)) rail.dataset.tips = 'off';
        });
        rail.addEventListener('focusin', () => delete rail.dataset.tips);
      }
    </script>

    <style>
      /* Rail labels: an edged tooltip, shown on keyboard focus or once the script marks a hovered
         button (after a short delay), and hoverable and dismissable (WCAG 1.4.13). */
      .rail-tip {
        position: absolute;
        left: 100%;
        margin-left: 0.5rem;
        display: none;
        padding: 0.25rem 0.5rem;
        border: 1px solid var(--line-2);
        border-radius: var(--radius-2);
        background: var(--panel-3);
        box-shadow: var(--shadow-elev-2);
        color: var(--text);
        font-size: var(--text-xs);
        white-space: nowrap;
      }
      /* Bridges the gap to the button, so the pointer can cross onto the label without closing it. */
      .rail-tip::before {
        content: '';
        position: absolute;
        top: 0;
        right: 100%;
        bottom: 0;
        width: 0.5rem;
      }
      .rail-btn[data-tip] .rail-tip,
      .rail-btn:focus-visible .rail-tip {
        display: block;
      }
      /* Escape hides the focused button's label; a fresh hover still opens one. */
      [data-rail][data-tips='off'] .rail-btn:not([data-tip]) .rail-tip {
        display: none;
      }
      .rail-btn[aria-current] {
        color: var(--text);
        background: var(--sel-bg);
      }
      .rail-btn[aria-current]::before {
        content: '';
        position: absolute;
        left: -8px;
        top: 8px;
        bottom: 8px;
        width: 2px;
        background: var(--sel-bar);
      }
      @media (max-width: 767px) {
        .rail-btn {
          position: relative;
        }
        .rail-btn[aria-current] {
          background: transparent;
          color: var(--text);
        }
        .rail-btn[aria-current]::before {
          left: 30%;
          right: 30%;
          top: 0;
          bottom: auto;
          width: auto;
          height: 2px;
        }
      }

      /* Phones: the top-bar Resume is a 32px icon with a 44px hit area around it. */
      @media (width < 40rem) {
        .topbar-resume {
          position: relative;
          width: var(--h-md);
          min-width: 0;
          min-height: 0;
          padding: 0;
        }
        .topbar-resume::after {
          content: '';
          position: absolute;
          inset: -6px;
        }
      }

      /* Motion: a switch, drawn in neutrals (green means active, and this is a preference). */
      .motion-switch {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0 0.25rem;
      }
      .motion-switch:hover {
        color: var(--text);
      }
      .sw {
        position: relative;
        width: 1.5rem;
        height: 0.875rem;
        border-radius: 999px;
        box-shadow: inset 0 0 0 1px var(--line-2);
        background: var(--bg);
        transition: background-color var(--dur-1) var(--ease);
      }
      .sw::after {
        content: '';
        position: absolute;
        top: 3px;
        left: 3px;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: var(--dim);
        transition: translate var(--dur-1) var(--ease);
      }
      [aria-checked='true'] > .sw {
        background: var(--panel-3);
      }
      [aria-checked='true'] > .sw::after {
        translate: 0.625rem 0;
        background: var(--text);
      }
    </style>
  </body>
