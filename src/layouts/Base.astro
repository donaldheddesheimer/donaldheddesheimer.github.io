---
// The document every page shares: its head (title, description, link preview, canonical address, the
// Motion setting applied before first paint, fonts) and nothing else. The homepage is the lab
// (index.astro); every other page is one of the computer's (Screen.astro). There is no site header,
// footer or tab bar: the portfolio lives inside the computer.
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** This page's canonical address (a path), or false for one with no address of its own (the 404). */
  canonical?: string | false;
  /** Kept out of search results. */
  noindex?: boolean;
  /** One of the computer's pages (Screen.astro). */
  screen?: boolean;
}
const { title = profile.name, description = profile.tagline, canonical = Astro.url.pathname, noindex = false, screen = false } = Astro.props;
// Absolute URLs for link previews. public/og.jpg is a render of the homepage's opening (see src/data/site.ts).
const pageUrl = canonical === false ? null : new URL(canonical, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en" data-screen={screen ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0908" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.title.toLowerCase()}: his name over a robotics lab after hours, a computer on the desk at its centre and three robots dancing behind it.`} />
    <meta name="twitter:card" content="summary_large_image" />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Before first paint: note that JS runs, and apply the saved Motion setting (off by default
      // for people who've asked their OS for reduced motion).
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        var saved = null;
        try {
          saved = localStorage.getItem('motion');
        } catch (e) {}
        h.dataset.motion = saved || (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'off' : 'on');
      })();
    </script>
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;500;600&family=Pixelify+Sans:wght@500;600&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
