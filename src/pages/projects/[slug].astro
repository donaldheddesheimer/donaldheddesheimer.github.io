---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Panel from '../../components/Panel.astro';
import EntityShape from '../../components/EntityShape.astro';
import NewTab from '../../components/NewTab.astro';
import Stat from '../../components/Stat.astro';
import { getModel, typeName } from '../../lib/model';
import { fmtMonth, mediaKindLabel, statusLabel } from '../../lib/format';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.code.localeCompare(b.data.code));
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}
const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const all = await getCollection('projects');
const model = await getModel();
// What this project connects to on the homepage systems map; each opens there with it selected.
const groups = model.links(`project:${project.id}`).filter((g) => g.items.every((l) => l.type !== 'person'));
const linkCount = groups.reduce((n, g) => n + g.items.length, 0);
const mapHref = (id: string) => `/?sel=${encodeURIComponent(id)}#overview`;

// Related projects: most shared tags.
const related = all
  .filter((p) => p.id !== project.id)
  .map((p) => ({ p, shared: p.data.tags.filter((t) => d.tags.includes(t)).length }))
  .filter((r) => r.shared > 0)
  .sort((a, b) => b.shared - a.shared || b.p.data.code.localeCompare(a.p.data.code))
  .slice(0, 3);

// The cover's caption names its kind only when the evidence list already says what it is.
const coverKind = d.evidence.find((m) => m.src === d.cover)?.kind;
---

<Base title={`${d.title} · ${d.code} · Donald Heddesheimer`} description={d.summary} crumb={[{ label: 'Projects', href: '/#projects' }, { label: d.title }]} section="projects">
  <div class="mx-auto flex max-w-[1400px] flex-col gap-3 p-3 md:gap-4 md:p-4">
    <!-- Header -->
    <section class="panel overflow-hidden">
      <div class="flex flex-wrap items-center gap-2 border-b border-line bg-panel-2/60 px-4 py-2">
        <a href="/#projects" class="flex items-center gap-1.5 text-xs text-dim hover:text-text pointer-coarse:-my-3 pointer-coarse:min-h-11">
          <Icon name="arrow-left" class="size-3.5" /> All projects
        </a>
        <span class="text-dim" aria-hidden="true">/</span>
        <span class="code-chip">{d.code}</span>
        <span class="kicker">Project object</span>
      </div>
      <div class="grid gap-5 p-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:p-6">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <span class={`pill pill-${d.status}`}>{statusLabel[d.status]}</span>
            {d.context && <span class="readout text-xs">{d.context}</span>}
            {d.featured && <span class="flex items-center gap-1 readout text-2xs text-ink"><Icon name="star" class="size-3.5" />FEATURED</span>}
          </div>
          <h1 class="mt-2.5 text-2xl leading-tight font-semibold tracking-tight md:text-3xl">{d.title}</h1>
          <p class="mt-2 max-w-(--measure) text-md leading-relaxed text-muted">{d.summary}</p>
        </div>
        <div class="flex flex-wrap gap-2">
          {
            d.demo && (
              <a href={d.demo} class="btn btn-primary" target="_blank" rel="noopener">
                <NewTab class="size-4" />
                Live demo
              </a>
            )
          }
          {
            d.repo ? (
              <a href={d.repo} class:list={['btn', !d.demo && 'btn-primary']} target="_blank" rel="noopener">
                <Icon name="github" class="size-4" />
                Repository
                <NewTab />
              </a>
            ) : (
              <p class="inline-flex min-h-(--h-md) items-center gap-1.5 text-dim">
                <Icon name="lock" class="size-4" />
                {d.repoNote ?? 'Private repository'}
              </p>
            )
          }
        </div>
      </div>
      {
        d.stats.length > 0 && (
          <dl class="grid grid-cols-2 gap-px border-t border-line bg-line md:grid-cols-4">
            {d.stats.map((s) => (
              <Stat label={s.label} value={s.value} class="bg-panel px-5 py-3.5" />
            ))}
          </dl>
        )
      }
    </section>

    <div class="grid grid-cols-[minmax(0,1fr)] gap-3 md:gap-4 lg:grid-cols-[minmax(0,1fr)_320px]">
      <!-- Body -->
      <Panel title="Write-up" icon="file" as="section" class="lg:self-start" bodyClass="p-5 md:p-8">
        {
          d.cover && (
            <figure class="mb-8">
              <img src={d.cover} alt={d.coverAlt ?? ''} class="mx-auto max-h-[70vh] rounded-2 border border-line" />
              <figcaption class="fig-cap">
                <span class="kicker">Cover{coverKind && ` · ${mediaKindLabel[coverKind]}`}</span>
                {d.coverAlt}
              </figcaption>
            </figure>
          )
        }
        <article class="prose">
          <Content />
        </article>
      </Panel>

      <!-- Sidebar: sticky, and scrolls on its own when it is taller than the screen -->
      <div class="flex flex-col gap-3 md:gap-4 lg:sticky lg:top-16 lg:max-h-[calc(100dvh-7rem)] lg:self-start lg:overflow-y-auto">
        <Panel title="Properties" icon="list" as="aside">
          <dl class="kv p-4">
            <dt>ID</dt>
            <dd class="font-mono text-xs">{d.code}</dd>
            <dt>Type</dt>
            <dd>Project</dd>
            <dt>Status</dt>
            <dd><span class={`pill pill-${d.status}`}>{statusLabel[d.status]}</span></dd>
            <dt>Started</dt>
            <dd>{fmtMonth(d.start)}</dd>
            <dt>Context</dt>
            <dd>{d.context ?? 'Personal project'}</dd>
            {
              d.team && (
                <>
                  <dt>Team</dt>
                  <dd>{d.team}</dd>
                </>
              )
            }
            <dt>Source</dt>
            <dd class="min-w-0 wrap-anywhere">
              {
                d.repo ? (
                  <a href={d.repo} class="inline-flex max-w-full items-center gap-1 text-blue-3 hover:underline pointer-coarse:-my-3 pointer-coarse:py-3" target="_blank" rel="noopener">
                    {d.repo.replace('https://github.com/', '')}
                    <NewTab />
                  </a>
                ) : (
                  <span class="text-dim">{d.repoNote ?? 'Private'}</span>
                )
              }
            </dd>
          </dl>
          <div class="flex flex-wrap gap-1.5 border-t border-line px-4 py-3">
            {d.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </Panel>

        <Panel title="Linked objects" icon="graph" as="aside">
          <a slot="actions" href={mapHref(`project:${project.id}`)} class="inline-flex items-center gap-1 text-xs text-blue-3 hover:underline pointer-coarse:-my-3 pointer-coarse:min-h-11">
            Show on map <Icon name="arrow-right" class="size-3.5" />
          </a>
          <div class="divide-y divide-line">
            {
              groups.map((g) => (
                <div>
                  <p class="px-4 pt-2.5 text-xs text-dim">{g.label}</p>
                  <ul class="pb-1">
                    {g.items.map((l) => (
                      <li>
                        <a href={mapHref(l.id)} class="flex items-center gap-2.5 px-4 py-1.5 text-sm hover:bg-panel-2 pointer-coarse:min-h-11">
                          <EntityShape type={l.type} class="size-2.5 shrink-0" />
                          <span class="min-w-0 flex-1 truncate">{l.label}</span>
                          <span class="kicker">{typeName[l.type]}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
            {
              groups.length === 0 && related.length === 0 && (
                <p class="px-4 py-3 text-xs text-dim">No linked organizations, capabilities, or projects.</p>
              )
            }
            {
              related.length > 0 && (
                <div>
                  <p class="px-4 pt-2.5 text-xs text-dim">Shares the most tags with</p>
                  <ul class="pb-1">
                    {related.map(({ p }) => (
                      <li>
                        <a href={`/projects/${p.id}/`} class="flex items-center gap-2.5 px-4 py-1.5 text-sm hover:bg-panel-2 pointer-coarse:min-h-11">
                          <EntityShape type="project" class="size-2.5 shrink-0" />
                          <span class="min-w-0 flex-1 truncate">{p.data.title}</span>
                          <span class="kicker">{p.data.code}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
          </div>
          {linkCount > 0 && <p class="sr-only">{linkCount} linked objects</p>}
        </Panel>

        <nav class="grid grid-cols-2 gap-3" aria-label="More projects">
          {
            prev ? (
              <a href={`/projects/${prev.id}/`} class="panel group p-3 hover:border-line-2">
                <span class="flex items-center gap-1 kicker group-hover:text-text">
                  <Icon name="arrow-left" class="size-3" /> {prev.data.code}
                </span>
                <span class="mt-1 block truncate text-sm font-medium">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a href={`/projects/${next.id}/`} class="panel group p-3 text-right hover:border-line-2">
                <span class="flex items-center justify-end gap-1 kicker group-hover:text-text">
                  {next.data.code} <Icon name="arrow-right" class="size-3" />
                </span>
                <span class="mt-1 block truncate text-sm font-medium">{next.data.title}</span>
              </a>
            )
          }
        </nav>
      </div>
    </div>
  </div>
</Base>
