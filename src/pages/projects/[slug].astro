---
// A project's case study: the ordinary page for the lab computer's work/<id> (routes.ts), and the
// address to share for it.
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { profile } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.code.localeCompare(b.data.code));
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const d = project.data;
---

<Base title={`${d.title} · ${profile.name}`} description={d.summary} section="work" story>
  <CaseStudy {...Astro.props} />
</Base>
