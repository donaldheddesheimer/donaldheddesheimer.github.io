---
// A project's case study as a page of its own: the canonical address for the lab computer's
// work/<id> (routes.ts), for search and for anyone who links here directly. It stays where it is (the
// terminal prints the same write-up: /?computer=work/<id> is the lab reading it, /computer/work/<id>/ its
// transcript); its bar leads into the computer and back to the room.
import { getCollection, type CollectionEntry } from 'astro:content';
import Screen from '../../layouts/Screen.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { profile } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.code.localeCompare(b.data.code));
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const d = project.data;
---

<Screen title={`${d.title} · ${profile.name}`} description={d.summary} section="work">
  <CaseStudy {...Astro.props} />
</Screen>
