---
// PROTOTYPE (lab-prototype, 2026-09-27): a computer-first opening, for review. Not linked from the site
// and not indexed. The opening is the lab (LabStage.astro): the name, role, Resume, Contact and the way
// in ("Explore the lab", or the monitor) over the room. Inside, the desk's computer holds the portfolio
// (/computer/). The homepage's own sections follow below, unchanged, as the page for every window the
// lab doesn't open in (phones; narrow, short or portrait windows) and for anyone who scrolls past it.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import NewTab from '../components/NewTab.astro';
import LabStage from '../components/LabStage.astro';
import HomeSections from '../components/HomeSections.astro';
import { profile } from '../data/site';
---

<Base home noindex title={`The lab · ${profile.name}`} description={profile.tagline}>
  <section id="top" class="lab-hero" aria-labelledby="hero-name">
    <script is:inline>
      // Offer the lab before first paint where the window can hold it (computer.ts keeps this current).
      if (matchMedia('(width >= 64rem) and (height >= 36rem) and (min-aspect-ratio: 3/2)').matches) document.documentElement.dataset.pcAble = '';
    </script>
    <div class="lab-copy" data-lab-avoid>
      <p class="hero-kicker"><span>{profile.status} ·</span> <span>{profile.school}</span></p>
      <h1 id="hero-name" class="lab-name">{profile.name}</h1>
      <p class="lab-role">{profile.headline}</p>
      <div class="hero-actions">
        <a href="#work" class="btn btn-primary btn-lg" data-lab-enter>
          <span class="pc-yes">Explore the lab</span><span class="pc-no">Selected work</span>
          <Icon name="arrow-right" class="size-4" />
        </a>
        <a href={profile.resume} class="btn btn-lg" target="_blank" rel="noopener"><Icon name="file" class="size-4" />Resume<NewTab class="size-3.5 shrink-0" /></a>
        <a href="#contact" class="btn btn-ghost btn-lg"><Icon name="mail" class="size-4" />Contact</a>
      </div>
    </div>
    <LabStage class="lab-hero-stage" />
  </section>

  <HomeSections />
</Base>

<style>
  .lab-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    padding-top: 3.5rem;
    background: #0a0908;
  }
  .lab-copy {
    position: relative;
    z-index: 1;
    padding: 1.25rem var(--home-edge) 1.5rem;
  }
  .lab-name {
    margin-top: 0.75rem;
    font-size: clamp(2.25rem, 9vw, 4rem);
    line-height: 1;
    font-weight: 650;
    letter-spacing: -0.035em;
    color: var(--text);
    text-wrap: balance;
  }
  .lab-role {
    margin-top: 0.5rem;
    font-size: clamp(1.0625rem, 4vw, 1.3125rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  :global(html[data-pc-able]) .pc-no,
  :global(html:not([data-pc-able])) .pc-yes {
    display: none;
  }
  .lab-hero :global(.lab-hero-stage) {
    --stage-h: clamp(15rem, 42svh, 24rem);
  }

  /* Wide windows: the room fills the first view, and the text is a small block over its dark corner. */
  @media (width >= 64rem) and (height >= 36rem) and (min-aspect-ratio: 3/2) {
    .lab-hero {
      height: 100svh;
      max-height: 68rem;
      padding: 0;
    }
    .lab-hero :global(.lab-hero-stage) {
      --cap-left: auto;
      position: absolute;
      inset: 0;
    }
    .lab-hero :global(.lab-cap) {
      right: 7.5rem;
      left: auto;
    }
    /* Out of the text's corner, and down into the page. */
    .lab-hero::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        linear-gradient(transparent 80%, var(--bg)),
        radial-gradient(60% 70% at 0% 0%, rgb(7 6 5 / 0.82), rgb(7 6 5 / 0.4) 55%, transparent);
    }
    .lab-copy {
      position: absolute;
      top: 5.25rem;
      left: var(--home-edge);
      width: min(34rem, 40%);
      padding: 0;
      text-shadow: 0 1px 24px rgb(0 0 0 / 0.6);
      pointer-events: none;
    }
    .lab-copy > * {
      width: fit-content;
      max-width: 100%;
      pointer-events: auto;
    }
    .lab-name {
      font-size: clamp(2.75rem, 4.2vw, 4.25rem);
    }
  }

  /* The lab (src/scripts/lab-prototype/computer.ts): the text, the bars and the page below fade, then the
     room leaves the section to fill the window (the camera flies from the same picture) while the page
     holds still under the lab's dialog. On the way back the room fades out of its dark ground, then
     drops back in place. */
  .lab-copy,
  .lab-hero::after,
  :global(.lab-cap),
  :global(.lab-ctl) {
    transition: opacity 250ms var(--ease);
  }
  :global(html[data-pc]) {
    overflow: hidden;
  }
  :global(html[data-pc]) .lab-copy,
  :global(html[data-pc]) .lab-hero::after,
  :global(html[data-pc]) :global(:is(.home-bar, .lab-cap, .lab-ctl, .home-sections, .home-foot, .tabbar)) {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 250ms var(--ease),
      visibility 0s linear 250ms;
  }
  :global(html[data-pc]:not([data-pc='fade'])) .lab-hero {
    z-index: 45;
  }
  :global(html[data-pc]:not([data-pc='fade'])) .lab-hero :global(.lab-canvas) {
    position: fixed;
    inset: 0;
  }
</style>
