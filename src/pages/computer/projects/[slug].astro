---
// PROTOTYPE. A case study on the lab computer's screen: the same CaseStudy as /projects/<id>/.
import { getCollection, type CollectionEntry } from 'astro:content';
import Screen from '../../../layouts/Screen.astro';
import CaseStudy from '../../../components/CaseStudy.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.code.localeCompare(b.data.code));
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const d = project.data;
---

<Screen title={`${d.title} · Portfolio`} page={`/projects/${project.id}/`} crumb={d.title}>
  <CaseStudy {...Astro.props} />
</Screen>
