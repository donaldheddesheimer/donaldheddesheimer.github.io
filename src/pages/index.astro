---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import NewTab from '../components/NewTab.astro';
import RobotStage from '../components/RobotStage.astro';
import HomeSections from '../components/HomeSections.astro';
import { profile, socials } from '../data/site';
---

<Base home>
  <!-- OPENING: who this is, over a stage of dancing robots (an illustration). Phones read the text,
       then the stage; from lg the stage fills the section and the robots stand right of the text. -->
  <section id="top" class="hero" aria-labelledby="hero-name">
    <div class="hero-copy">
      <p class="hero-kicker"><span>{profile.status} ·</span> <span>{profile.school}</span></p>
      <h1 id="hero-name" class="hero-name">{profile.name}</h1>
      <p class="hero-role">{profile.headline}</p>
      <p class="hero-lede">{profile.tagline}</p>
      <div class="hero-actions">
        <a href={profile.resume} class="btn btn-primary btn-lg" target="_blank" rel="noopener"><Icon name="file" class="size-4" />Resume<NewTab class="size-3.5 shrink-0" /></a>
        <a href="#work" class="btn btn-lg">Selected work<Icon name="arrow-right" class="size-4" /></a>
        <a href="#contact" class="btn btn-ghost btn-lg"><Icon name="mail" class="size-4" />Contact</a>
      </div>
      <div class="hero-social">
        {
          socials
            .filter((s) => s.id !== 'email')
            .map((s) => (
              <a href={s.href} target="_blank" rel="noopener">
                <Icon name={s.icon} class="size-4" />
                {s.label}
                <NewTab class="size-3 shrink-0" />
              </a>
            ))
        }
      </div>
    </div>
    <RobotStage class="hero-stage" />
  </section>

  <HomeSections />
</Base>
