---
// The homepage is the lab, and only the lab: the room across the whole window (LabStage.astro), the name
// and title quietly in one corner, Settings in the other. The monitor is the way in: it goes straight
// into the computer, which holds the whole portfolio (/computer/…: Work, About, Résumé, Contact;
// computer.ts). There is nothing below the room.
//
// /?computer=<path> is the lab reading that page (routes.ts): a shared link or a reload opens it at
// once, without the camera's entrance, on the monitor or, in a small window, across the window. The old
// anchors (/#work, /#about, /#resume, /#contact) open the computer the same way. /?sel=<id> is an old
// systems-map link (LegacySel.astro). Without JavaScript, the monitor is a link to the computer's Work
// page, which stands alone.
//
// All of it is the page's main landmark, in reading order: the name (the page's heading), the room with
// its one link (the monitor), then Settings. The room is fixed behind; the name and Settings stand over it.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LabStage from '../components/LabStage.astro';
import LegacySel from '../components/LegacySel.astro';
import Settings from '../components/Settings.astro';
import { profile } from '../data/site';
import { PAGES } from '../scripts/lab/routes';

const projects = (await getCollection('projects')).map((p) => p.id);
---

<Base title={`${profile.name} · ${profile.headline}`} description={profile.tagline}>
  <Fragment slot="head">
    <LegacySel />
    <script is:inline define:vars={{ projects, pages: PAGES }}>
      // Before first paint: open a shared computer address straight on its page (routes.ts parse(),
      // inlined), and make an old anchor the address it stands for.
      (function () {
        var h = document.documentElement;
        var query = new URLSearchParams(location.search);
        if (query.get('sel')) return;
        var path = query.get('computer');
        var anchor = location.hash.slice(1);
        if (path == null && pages.indexOf(anchor) >= 0) {
          path = anchor;
          history.replaceState(null, '', '/?computer=' + anchor);
        }
        if (path == null) return;
        path = path.replace(/^\/+|\/+$/g, '');
        var m = path.match(/^work\/([\w-]+)$/);
        if (pages.indexOf(path) >= 0 || (m && projects.indexOf(m[1]) >= 0)) h.dataset.pc = 'read';
        else history.replaceState(history.state, '', location.pathname + location.hash);
      })();
    </script>
  </Fragment>

  <main class="home">
    <header class="home-id" data-lab-avoid>
      <h1 class="home-name">{profile.name}</h1>
      <p class="home-title">{profile.title}</p>
    </header>
    <LabStage />
    <Settings class="home-settings" />
  </main>
</Base>

<style>
  /* The whole window, and no more at ordinary sizes. Enlarged text or a very short window lets the page
     grow and scroll rather than clip the name or Settings (the room stays put behind). */
  :global(body) {
    background: #0a0908;
  }
  .home {
    --pad-t: max(1.25rem, env(safe-area-inset-top));
    --pad-r: max(1.25rem, env(safe-area-inset-right));
    --pad-b: max(1.25rem, env(safe-area-inset-bottom));
    --pad-l: max(1.25rem, env(safe-area-inset-left));
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    min-height: 100dvh;
    padding: var(--pad-t) var(--pad-r) var(--pad-b) var(--pad-l);
    pointer-events: none;
  }
  /* (Settings is its own component: :global() for its root, which carries its scope, not this one.) */
  .home > :global(*) {
    pointer-events: auto;
  }
  @media (width >= 48rem) {
    .home {
      --pad-t: max(1.75rem, env(safe-area-inset-top));
      --pad-r: max(1.75rem, env(safe-area-inset-right));
      --pad-l: max(2rem, env(safe-area-inset-left));
    }
  }

  /* The name and title: small, in the corner, over the room's dark wall (above the room, which follows
     it in the page and is fixed behind). */
  .home-id {
    position: relative;
    z-index: 1;
    max-width: min(22rem, calc(100% - 3.5rem));
    text-shadow: 0 1px 16px rgb(0 0 0 / 0.7);
  }
  .home-name {
    font-size: var(--text-md);
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .home-title {
    margin-top: 0.125rem;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--muted);
  }

  .home :global(.home-settings) {
    position: absolute;
    z-index: 1;
    top: calc(var(--pad-t) - 0.375rem);
    right: calc(var(--pad-r) - 0.375rem);
  }

  /* Going in (computer.ts): the name and Settings fade, and stay hidden while reading. */
  .home-id,
  .home :global(.home-settings) {
    transition: opacity 250ms var(--ease);
  }
  :global(html[data-pc]) {
    overflow: hidden;
  }
  :global(html[data-pc]) .home-id,
  :global(html[data-pc]) .home :global(.home-settings) {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 250ms var(--ease),
      visibility 0s linear 250ms;
  }
  :global(html[data-motion='off']) .home-id,
  :global(html[data-motion='off']) .home :global(.home-settings) {
    transition: none;
  }
</style>
