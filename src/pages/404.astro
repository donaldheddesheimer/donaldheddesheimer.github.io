---
// Not found: under the computer's bar (Screen.astro), with the way into the work and back to the room.
import { getCollection } from 'astro:content';
import Screen from '../layouts/Screen.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/site';
import { pageHref } from '../scripts/lab/routes';

const projects = (await getCollection('projects')).sort((a, b) => b.data.code.localeCompare(a.data.code)).slice(0, 5);
---

<Screen title={`Not found · ${profile.name}`} canonical={false} noindex>
  <section class="nf" aria-labelledby="nf-title">
    <p class="nf-kicker">404</p>
    <h1 id="nf-title" class="nf-title">Nothing is at this address.</h1>
    <p class="nf-note">It may have moved. <span class="nf-path" data-path></span></p>
    <div class="nf-actions">
      <a href={pageHref('work')} class="btn btn-primary">Explore my work<Icon name="arrow-right" class="size-4" /></a>
      <a href="/" class="btn"><Icon name="arrow-left" class="size-4" />Back to room</a>
    </div>
    <h2 class="nf-kicker nf-list-head">Recent projects</h2>
    <ul class="nf-list">
      {
        projects.map((p) => (
          <li>
            <a href={`/projects/${p.id}/`}>
              <span>{p.data.title}</span>
              <Icon name="arrow-right" class="size-3.5 shrink-0 text-dim" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Screen>

<script>
  const el = document.querySelector('[data-path]');
  if (el) el.textContent = `(${location.pathname})`;
</script>

<style>
  .nf {
    width: min(36rem, 100%);
    margin: 0 auto;
    padding: clamp(3rem, 12vh, 7rem) var(--home-edge) 4rem;
  }
  .nf-kicker {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .nf-title {
    margin-top: 0.75rem;
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    line-height: 1.1;
    font-weight: 650;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .nf-note {
    margin-top: 0.75rem;
    color: var(--muted);
  }
  .nf-path {
    overflow-wrap: anywhere;
    color: var(--dim);
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .nf-list-head {
    margin-top: 3rem;
  }
  .nf-list {
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .nf-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .nf-list a:hover {
    color: var(--text);
  }
</style>
