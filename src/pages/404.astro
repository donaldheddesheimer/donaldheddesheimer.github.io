---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.code.localeCompare(a.data.code)).slice(0, 5);
---

<Base title="Signal lost · Donald Heddesheimer" crumb={[{ label: 'Error' }]}>
  <div class="grid min-h-[calc(100dvh-8rem)] place-items-center p-4">
    <section class="panel w-full max-w-xl overflow-hidden">
      <header class="panel-head">
        <span class="size-2 rounded-full bg-red"></span>
        <h1 class="panel-title">Signal lost</h1>
        <span class="code-chip ml-auto">ERR 404</span>
      </header>
      <div class="gridfield relative px-6 py-10 text-center">
        <Icon name="signal" class="mx-auto size-10 text-faint" strokeWidth={1.25} />
        <p class="mt-4 font-mono text-[40px] leading-none font-semibold tracking-tight">404</p>
        <p class="mt-3 text-muted">No object exists at this address. It may have been moved or never existed.</p>
        <p class="mt-1 readout text-[11px] text-dim" data-path></p>
        <div class="mt-6 flex justify-center gap-2">
          <a href="/" class="btn btn-primary"><Icon name="arrow-left" class="size-4" />Return to overview</a>
          <button type="button" data-cmdk-open class="btn"><Icon name="search" class="size-4" />Search</button>
        </div>
      </div>
      <div class="border-t border-line">
        <p class="px-4 pt-3 kicker">Recent projects</p>
        <ul class="divide-y divide-line py-1">
          {
            projects.map((p) => (
              <li>
                <a href={`/projects/${p.id}/`} class="flex items-center gap-3 px-4 py-2 text-[13px] hover:bg-panel-2">
                  <span class="code-chip">{p.data.code}</span>
                  <span class="flex-1 truncate">{p.data.title}</span>
                  <Icon name="arrow-right" class="size-3.5 text-dim" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</Base>

<script>
  const el = document.querySelector('[data-path]');
  if (el) el.textContent = `REQUESTED ${location.pathname}`;
</script>
